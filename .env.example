APP_NAME="XEDIK"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.xedik.com
ASSET_VERSION=1
VOICE_PBX_ID=1

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# DATABASE CONFIGURATION
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xedik_callcenter
DB_USERNAME=callcenter_admin
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# MAIL CONFIGURATION
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="soporte@xedik.com"
MAIL_FROM_NAME="${APP_NAME}"

# REALTIME WEBSOCKETS (Pusher)
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_PORT=443
PUSHER_SCHEME=https

# DIGITALOCEAN SPACES / OBJECT STORAGE
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=xedik-callcenter
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=xedik-callcenter
R2_ENDPOINT=https://nyc3.digitaloceanspaces.com
R2_REGION=nyc3

# ZERNIO (Redes Sociales)
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# DIALER API
DIALER_API_URL=https://admin.ccs.xedik.com/api
DIALER_CLIENT_ID=
DIALER_CLIENT_SECRET=
DIALER_USERNAME=
DIALER_PASSWORD=

# VOICE & ASTERISK CONFIGURATION
VOICE_ENABLED=true
VOICE_AGENT_CONSOLE_ENABLED=true
VOICE_AGENT_CONSOLE_TENANT_IDS=
VOICE_AGENT_CONSOLE_USER_IDS=
VOICE_DIRECT_JSSIP_ENABLED=false

VOICE_REALM=sip.xedik.com
VOICE_WSS_SERVER=wss://sip.xedik.com:8089/ws

VOICE_SESSION_TTL_SECONDS=28800
VOICE_HEARTBEAT_STALE_SECONDS=900
VOICE_PENDING_SESSION_TIMEOUT_SECONDS=120
VOICE_REPLACED_SESSION_RETENTION_SECONDS=300
VOICE_MAX_SESSIONS_PER_AGENT=1

VOICE_SIP_PROVISIONING_MODE=stable_user_endpoint
VOICE_STABLE_ENDPOINT_PREFIX=v
VOICE_STABLE_ENDPOINT_INVALIDATE_ON_REVOKE=true

ASTERISK_REALTIME_CONNECTION=asterisk_realtime
ASTERISK_REALTIME_TRANSPORT=wss
ASTERISK_REALTIME_ENDPOINTS_TABLE=ps_endpoints
ASTERISK_REALTIME_AUTHS_TABLE=ps_auths
ASTERISK_REALTIME_AORS_TABLE=ps_aors

ASTERISK_DB_DRIVER=mysql
ASTERISK_DB_HOST=127.0.0.1
ASTERISK_DB_PORT=3306
ASTERISK_DB_DATABASE=xedik_callcenter
ASTERISK_DB_USERNAME=callcenter_admin
ASTERISK_DB_PASSWORD=
ASTERISK_DB_SOCKET=
ASTERISK_DB_CHARSET=utf8mb4
ASTERISK_DB_COLLATION=utf8mb4_unicode_ci

VOICE_CALL_STATE_POLICY_ENABLED=true
PREVIEW_DIALER_POLL_INTERVAL_MS=3000

ASTERISK_RECORDING_BASE_URL=https://sip.xedik.com/recordings/serve.php
ASTERISK_RECORDING_SHARED_SECRET=
ASTERISK_RECORDING_URL_TTL=120
VOICE_ASTERISK_QUEUES_TABLE=queues
VOICE_ASTERISK_QUEUE_MEMBERS_TABLE=queue_members

REALTIME_MONITOR_ENABLED=true
REALTIME_MONITOR_SHARED_SECRET=
REALTIME_MONITOR_TIMESTAMP_TOLERANCE=60
REALTIME_MONITOR_STALE_SECONDS=15
REALTIME_MONITOR_OFFLINE_SECONDS=30

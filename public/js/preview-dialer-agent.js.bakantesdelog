                outline: none;
                box-shadow: none;
            }
            .preview-offer-details-toggle:focus-visible,
            .preview-offer-action-btn:focus-visible {
                outline: 2px solid var(--primary);
                outline-offset: 2px;
                box-shadow: none;
            }
        `;
        document.head.appendChild(style);
    }

    function logSoftError(message, error) {
        const now = Date.now();
        if (now - state.lastErrorAt < 10000) return;
        state.lastErrorAt = now;
        if (window.console && console.debug) {
            console.debug('[preview-dialer]', message, {
                status: error?.status,
                code: error?.payload?.error || error?.payload?.reason || error?.message,
            });
        }
    }

    function debug(message, data) {
        if (window.PREVIEW_DIALER_DEBUG && window.console && console.debug) {
            console.debug('[preview-dialer]', message, data || {});
        }
    }

    window.PreviewDialerAgent = {
        init,
        destroy,
        checkEligibility,
        restoreCurrentOffer,
        claimOffer,
        acceptOffer,
        declineOffer,
        expireOffer,
        onAgentStatusChanged,
        onConsoleReadinessChanged,
        resumeAfterReady,
        onVoiceCallEnded,
        setVoiceWrapUpPending,
        linkOfferConversation,
        recoverStaleCallAfterRefresh,
        ensureCurrentOfferForRecovery,
        __initialized: true,
        __state: state,
        __test: {
            escapeHtml,
            formatValue,
            readConfig,
            canOwnVisualOffer,
            shouldShowDetailField,
            OWNER_STALE_MS,
        },
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
        init();
    }
})();

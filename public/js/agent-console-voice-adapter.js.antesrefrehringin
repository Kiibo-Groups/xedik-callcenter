(function (window, document) {
    'use strict';

    const namespace = window.xedikVoice = window.xedikVoice || {};
    const navigationEntry = window.performance?.getEntriesByType
        ? window.performance.getEntriesByType('navigation')[0]
        : null;
    const navigationStartOffset = navigationEntry?.startTime || 0;
    const adapterEvaluatedAt = window.performance?.now
        ? window.performance.now() - navigationStartOffset
        : 0;

    class AgentConsoleVoiceAdapter {
        constructor(config) {
            this.config = config;
            this.initializationPromise = null;
            this.earlyWarmupPromise = null;
            this.warmupPromise = null;
            this.readyRequestPromise = null;
            this.takeoverPromptPromise = null;
            this.microphonePreflightPromise = null;
            this.microphonePreflightPassed = false;
            this.microphonePreflightError = null;
            this.microphonePreflightGeneration = 0;
            this.lastMicrophonePreflight = null;
            this.microphonePermissionState = 'unknown';
            this.deviceChangeHandler = null;
            this.offlineTransitionPromise = null;
            this.initialOfflinePromise = null;
            this.ownershipResolved = false;
            this.statusApiReady = false;
            this.initialOfflineApplied = !Boolean(
                config.initialState?.force_offline_on_init
            );
            this.voiceInteractions = new Map();
            this.activeVoiceInteractionId = null;
            this.currentInteractionId = null;
            this.previousConversationId = null;
            // conversationId -> discardedAt (ms). Short-lived guard so a poll/hydration
            // snapshot generated just before a Reject/Cancel PATCH committed cannot
            // resurrect the discarded offer as "still ringing". See
            // shouldHydrateVoiceConversation()/wasRecentlyDiscarded().
            this._recentlyDiscardedConversations = new Map();
            // Phase 1E-B3: effective-status header overlay (Ringing/In Call/Wrap-Up).
            // null when no Voice work is overriding the requested-status header.
            // The actual timer/interval is owned entirely by window.HeaderStatusTimer
            // (public/js/voice/header-status-timer.js) — this flag only tracks which
            // effective status (if any) this adapter currently has active, so it can
            // no-op on a repeat call and know when to hand the header back.
            this._effectiveVoiceStatus = null;
            this.durationTimer = null;
            this.inboundTerminationTimer = null;
            this.trayObserver = null;
            this.voiceUnavailable = false;
            this.shuttingDown = false;
            this.localStatusOverride = null;
            this.api = null;
            this.manager = null;
            this.voicePrepared = false;
            this.initialStatusLifecycleReady = false;
            this.startupPerformance = {
                navigation_to_adapter_eval_ms: adapterEvaluatedAt,
                navigation_to_warmup_start_ms: null,
                warmup_total_ms: null,
                ownership_request_ms: null,
                reconnect_request_ms: null,
                start_request_ms: null,
                jssip_start_delay_ms: null,
                websocket_connect_ms: null,
                sip_register_ms: null,
                registered_backend_ms: null,
                navigation_to_dropdown_enabled_ms: null,
            };
            this.warmupStartedAt = null;
            this.startupPerformanceLogged = false;
            // Panel-ready guard: if renderInteraction() fires before the Blade's main
            // script has registered the panel helpers (race during external-script fetch),
            // we queue exactly one pending render and flush it on 'agent-console-panel-ready'.
            this._pendingRenderInteraction = null;
            this._panelReadyListenerAdded  = false;
            // Boot-complete signal to Preview Dialer — fire exactly once, from the first
            // terminal boot state (ready, blocked, or unavailable).
            this._previewBootSignaled = false;
            this._previewAutoRecoveryScheduled = new Set();
            this._previewAutoRecoveryInFlight = new Set();
            this._previewAutoRecoveryAttempts = new Set();
            this._conversationDetailFetches = new Map();
            this.previewDynamicRowLocks = new Map();
            this.quickCallSubmitting = false;
        }

        navigationElapsed() {
            if (!window.performance?.now) return 0;
            // Access timeOrigin so older browsers can still be diagnosed while
            // durations remain relative and do not expose an absolute timestamp.
            void window.performance.timeOrigin;
            return window.performance.now() - navigationStartOffset;
        }

        prepareVoice() {
            if (this.voicePrepared || !this.config.capability?.eligible) {
                return;
            }

            this.voicePrepared = true;
            this.api = new namespace.VoiceApiClient({
                csrfToken: this.config.csrfToken,
            });
            this.manager = new namespace.VoiceSessionManager({
                apiClient: this.api,
                allowInbound: false,
                remoteAudio: document.getElementById(
                    'agentVoiceRemoteAudio'
                ),
                ringbackAudio: document.getElementById(
                    'agentVoiceRingbackAudio'
                ),
                ringtoneAudio: document.getElementById(
                    'agentVoiceRingtoneAudio'
                ),
            });
            this.bindManager();
            this.bindDom();
            this.observeTray();
            // Hydrate Voice conversations synchronously from the server payload so
            // they appear at page-load time alongside Email/Facebook/WhatsApp,
            // without waiting for the first polling cycle.
            this.hydrateInitialVoiceConversations();

            // Single global timer that refreshes relative timestamps in voice-local-cards.
            // Same cadence as Email/Facebook (server polling every 2 min); 60 s keeps
            // times accurate without adding overhead. No per-card interval is created.
            this._timeRelativeInterval = window.setInterval(
                () => this.renderTrayInteractions(),
                60_000
            );

            this.syncReadyControl(true);
            this.setStatusSelectorEnabled(false);
            this.setMakeCallEnabled(false);
        }

        startEarlyWarmUp() {
            if (!this.config.capability?.eligible) {
                return Promise.resolve(this);
            }

            if (!this.earlyWarmupPromise) {
                this.prepareVoice();
                this.earlyWarmupPromise = this.warmUp();
            }
            return this.earlyWarmupPromise;
        }

        init() {
            if (!this.initializationPromise) {
                this.initializationPromise = this.initializeOnce();
            }

            return this.initializationPromise;
        }

        async initializeOnce() {
            if (!this.config.capability?.eligible) {
                return this;
            }

            this.prepareVoice();
            this.statusApiReady = typeof window.setStatus === 'function';
            let warmupState = null;
            try {
                warmupState = await this.startEarlyWarmUp();
            } catch (error) {
                if (!this.voiceUnavailable) {
                    this.handleUnexpectedVoiceLoss(
                        namespace.safeError(error)
                    );
                }
            }

            if (!warmupState?.awaitingTakeover && !warmupState?.blocked) {
                await this.persistInitialOfflineIfAllowed(
                    'warmup-completed'
                );
            }
            this.initialStatusLifecycleReady = true;
            await this.enableStatusSelectorWhenOperational();
            return this;
        }

        warmUp() {
            if (this.manager?.isReady()) {
                return Promise.resolve(this.manager.state());
            }

            if (!this.warmupPromise) {
                this.warmupStartedAt = this.performanceNow();
                this.startupPerformance.navigation_to_warmup_start_ms =
                    this.navigationElapsed();
                this.debug('Voice warm-up started');
                this.warmupPromise = this.manager.warmUp()
                    .then(state => {
                        this.startupPerformance.warmup_total_ms =
                            this.performanceNow() - this.warmupStartedAt;
                        if (state.awaitingTakeover || state.blocked) return state;
                        this.voiceUnavailable = false;
                        this.setMakeCallEnabled(true);
                        this.debug('Voice warm-up completed');
                        return state;
                    })
                    .finally(() => {
                        this.warmupPromise = null;
                    });
            }

            return this.warmupPromise;
        }

        bindManager() {
            this.manager.on('log', entry => {
                this.debug(entry.message, entry.data);
            });
            this.manager.on('call:log', entry => {
                this.debug(entry.message, entry.data);
            });
            this.manager.on('takeover-required', () => {
                this.showTakeoverPrompt();
            });
            this.manager.on('ownership-blocked', detail => {
                this.setMakeCallEnabled(false);
                this.setStatusSelectorEnabled(false);
                this.syncInboundPolicy('ownership-blocked');
                this._signalPreviewBoot(false, false);
                this.notify(
                    detail?.message
                    || 'Voice is active in another browser and is currently handling a call.',
                    'error'
                );
                this.debug('Voice ownership blocked', {
                    reason: detail?.reason || null,
                    call_state: detail?.call_state || null,
                });
            });
            this.manager.on('ready', () => {
                this.voiceUnavailable = false;
                this.syncReadyControl(false);
                this.enableStatusSelectorWhenOperational();
                this.setMakeCallEnabled(true);
                this.syncInboundPolicy('voice-ready');
                this.syncPanelControls();
            });
            this.manager.on('ownership', () => {
                this.ownershipResolved = true;
                this.syncInboundPolicy('ownership');
            });
            this.manager.on('agent-status', detail => {
                this.applyReconnectAgentStatus(detail);
            });
            this.manager.on('unavailable', detail => {
                this.handleUnexpectedVoiceLoss(detail.message);
            });
            this.manager.on('replaced', () => {
                this.syncInboundPolicy('session-replaced');
                this.handleReplacedVoiceSession(
                    'Voice Session was replaced in another tab.'
                );
            });
            this.manager.on('revoked', () => {
                this.syncInboundPolicy('session-revoked');
            });
            this.manager.on('performance', detail => {
                if (detail.operation === 'reconnect') {
                    this.startupPerformance.reconnect_request_ms =
                        detail.backend_request_ms;
                }
                if (detail.operation === 'start') {
                    this.startupPerformance.start_request_ms =
                        detail.backend_request_ms;
                }
                this.startupPerformance.jssip_start_delay_ms =
                    detail.jssip_start_delay_ms;
                this.startupPerformance.websocket_connect_ms =
                    detail.websocket_connect_ms;
                this.startupPerformance.sip_register_ms =
                    detail.sip_register_ms;
                this.startupPerformance.registered_backend_ms =
                    detail.registered_api_ms;
                this.debug('Voice startup performance', detail);
            });
            this.manager.on('timing', detail => {
                if (detail?.metric === 'ownership_request_ms') {
                    this.startupPerformance.ownership_request_ms =
                        detail.duration_ms;
                }
            });
            this.manager.on('performance-failed', detail => {
                this.debug('Voice startup performance failed', detail);
            });
            this.manager.on('call:created', () => {
                this.updateCurrentInteraction('connecting');
                this.syncInboundPolicy('outbound-created');
            });
            this.manager.on('call:incoming', detail => {
                this.handleIncomingCall(detail);
            });
            this.manager.on('call:status', detail => {
                this.updateCurrentInteraction(detail.status, detail);
                this.syncPanelControls();
            });
            this.manager.on('call:controls', () => {
                this.syncPanelControls();
            });
            this.manager.on('call:mute', detail => {
                this.appendInteractionEvent(
                    detail?.muted ? 'Muted' : 'Unmuted'
                );
                this.syncPanelControls();
            });
            this.manager.on('call:hold', () => {
                this.syncPanelControls();
            });
            this.manager.on('call:finished', detail => {
                // Reclassify Failed → Missed for unanswered inbound calls when the
                // remote party cancelled.  All other Failed cases stay as Failed.
                //
                // Conditions (all must be true):
                //   result === 'Failed'          : VoiceCallManager has already excluded
                //                                  local-Rejected and normal Ended
                //   interaction.direction === 'inbound'
                //   interaction.connectedAt === null  : call was never answered/active
                //   detail.originator !== 'local'     : not a local network/SIP error
                //   cause is a remote-hang / no-answer signal
                //
                // Kept separate:
                //   Outbound cancelled by agent before answer → originator 'local' or
                //     direction 'outbound' → remains Failed
                //   Inbound rejected by agent → result already 'Rejected' from
                //     VoiceCallManager (localRejectRequested flag) → never reaches here
                //   SIP errors (503, 408…) → different cause strings → remains Failed
                const interaction = this.voiceInteractions.get(this.currentInteractionId);
                let terminalResult = detail.result;

                // QA diagnostic log — safe fields only, no SDP/headers/auth.
                this.debug('call:finished received', {
                    result:        detail.result,
                    cause:         detail.cause,
                    originator:    detail.originator,
                    direction:     detail.direction,
                    status_code:   detail.status_code   ?? null,
                    reason_phrase: detail.reason_phrase ?? null,
                    interaction_direction: interaction?.direction,
                    connectedAt:   interaction?.connectedAt ?? null,
                });

                // Contextual reclassification of 'Failed' using SIP cause data.
                // Only applied to calls that were never answered (connectedAt === null).
                // A connected call that then fails terminates as 'Ended' via 'ended' event.
                //
                // Priority order (top wins):
                //   1. Missed  — inbound + remote cancelled (Canceled/No Answer causes)
                //   2. General cause→state table for all other unanswered failures
                //   3. Default: remains 'Failed'
                // QA log: full context before any reclassification
                this.debug('Terminal classification context', {
                    result:           detail.result,
                    cause:            detail.cause,
                    status_code:      detail.status_code   ?? null,
                    reason_phrase:    detail.reason_phrase ?? null,
                    direction:        interaction?.direction,
                    connectedAt:      interaction?.connectedAt ?? null,
                    hadRemoteRinging: interaction?.hadRemoteRinging ?? false,
                });

                // ── Cancelled: outbound agent-initiated cancel before answer ─────────
                // JsSIP fires 'failed' with originator='local' + cause='Canceled' when
                // the agent sends SIP CANCEL (terminates before 200 OK is received).
                if (terminalResult === 'Failed'
                    && interaction?.direction === 'outbound'
                    && detail.originator === 'local'
                    && detail.cause === 'Canceled'
                    && !interaction?.connectedAt) {
                    terminalResult = 'Cancelled';
                    this.debug('Reclassified Failed → Cancelled', {
                        cause: detail.cause, originator: detail.originator,
                        direction: interaction?.direction,
                    });
                }

                if (terminalResult === 'Failed' && !interaction?.connectedAt) {
                    // ── Missed: inbound remote hang-up before answer ──────────────────
                    const MISSED_CAUSES = new Set(['Canceled', 'No Answer', 'Redirected']);
                    if (interaction?.direction === 'inbound'
                        && detail.originator !== 'local'
                        && MISSED_CAUSES.has(detail.cause)) {
                        terminalResult = 'Missed';
                    } else if (detail.cause === 'Rejected') {
                        // ── Rejected: JsSIP cause-string takes priority over SIP status code ──
                        //
                        // Precedence rule (top wins):
                        //   a. JsSIP cause string  — most specific, already normalized by JsSIP
                        //   b. SIP status code     — numeric fallback (503, 480, …)
                        //   c. result string       — generic last resort ('Failed')
                        //
                        // cause="Rejected" fires when JsSIP receives a remote explicit rejection:
                        //   – 603 Decline (standard SIP decline)
                        //   – SIP 403 that JsSIP maps to cause "Rejected" (carrier/PBX policy)
                        //
                        // This may happen before or after 180 Ringing:
                        //   – hadRemoteRinging=true  → backend is in 'ringing' → ringing→rejected
                        //   – hadRemoteRinging=false → backend is in 'connecting' → connecting→rejected
                        //
                        // IMPORTANT: a raw SIP 403 status code alone does NOT trigger this path.
                        // Only the explicit cause string "Rejected" from JsSIP does.
                        terminalResult = 'Rejected';
                    } else if (
                        // ── Congestion: outbound + SIP 503 + unanswered ──
                        // Confirmed by QA: Asterisk Congestion(2) → status_code 503.
                        // Classified by exact code, not by the generic cause string
                        // ('SIP Failure Code' / 'Service Unavailable') which is ambiguous.
                        Number(detail.status_code) === 503
                        && interaction?.direction === 'outbound'
                        && !interaction?.connectedAt
                    ) {
                        terminalResult = 'Congestion';
                    } else if (
                        // ── No Answer: outbound + 480 + remote rang (180 received) ──
                        // Distinguishes from Unavailable (480 but no prior 180).
                        Number(detail.status_code) === 480
                        && interaction?.direction === 'outbound'
                        && interaction?.hadRemoteRinging === true
                    ) {
                        terminalResult = 'No Answer';
                    } else {
                        // ── Semantic map for unanswered outbound (and rare inbound) ──
                        const CAUSE_REMAP = {
                            // Busy — SIP 486
                            'Busy':                    'Busy',

                            // No Answer — SIP 408 / no pickup
                            'Request Timeout':         'No Answer',  // SIP 408
                            // 'No Answer' was already handled above for inbound Missed;
                            // for outbound it also maps to No Answer:
                            'No Answer':               'No Answer',

                            // Congestion — SIP 503 / 420
                            'Congestion':              'Congestion',
                            'Service Unavailable':     'Congestion', // SIP 503 (?)

                            // Unavailable — SIP 404 / 480 / no route
                            'Unavailable':             'Unavailable',
                            'Channel Unavailable':     'Unavailable',
                            'Not Found':               'Unavailable', // SIP 404 (?)
                            'Temporarily Unavailable': 'Unavailable', // SIP 480 (?)
                            'Address Incomplete':      'Unavailable', // SIP 484 (?)
                        };
                        const remapped = CAUSE_REMAP[detail.cause];
                        if (remapped) terminalResult = remapped;
                    }

                    if (terminalResult !== 'Failed') {
                        this.debug('Reclassified Failed → ' + terminalResult, {
                            cause: detail.cause, originator: detail.originator,
                            status_code: detail.status_code,
                            direction: interaction?.direction,
                        });
                    }
                }

                this.finishCurrentInteraction(terminalResult);
            });
            this.manager.on('call:cleanup', () => {
                const interaction = this.voiceInteractions.get(
                    this.currentInteractionId
                );
                const wasInbound = interaction?.direction === 'inbound';
                if (interaction
                    && !['Ended', 'Rejected', 'Failed', 'Missed', 'Busy', 'No Answer', 'Congestion', 'Unavailable', 'Cancelled'].includes(
                        interaction.status
                    )) {
                    this.finishCurrentInteraction('Failed');
                }
                this.setMakeCallEnabled(this.manager.isReady());
                this.syncInboundPolicy('call-cleanup');
                this.syncPanelControls();
                if (wasInbound) {
                    this.debug('Inbound call cleaned up',
                        this.inboundDebugContext('cleanup'));
                }
            });
            this.manager.on('call:inbound-rejected', detail => {
                this.debug(
                    'Inbound call rejected by Agent Console policy',
                    {
                        ...this.inboundDebugContext('policy'),
                        reason: detail?.reason || null,
                    }
                );
            });
        }

        bindDom() {
            document.getElementById('voiceQaDialerClose')
                ?.addEventListener('click', () => this.closeDialer());
            document.getElementById('voiceQaDialerCancel')
                ?.addEventListener('click', () => this.closeDialer());
            document.getElementById('voiceQaDialerCall')
                ?.addEventListener('click', () => this.placeQuickCall());
            document.getElementById('voiceQaPhone')
                ?.addEventListener('input', event => {
                    event.target.value = event.target.value
                        .replace(/[^\d*#+()\-\s]/g, '')
                        .slice(0, 24);
                });
            document.getElementById('voiceQaCampaign')
                ?.addEventListener('change', () => this.syncDialerScripts());
            document.getElementById('voiceQuickDialpadToggle')
                ?.addEventListener('click', () => this.toggleQuickDialpad());
            document.getElementById('voiceQuickDialpad')
                ?.addEventListener('click', event => this.handleQuickDialpadClick(event));

            document.addEventListener('submit', event => {
                if (event.target?.action?.includes('/logout')) {
                    this.cleanupLocal();
                }
            }, true);
            window.addEventListener('pagehide', () => {
                this.cleanupLocal();
            }, { once: true });

            const mediaDevices = window.navigator?.mediaDevices;
            if (mediaDevices?.addEventListener) {
                this.deviceChangeHandler = () => {
                    this.microphonePreflightGeneration++;
                    this.microphonePreflightPassed = false;
                    this.microphonePreflightError = null;
                    this.lastMicrophonePreflight = null;
                    this.microphonePermissionState = 'unknown';
                    this.debug('Microphone preflight cache invalidated', {
                        reason: 'devicechange',
                    });
                };
                mediaDevices.addEventListener(
                    'devicechange',
                    this.deviceChangeHandler
                );
            }
        }

        requestReady() {
            if (!this.config.capability?.eligible) {
                return window.setStatus('ready');
            }

            if (!this.readyRequestPromise) {
                this.readyRequestPromise = this.performReadyRequest()
                    .finally(() => {
                        this.readyRequestPromise = null;
                        this.syncReadyControl(false);
                        // Never re-enable over an effective Voice lock that started
                        // while this Ready request was still in flight.
                        if (!this.hasActiveEffectiveVoiceStatusOverlay()) {
                            this.setStatusSelectorEnabled(
                                this.manager?.isReady() || false
                            );
                        }
                    });
            }

            return this.readyRequestPromise;
        }

        handleStatusDropdownOpened() {
            if (!this.config.capability?.eligible
                || !this.manager?.isReady()
                || this.agentStatus() === 'ready') {
                return null;
            }

            const promise = this.ensureMicrophonePreflight('dropdown_open');
            promise.catch(error => {
                this.debug('Microphone preflight deferred error', {
                    message: namespace.safeError(error),
                });
            });
            return promise;
        }

        async performReadyRequest() {
            await this.init();

            const previous = this.captureStatusVisual();
            const operationStartedAt = this.performanceNow();
            let microphoneCompletedAt = null;
            let visualAppliedAt = null;
            let backendStartedAt = null;
            let optimisticVisualApplied = false;
            let preflightRemainingOnReadyMs = null;
            let preflightReused = false;
            let microphoneResult = {
                cached: false,
                permissionState: 'unknown',
                trigger: 'ready_click',
                totalMs: null,
            };
            this.syncReadyControl(true);
            this.setStatusSelectorEnabled(false);
            this.setMakeCallEnabled(false);

            while (true) {
                try {
                    await this.ensureVoiceReady();
                    preflightReused = Boolean(
                        this.microphonePreflightPromise
                        || this.microphonePreflightPassed
                        || this.microphonePreflightError
                    );
                    const preflightWaitStartedAt = this.performanceNow();
                    microphoneResult = await this.validateMicrophone(
                        'ready_click'
                    ) || {
                        cached: false,
                        permissionState: 'unknown',
                        trigger: 'ready_click',
                        totalMs: null,
                    };
                    microphoneCompletedAt = this.performanceNow();
                    preflightRemainingOnReadyMs =
                        microphoneCompletedAt - preflightWaitStartedAt;

                    this.applyOptimisticReadyVisual();
                    optimisticVisualApplied = true;
                    visualAppliedAt = this.performanceNow();

                    backendStartedAt = this.performanceNow();
                    let result;
                    try {
                        result = await window.commitAgentReady(
                            this.api.browserTabId
                        );
                    } catch (commitError) {
                        const safeCommitError = new Error(
                            'Unable to change your status. Please try again.'
                        );
                        safeCommitError.readyCommitFailed = true;
                        throw safeCommitError;
                    }
                    const confirmedAt = this.performanceNow();

                    if (!result?.ok) {
                        const error = new Error(
                            'Unable to change your status. Please try again.'
                        );
                        error.readyCommitFailed = true;
                        throw error;
                    }

                    window.finishAgentStatusOptimisticCommit?.();
                    this.debugReadyPerformance({
                        operationStartedAt,
                        microphoneCompletedAt,
                        visualAppliedAt,
                        backendStartedAt,
                        completedAt: confirmedAt,
                        microphoneResult,
                        preflightRemainingOnReadyMs,
                        preflightReused,
                        outcome: 'confirmed',
                    });
                    this.setMakeCallEnabled(true);
                    return result;
                } catch (error) {
                    const failedAt = this.performanceNow();
                    if (optimisticVisualApplied) {
                        this.restoreStatusVisual(previous);
                        optimisticVisualApplied = false;
                    }
                    this.setMakeCallEnabled(false);
                    this.debugReadyPerformance({
                        operationStartedAt,
                        microphoneCompletedAt,
                        visualAppliedAt,
                        backendStartedAt,
                        completedAt: failedAt,
                        microphoneResult,
                        preflightRemainingOnReadyMs,
                        preflightReused,
                        outcome: 'failed',
                    });
                    const retry = await this.showReadyRetry(
                        error,
                        error?.readyCommitFailed
                            ? 'Unable to change your status. Please try again.'
                            : namespace.safeError(error)
                    );
                    if (!retry) return null;

                    this.microphonePreflightError = null;
                    microphoneCompletedAt = null;
                    visualAppliedAt = null;
                    backendStartedAt = null;
                    preflightRemainingOnReadyMs = null;
                    preflightReused = false;
                }
            }
        }

        async ensureVoiceReady() {
            if (this.manager?.isReady()) return;
            const result = await this.warmUp();
            if (result?.awaitingTakeover || !this.manager.isReady()) {
                throw new Error('Voice transport is not ready in this tab.');
            }
        }

        validateMicrophone(trigger) {
            return this.ensureMicrophonePreflight(trigger || 'ready_click');
        }

        ensureMicrophonePreflight(trigger) {
            const mediaDevices = window.navigator?.mediaDevices;
            if (!mediaDevices?.getUserMedia) {
                return Promise.reject(new Error(
                    'This browser does not provide microphone access.'
                ));
            }

            if (this.microphonePreflightPassed) {
                return Promise.resolve({
                    cached: true,
                    permissionState: this.microphonePermissionState,
                    trigger: this.lastMicrophonePreflight?.trigger || trigger,
                    totalMs: this.lastMicrophonePreflight?.totalMs ?? 0,
                });
            }

            if (this.microphonePreflightPromise) {
                return this.microphonePreflightPromise;
            }

            if (this.microphonePreflightError) {
                return Promise.reject(this.microphonePreflightError);
            }

            const generation = this.microphonePreflightGeneration;
            const startedAt = this.performanceNow();
            const promise = this.runMicrophonePreflight(
                trigger,
                generation,
                startedAt
            );
            this.microphonePreflightPromise = promise;

            promise.finally(() => {
                if (this.microphonePreflightPromise === promise) {
                    this.microphonePreflightPromise = null;
                }
            }).catch(() => {});

            return promise;
        }

        async runMicrophonePreflight(trigger, generation, startedAt) {
            this.microphonePermissionState = await this.queryMicrophonePermission();
            if (this.microphonePermissionState === 'denied') {
                const error = new Error('Microphone permission was denied.');
                this.microphonePreflightError = error;
                throw error;
            }

            let stream;
            try {
                stream = await window.navigator.mediaDevices.getUserMedia({
                    audio: true,
                    video: false,
                });
            } catch (error) {
                const messages = {
                    NotAllowedError: 'Microphone permission was denied.',
                    NotFoundError: 'No microphone was found.',
                    DevicesNotFoundError: 'No microphone was found.',
                    NotReadableError: 'The microphone is unavailable or in use.',
                    TrackStartError: 'The microphone could not be started.',
                };
                const safeError = new Error(
                    messages[error?.name]
                    || 'Microphone validation failed.'
                );
                this.microphonePreflightError = safeError;
                throw safeError;
            } finally {
                stream?.getTracks().forEach(track => track.stop());
            }

            if (!stream?.getAudioTracks().length) {
                const error = new Error(
                    'No usable microphone track was returned.'
                );
                this.microphonePreflightError = error;
                throw error;
            }

            if (generation !== this.microphonePreflightGeneration) {
                const error = new Error(
                    'Microphone devices changed. Please try again.'
                );
                this.microphonePreflightError = error;
                throw error;
            }

            this.microphonePreflightPassed = true;
            this.microphonePreflightError = null;
            const result = {
                cached: false,
                permissionState: this.microphonePermissionState,
                trigger,
                totalMs: this.performanceNow() - startedAt,
            };
            this.lastMicrophonePreflight = result;

            return result;
        }

        async queryMicrophonePermission() {
            if (!window.navigator?.permissions?.query) {
                return 'unsupported';
            }

            try {
                const permission = await window.navigator.permissions.query({
                    name: 'microphone',
                });
                return permission?.state || 'unknown';
            } catch (error) {
                return 'unsupported';
            }
        }

        async showReadyRetry(error, safeMessage) {
            this.debug('Agent status validation failed', {
                message: namespace.safeError(error),
            });

            if (!window.Swal) {
                this.notify(safeMessage, 'error');
                return false;
            }

            const result = await window.Swal.fire({
                title: 'Unable to change status',
                text: safeMessage,
                icon: 'error',
                showCancelButton: true,
                confirmButtonText: 'Retry',
                cancelButtonText: 'Stay Offline',
            });

            return result.isConfirmed;
        }

        showTakeoverPrompt() {
            if (!this.takeoverPromptPromise) {
                this.takeoverPromptPromise = this.performTakeoverPrompt()
                    .finally(() => {
                        this.takeoverPromptPromise = null;
                    });
            }
            return this.takeoverPromptPromise;
        }

        async performTakeoverPrompt() {
            if (!window.Swal) return;
            const result = await window.Swal.fire({
                title: 'Voice Session Already Active',
                text: 'Keep it there or connect Voice in this tab.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Connect Here Instead',
                cancelButtonText: 'Keep Existing Session',
                reverseButtons: true,
            });

            if (!result.isConfirmed) {
                this.setMakeCallEnabled(false);
                return;
            }

            try {
                const takeover = await this.manager.takeOver(true);
                if (takeover?.awaitingTakeover || takeover?.blocked) {
                    return;
                }
                await this.persistInitialOfflineIfAllowed(
                    'confirmed-takeover'
                );
                await this.manager.waitUntilReady();
                await this.enableStatusSelectorWhenOperational();
                this.setMakeCallEnabled(true);
            } catch (error) {
                this.markVoiceUnavailable(error);
            }
        }

        openDialer() {
            if (!this.manager?.isReady()
                || this.manager.callManager.currentSession) {
                this.notify(
                    'Voice must be connected before starting a call.',
                    'error'
                );
                return;
            }

            const modal = document.getElementById('voiceQaDialer');
            const phone = document.getElementById('voiceQaPhone');
            if (phone && !phone.value) phone.value = '';
            modal?.classList.add('active');
            modal?.setAttribute('aria-hidden', 'false');
            this.syncDialerScripts();
            phone?.focus();
        }

        closeDialer() {
            const modal = document.getElementById('voiceQaDialer');
            modal?.classList.remove('active');
            modal?.setAttribute('aria-hidden', 'true');
        }

        toggleQuickDialpad() {
            const dialpad = document.getElementById('voiceQuickDialpad');
            const toggle = document.getElementById('voiceQuickDialpadToggle');
            if (!dialpad) return;

            const nextHidden = !dialpad.hidden;
            dialpad.hidden = nextHidden;
            toggle?.setAttribute('aria-expanded', String(!nextHidden));
        }

        handleQuickDialpadClick(event) {
            const target = event.target?.closest?.('button');
            if (!target) return;

            const phone = document.getElementById('voiceQaPhone');
            if (!phone) return;

            if (target.dataset.action === 'backspace') {
                phone.value = phone.value.slice(0, -1);
            } else if (target.dataset.digit) {
                phone.value = `${phone.value}${target.dataset.digit}`.slice(0, 24);
            }

            phone.focus();
        }

        syncDialerScripts() {
            const campaignId = document.getElementById('voiceQaCampaign')?.value || '';
            const scriptSel  = document.getElementById('voiceQaScript');
            if (!scriptSel) return;

            const currentVal = scriptSel.value;
            let currentStillVisible = false;

            scriptSel.querySelectorAll('option[data-campaign]').forEach(opt => {
                const visible = campaignId !== '' && opt.dataset.campaign === campaignId;
                opt.style.display = visible ? '' : 'none';
                if (visible && opt.value === currentVal) currentStillVisible = true;
            });

            if (currentVal !== '' && !currentStillVisible) {
                scriptSel.value = '';
            }
        }

        async placeQuickCall() {
            if (this.quickCallSubmitting) return;

            const rawPhone   = document.getElementById('voiceQaPhone')?.value.trim();
            const phone      = this.cleanDialedPhone(rawPhone);
            const campaignId = document.getElementById('voiceQaCampaign')?.value || '';
            const scriptId   = document.getElementById('voiceQaScript')?.value   || '';

            if (!campaignId) {
                this.notify('Select a campaign before placing a call.', 'error');
                return;
            }
            if (!scriptId) {
                this.notify('Select a script before placing a call.', 'error');
                return;
            }
            if (!phone || phone.length < 7 || phone.length > 15) {
                this.notify('Enter a valid phone number.', 'error');
                return;
            }

            if (!this.manager?.isReady()
                || this.manager.callManager.currentSession) {
                this.notify('Voice is not ready for a new call.', 'error');
                return;
            }

            const callButton = document.getElementById('voiceQaDialerCall');
            this.quickCallSubmitting = true;
            if (callButton) callButton.disabled = true;
            let interaction = null;

            try {
                const prepared = await this.prepareQuickCall(campaignId, scriptId, phone);
                const quickCall = prepared.quick_call;
                this.applyQuickCallAgentStatus(quickCall.agent_status);
                interaction = this.createInteraction(
                    quickCall.phone_number,
                    quickCall.campaign.id,
                    quickCall.script.id,
                    quickCall.call_uuid,
                    {
                        campaignName: quickCall.campaign.name,
                        scriptName: quickCall.script.name,
                        callerIdNumber: quickCall.caller_id?.number || null,
                    }
                );
                this.closeDialer();
                this.selectInteraction(interaction.id);
                this.setMakeCallEnabled(false);
                this.manager.callManager.setInboundAllowed(false);
                this.manager.callManager.call(quickCall.phone_number, {
                    extraHeaders: quickCall.extra_headers || [],
                });
            } catch (error) {
                if (interaction) {
                    this.finishCurrentInteraction('Failed');
                }
                this.syncInboundPolicy('outbound-start-failed');
                this.notify(namespace.safeError(error), 'error');
            } finally {
                this.quickCallSubmitting = false;
                if (callButton) callButton.disabled = false;
            }
        }

        cleanDialedPhone(value) {
            return String(value || '').replace(/\D/g, '');
        }

        async prepareQuickCall(campaignId, scriptId, phone) {
            const response = await window.fetch(this.config.quickCallPrepareUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-CSRF-TOKEN': this.config.csrfToken,
                },
                body: JSON.stringify({
                    campaign_id: campaignId,
                    script_id: scriptId,
                    phone_number: phone,
                    session_uuid: this.manager?.sessionUuid || null,
                }),
            });

            const data = await response.json().catch(() => ({}));
            if (!response.ok || !data?.ok) {
                const errorBag = data?.errors || {};
                const firstError = Object.values(errorBag)[0]?.[0];
                throw new Error(firstError || data?.error || 'Could not prepare the outbound call.');
            }

            return data;
        }

        applyQuickCallAgentStatus(agentStatus) {
            if (!agentStatus) return;
            if (agentStatus.effective_status) {
                this.applyEffectiveVoiceStatusOverlay(
                    agentStatus.effective_status,
                    agentStatus.effective_since ? new Date(agentStatus.effective_since) : new Date(),
                    { label: agentStatus.effective_status_label || 'Outbound Call' }
                );
                return;
            }
            if (typeof window.applyAgentStatusSnapshotFromServer === 'function') {
                window.applyAgentStatusSnapshotFromServer(agentStatus);
                return;
            }
            this.handleAgentStatusChanged(agentStatus.status || this.agentStatus());
        }

        applyReconnectAgentStatus(detail) {
            const agentStatus = detail?.agentStatus || detail?.agent_status || null;
            if (!agentStatus) return;

            this.applyAgentStatusSnapshot(agentStatus);

            if (detail?.operation !== 'reconnect'
                || agentStatus.effective_status !== 'wrap_up') {
                this.recomputeEffectiveVoiceStatusOverlay();
                return;
            }

            if (!this.reconcileHydratedInteractionAfterReconnect(agentStatus)) {
                this.applyEffectiveVoiceStatusOverlay(
                    'wrap_up',
                    agentStatus.effective_since
                        ? new Date(agentStatus.effective_since)
                        : new Date()
                );
            }
        }

        applyAgentStatusSnapshot(agentStatus) {
            if (typeof window.applyAgentStatusSnapshotFromServer === 'function') {
                window.applyAgentStatusSnapshotFromServer(agentStatus);
                return;
            }
            this.handleAgentStatusChanged(
                agentStatus.status
                    || agentStatus.requested_status
                    || this.agentStatus()
            );
        }

        createInteraction(phone, campaignId = null, scriptId = null, preassignedUuid = null, metadata = {}) {
            const uuid = preassignedUuid || namespace.uuid();
            const id = `voice-local-${uuid}`;
            const now = new Date();
            const interaction = {
                id,
                campaign: metadata.campaignName || 'Voice',
                script: metadata.scriptName || 'Outbound call',
                phone,
                normalizedPhone: this.normalizeRemoteNumber(phone),
                direction: 'outbound',
                status: 'Preparing',
                createdAt: now,
                connectedAt: null,
                endedAt: null,
                events: [{ status: 'Preparing', at: now }],
                lead: null,
                leadId: null,
                leadLookupStatus: 'idle',
                leadLookupPromise: null,
                conversationId: null,
                voiceCallId: null,
                callUuid: uuid,
                persistedCallUuid: uuid,
                temporaryCallUuid: uuid,
                campaignId:          campaignId || null,
                scriptId:            scriptId   || null,
                scriptData: null,
                scriptSource: null,
                displayName:         this.normalizeRemoteNumber(phone) || phone,
                aniNormalized:       metadata.callerIdNumber ? this.normalizeRemoteNumber(metadata.callerIdNumber) : null,
                dnisNormalized:      this.normalizeRemoteNumber(phone),
                _waitSinceAt:        now,
                dispositions:        null,
                dispositionsLoaded:  false,
                dispositionsLoading: false,
                fetchPending:        false,
                // Outbound-only: true when 180 Ringing was received from remote.
                // Used to distinguish No Answer (180 then 480) from Unavailable (480 only).
                hadRemoteRinging:    false,
            };
            this.voiceInteractions.set(id, interaction);
            this.currentInteractionId = id;
            this.renderTrayInteractions();
            this.persistInteraction(
                interaction,
                this.manager?.sessionUuid || null,
                null
            );
            return interaction;
        }

        startPreviewCallWithUuid(phone, campaignId, scriptId, callUuid, callerIdNumber = null, dialPrefix = null) {
            if (!this.manager?.isReady()
                || this.agentStatus() !== 'ready'
                || this.manager.callManager.currentSession) {
                this.notify('Voice is not ready for the preview call.', 'error');
                return null;
            }

            const interaction = this.createInteraction(phone, campaignId || null, scriptId || null, callUuid);
            interaction.isPreviewDialer = true;
            interaction.previewConversationLinked = false;
            this.selectInteraction(interaction.id);
            this.setMakeCallEnabled(false);
            this.manager.callManager.setInboundAllowed(false);

            try {
                const extraHeaders = [];
                if (callerIdNumber) extraHeaders.push(`X-xedik-Caller-ID: ${callerIdNumber}`);
                if (dialPrefix) extraHeaders.push(`X-xedik-Dial-Prefix: ${dialPrefix}`);
                this.manager.callManager.call(phone, { extraHeaders });
            } catch (error) {
                this.finishCurrentInteraction('Failed');
                this.syncInboundPolicy('outbound-start-failed');
                this.notify(namespace.safeError(error), 'error');
            }

            return interaction;
        }

        handleIncomingCall(detail) {
            const caller = detail?.caller || {};
            const acdMetadata = caller.acdMetadata || {};
            const label = caller.label
                || caller.displayName
                || acdMetadata.ani
                || caller.user
                || 'Unknown caller';

            this.debug(
                'Inbound call received',
                this.inboundDebugContext('newRTCSession')
            );
            this.debug(
                'Inbound call allowed',
                this.inboundDebugContext('policy')
            );

            if (window.activeConversationId) {
                this.previousConversationId = window.activeConversationId;
            }

            const interaction = this.createInboundInteraction(label, acdMetadata);
            this.selectInteraction(interaction.id);
            this.setMakeCallEnabled(false);
            this.syncInboundPolicy('incoming-accepted');
        }

        createInboundInteraction(caller, acdMetadata = {}) {
            const id = `voice-local-${namespace.uuid()}`;
            const now = new Date();
            const displayPhone = acdMetadata.ani || caller;
            const normalizedPhone = this.normalizeNanpPhone(displayPhone);
            const displayNumber = normalizedPhone || displayPhone;
            const interaction = {
                id,
                campaign: 'Voice',
                script: 'Incoming call',
                phone: displayPhone,
                normalizedPhone,
                displayPhone: displayNumber,
                acdMetadata,
                direction: 'inbound',
                status: 'Ringing',
                createdAt: now,
                ringingAt: now,
                connectedAt: null,
                endedAt: null,
                answerPending: false,
                rejectPending: false,
                isNew: true,
                events: [{ status: 'Ringing', at: now }],
                lead: null,
                leadId: null,
                leadLookupStatus: 'idle',
                leadLookupPromise: null,
                conversationId: null,
                voiceCallId: null,
                callUuid: id.replace('voice-local-', ''),
                persistedCallUuid: null,
                temporaryCallUuid: id.replace('voice-local-', ''),
                asteriskLinkedid: acdMetadata.asterisk_linkedid || null,
                conversationCampaignId: null,
                dnisNormalized: this.normalizeNanpPhone(acdMetadata.dnis || ''),
                sipCallId: acdMetadata.sip_call_id || null,
                internalQueueName: acdMetadata.queue_name || null,
                scriptData: null,
                scriptSource: null,
                displayName:         displayNumber,
                _waitSinceAt:        now,   // Date — source of truth for tray relative time
                dispositions:        null,
                dispositionsLoaded:  false,
                dispositionsLoading: false,
                fetchPending:        false,
            };
            this.voiceInteractions.set(id, interaction);
            this.currentInteractionId = id;
            this.renderTrayInteractions();
            this.recomputeEffectiveVoiceStatusOverlay();
            // Persist to backend (non-blocking). Session UUID injected when available.
            this.persistInteraction(
                interaction,
                this.manager?.sessionUuid || null,
                this.previousConversationId || null
            );
            return interaction;
        }

        visualCallStatus(status) {
            const normalized = String(status || '').trim().toLowerCase();
            return {
                ringing:        'Ringing',
                'incoming call':'Ringing',
                calling:        'Connecting',
                connecting:     'Connecting',
                active:         'In Call',
                'in call':      'In Call',
                held:           'On Hold',
                'on hold':      'On Hold',
                ended:          'Ended',
                rejected:       'Rejected',
                failed:         'Failed',
                // 'missed' comes from backend call_state for unanswered inbound calls.
                // 'busy'/'unavailable' are SIP causes normalized to 'Failed' by
                // VoiceCallManager before they reach the adapter — no mapping needed.
                missed:         'Missed',
                busy:           'Busy',
                no_answer:      'No Answer',
                'no answer':    'No Answer',
                congestion:     'Congestion',
                unavailable:    'Unavailable',
                cancelled:      'Cancelled',
            }[normalized] || status;
        }

        isTerminalVisualStatus(status) {
            return ['Ended', 'Rejected', 'Failed', 'Missed', 'Busy', 'No Answer', 'Congestion', 'Unavailable', 'Cancelled']
                .includes(this.visualCallStatus(status));
        }

        effectiveInteractionStatus(interaction) {
            const currentStatus = this.visualCallStatus(interaction?.status);
            if (this.isTerminalVisualStatus(currentStatus)) return currentStatus;

            const backendStatus = this.visualCallStatus(interaction?.backendCallState);
            if (this.isTerminalVisualStatus(backendStatus)) return backendStatus;

            if (interaction?.backendEndedAt
                || interaction?.previewRecoveryStatus === 'recovered'
                || interaction?.needsDisposition
                || (interaction?.wrapUpPending && interaction?.conversationId)) {
                return this.visualCallStatus('cancelled');
            }

            return currentStatus;
        }

        recordInteractionEvent(interaction, status) {
            const visualStatus = this.visualCallStatus(status);
            const previousStatus = interaction.status;
            interaction.events = interaction.events || [];
            if (interaction.events.at(-1)?.status !== visualStatus) {
                interaction.events.push({
                    status: visualStatus,
                    label: this.timelineEventLabel(
                        interaction,
                        visualStatus,
                        previousStatus
                    ),
                    at: new Date(),
                });
            }
            interaction.status = visualStatus;

            // NOTE: connectedAt and endedAt are set by updateCurrentInteraction() and
            // finishCurrentInteraction() respectively.  Do NOT set them here because
            // updateCurrentInteraction() checks !interaction.connectedAt AFTER calling
            // this function to decide whether to startDurationTimer().  Setting it here
            // would make that condition false and prevent the timer from starting.

            // Persist state change to backend (fire-and-forget, idempotent)
            const backendState = {
                'Ringing':    'ringing',
                'Connecting': 'connecting',
                'In Call':    'active',
                'On Hold':    'held',
                'Ended':      'ended',
                'Rejected':   'rejected',
                'Failed':     'failed',
                'Missed':     'missed',
                'Busy':       'busy',
                'No Answer':  'no_answer',
                'Congestion': 'congestion',
                'Unavailable':'unavailable',
                'Cancelled':  'cancelled',
            }[visualStatus];
            if (backendState) {
                this.updateCallStatePersisted(interaction, backendState);
            }

            return visualStatus;
        }

        timelineEventLabel(interaction, status, previousStatus) {
            if (status === 'In Call') {
                if (previousStatus === 'On Hold') return 'Resumed';
                return interaction.direction === 'inbound'
                    ? 'Answered'
                    : 'Connected';
            }
            if (status === 'On Hold') return 'Held';
            return status;
        }

        appendInteractionEvent(label) {
            const interaction = this.voiceInteractions.get(
                this.currentInteractionId
            );
            if (!interaction) return;
            interaction.events = interaction.events || [];
            if (interaction.events.at(-1)?.label === label) return;
            interaction.events.push({
                status: interaction.status,
                label,
                at: new Date(),
            });
            if (this.activeVoiceInteractionId === interaction.id) {
                this.renderInteraction(interaction);
            }
        }

        async answerIncomingCall() {
            const interaction = this.voiceInteractions.get(
                this.currentInteractionId
            );
            const call = this.manager?.callManager.snapshot();
            if (!interaction || interaction.direction !== 'inbound'
                || interaction.status !== 'Ringing'
                || interaction.answerPending
                || interaction.rejectPending
                || !call?.inboundPending) {
                return;
            }

            interaction.answerPending = true;
            this.recordInteractionEvent(interaction, 'Connecting');
            this.renderTrayInteractions();
            if (this.activeVoiceInteractionId === interaction.id) {
                this.renderInteraction(interaction);
            }

            try {
                await this.ensureMicrophonePreflight('inbound_answer');
                this.manager.callManager.answer();
                this.debug(
                    'Inbound call answered',
                    this.inboundDebugContext('answer')
                );
            } catch (error) {
                this.notify(namespace.safeError(error), 'error');
                interaction.answerPending = false;
                interaction.rejectPending = true;
                this.recordInteractionEvent(interaction, 'Rejected');
                try {
                    this.manager.callManager.reject();
                } catch (rejectError) {
                    this.manager.callManager.cleanup(true);
                }
                this.scheduleInboundTerminationFallback(call.session);
                this.renderTrayInteractions();
                if (this.activeVoiceInteractionId === interaction.id) {
                    this.renderInteraction(interaction);
                }
            }
        }

        rejectIncomingCall() {
            const interaction = this.voiceInteractions.get(
                this.currentInteractionId
            );
            const call = this.manager?.callManager.snapshot();
            if (!interaction || interaction.direction !== 'inbound'
                || interaction.status !== 'Ringing'
                || interaction.answerPending
                || interaction.rejectPending
                || !call?.inboundPending) {
                return;
            }

            interaction.rejectPending = true;
            this.recordInteractionEvent(interaction, 'Rejected');
            this.debug(
                'Inbound call rejected by agent',
                this.inboundDebugContext('reject')
            );
            this.manager.callManager.reject();
            this.scheduleInboundTerminationFallback(call.session);
            this.renderTrayInteractions();
            if (this.activeVoiceInteractionId === interaction.id) {
                this.renderInteraction(interaction);
            }
        }

        scheduleInboundTerminationFallback(session) {
            if (this.inboundTerminationTimer !== null) {
                window.clearTimeout(this.inboundTerminationTimer);
            }
            this.inboundTerminationTimer = window.setTimeout(() => {
                this.inboundTerminationTimer = null;
                if (this.manager?.callManager.currentSession === session) {
                    this.manager.callManager.cleanup(true);
                }
            }, 1500);
        }

        updateCurrentInteraction(status, eventDetail = {}) {
            const interaction = this.voiceInteractions.get(
                this.currentInteractionId
            );
            if (!interaction) return;
            const visualStatus = this.recordInteractionEvent(
                interaction,
                status
            );
            if ((visualStatus === 'In Call' || visualStatus === 'On Hold')
                && !interaction.connectedAt) {
                interaction.connectedAt = new Date();
                this.startDurationTimer();
            }
            // Record that the remote end sent a progress response on an outbound call.
            // VoiceCallManager emits call:status='Ringing' for BOTH 180 and 183.
            // The real SIP code is now logged via eventDetail.progress_code.
            //
            // NOTE: the flag name 'hadRemoteRinging' is imprecise when the triggering
            // code is 183 (Session Progress / early media), which may represent voicemail
            // rather than a real ring.  Do NOT rename to hadRemoteProgress yet — the
            // No Answer/Unavailable classification rule has not been updated to distinguish
            // 180 from 183.  Keep as-is until that rule is explicitly reviewed.
            //
            // This flag is used in call:finished to distinguish:
            //   No Answer  (480 + outbound + hadRemoteRinging)   ← also fires for 183
            //   Unavailable (480 + outbound + !hadRemoteRinging)
            if (visualStatus === 'Ringing'
                && interaction.direction === 'outbound'
                && !interaction.hadRemoteRinging) {
                interaction.hadRemoteRinging = true;
                this.debug('Remote ringing recorded', {
                    interaction_id:   interaction.id,
                    call_uuid:        interaction.callUuid,
                    status_code:      eventDetail.progress_code ?? null,
                    hadRemoteRinging: true,
                });
            }
            this.renderTrayInteractions();
            if (this.activeVoiceInteractionId === interaction.id) {
                this.renderInteraction(interaction);
            }
            this.recomputeEffectiveVoiceStatusOverlay();
        }

        finishCurrentInteraction(result) {
            const interaction = this.voiceInteractions.get(
                this.currentInteractionId
            );
            if (!interaction) return;
            this.recordInteractionEvent(interaction, result);
            interaction.endedAt = new Date();
            interaction.answerPending = false;
            interaction.rejectPending = false;
            if (this.inboundTerminationTimer !== null) {
                window.clearTimeout(this.inboundTerminationTimer);
                this.inboundTerminationTimer = null;
            }
            this.stopDurationTimer();

            // Phase 1E-B2: an inbound offer that was never answered (Reject, remote
            // CANCEL, Queue timeout — all reach here as terminal `result` values) ends
            // only the current offer. It must never enter Wrap-Up/Disposition. The
            // answered/never-answered decision is `interaction.connectedAt`, set
            // synchronously by updateCurrentInteraction() the moment RTCSession
            // 'accepted'/'confirmed' fires — that always happens strictly before any
            // terminal RTCSession event for the SAME session, so it is race-free here.
            const wasAnswered = this.interactionWasAnswered(interaction);
            if (interaction.direction === 'inbound' && !wasAnswered) {
                this.discardUnansweredOffer(interaction);
            } else {
                interaction.wrapUpPending = Boolean(interaction.conversationId && wasAnswered);
                interaction.needsDisposition = Boolean(interaction.conversationId && !wasAnswered);
                // Pre-warm dispositions in the background so modal is instant when agent clicks
                this._prewarmDispositionsIfTerminal(interaction);
                this.renderTrayInteractions();
                if (this.activeVoiceInteractionId === interaction.id) {
                    this.renderInteraction(interaction);
                }
                this.recomputeEffectiveVoiceStatusOverlay();
            }
            this.currentInteractionId = null;

            // Signal Preview Dialer so it can resume claiming after the call
            if (interaction.callUuid && window.PreviewDialerAgent?.onVoiceCallEnded) {
                window.PreviewDialerAgent.setVoiceWrapUpPending?.(this.hasPendingVoiceWrapUp());
                window.PreviewDialerAgent.onVoiceCallEnded(interaction.callUuid);
            }
        }

        reconcileHydratedInteractionAfterReconnect(agentStatus) {
            const interaction = this.findReconnectStaleAnsweredInteraction();
            if (!interaction) {
                return false;
            }

            const endedAt = agentStatus.effective_since
                ? new Date(agentStatus.effective_since)
                : new Date();
            interaction.status = 'Ended';
            interaction.backendCallState = 'ended';
            interaction.endedAt = Number.isNaN(endedAt.getTime())
                ? new Date()
                : endedAt;
            interaction.backendEndedAt = interaction.endedAt.toISOString();
            interaction.answerPending = false;
            interaction.rejectPending = false;
            interaction.wrapUpPending = Boolean(interaction.conversationId);
            interaction.needsDisposition = false;

            if (this.inboundTerminationTimer !== null) {
                window.clearTimeout(this.inboundTerminationTimer);
                this.inboundTerminationTimer = null;
            }
            this.stopDurationTimer();
            this.renderTrayInteractions();
            if (this.activeVoiceInteractionId === interaction.id) {
                this.renderInteraction(interaction);
            }
            window.PreviewDialerAgent?.setVoiceWrapUpPending?.(
                this.hasPendingVoiceWrapUp()
            );
            this.recomputeEffectiveVoiceStatusOverlay();
            return true;
        }

        findReconnectStaleAnsweredInteraction() {
            const isCandidate = interaction => {
                if (!interaction || !this.interactionWasAnswered(interaction)) {
                    return false;
                }
                if (interaction.endedAt || interaction.backendEndedAt) {
                    return false;
                }
                if (interaction.wrapUpPending) {
                    return false;
                }
                const status = this.effectiveInteractionStatus(interaction);
                return status === 'In Call'
                    || status === 'On Hold'
                    || status === 'Connecting'
                    || interaction.connectedAt !== null;
            };

            const preferredIds = [
                this.currentInteractionId,
                this.activeVoiceInteractionId,
            ].filter(Boolean);

            for (const id of preferredIds) {
                const interaction = this.voiceInteractions.get(id);
                if (isCandidate(interaction)) {
                    return interaction;
                }
            }

            return Array.from(this.voiceInteractions.values())
                .filter(isCandidate)
                .sort((a, b) => {
                    const aTime = this.voiceDate(a.connectedAt || a.createdAt)?.getTime() || 0;
                    const bTime = this.voiceDate(b.connectedAt || b.createdAt)?.getTime() || 0;
                    return bTime - aTime;
                })[0] || null;
        }

        // Phase 1E-B2: end ONLY the current unanswered inbound offer. The Conversation
        // and VoiceCall rows are never touched here — they are backend-owned and must
        // survive so the same LinkedID can be reoffered (same agent or a different one)
        // without creating duplicates. This removes the local tray card only.
        discardUnansweredOffer(interaction) {
            const canonical = this.findCanonicalStateInteraction(interaction) || interaction;

            // Race guard: only act if this is still the tracked entry for its id — a
            // concurrent reoffer merge (persistInteraction's reused-response branch) may
            // have already deleted/replaced it.
            if (this.voiceInteractions.get(canonical.id) !== canonical) {
                return;
            }

            this.voiceInteractions.delete(canonical.id);
            this.markConversationDiscarded(canonical.conversationId);
            this.invalidatePendingLookupsForInteraction(canonical);

            if (this.currentInteractionId === canonical.id) {
                this.currentInteractionId = null;
            }

            const wasActivePanel = this.activeVoiceInteractionId === canonical.id;
            if (wasActivePanel) {
                this.activeVoiceInteractionId = null;
            }

            this.renderTrayInteractions();

            if (wasActivePanel) {
                this.clearSelectedVoiceInteractionSurfaces();
            }

            this.recomputeEffectiveVoiceStatusOverlay();

            this.debug('Voice offer discarded without Wrap-Up', {
                interaction_id: canonical.id,
                conversation_id: canonical.conversationId || null,
                call_uuid: canonical.callUuid || null,
            });
        }

        // Shared "Select a conversation to start" fallback — used whenever a Voice
        // panel is torn down without a new conversation taking its place.
        renderEmptyMessagePanel() {
            const panel = document.getElementById('messagePanel');
            if (!panel) return;
            panel.innerHTML = `
                <div style="flex:1;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px;color:var(--text-muted);">
                    <i class="bi bi-chat-left-text" style="font-size:48px;"></i>
                    <div style="font-size:14px;">Select a conversation to start</div>
                </div>
            `;
        }

        // Invalidates any in-flight async lookups tied to this interaction so their
        // eventual resolution is a safe no-op. Reuses the EXISTING token/identity
        // checks already present in resolveLeadForInteraction()/
        // fetchPersistedConversationDetail() (_leadLookupToken comparison, and the
        // voiceInteractions-membership guard added below) — no new token system.
        invalidatePendingLookupsForInteraction(interaction) {
            if (!interaction) return;
            interaction._leadLookupToken = null;
            interaction.leadLookupPromise = null;
            interaction.previewLeadDetailLoading = false;
        }

        // Clears BOTH visible surfaces — central panel AND right-side lead/contact
        // panel — when a discarded Voice interaction was the one currently selected.
        // Only called when activeVoiceInteractionId matched the discarded interaction,
        // so this never touches a different selected Email/Chat/Social conversation.
        // Reuses the CRM's existing "no conversation selected" markup for the lead
        // panel (same snippet as refreshConversationList()'s default fill) — no new
        // visual layout.
        clearSelectedVoiceInteractionSurfaces() {
            this.renderEmptyMessagePanel();
            const leadPanel = document.getElementById('leadPanel');
            if (leadPanel) {
                leadPanel.innerHTML = `
                    <div style="padding:40px 20px;text-align:center;color:var(--text-muted);">
                        <i class="bi bi-person-circle" style="font-size:48px;display:block;margin-bottom:8px;"></i>
                        <div style="font-size:13px;">No conversation selected</div>
                    </div>
                `;
            }
        }

        // Records that this Conversation's local offer was just discarded, so a
        // stale "still ringing" poll/hydration snapshot generated just before the
        // Reject/Cancel/Missed PATCH committed cannot resurrect it. See
        // shouldHydrateVoiceConversation().
        markConversationDiscarded(conversationId) {
            if (!conversationId) return;
            this._recentlyDiscardedConversations.set(Number(conversationId), Date.now());
        }

        wasRecentlyDiscarded(conversationId, windowMs = 4000) {
            if (!conversationId) return false;
            const at = this._recentlyDiscardedConversations.get(Number(conversationId));
            if (!at) return false;
            if (Date.now() - at > windowMs) {
                this._recentlyDiscardedConversations.delete(Number(conversationId));
                return false;
            }
            return true;
        }

        // Phase: unanswered-terminal hydration guard.
        // Decides whether a voice Conversation coming from initial hydration or
        // periodic polling (i.e. NOT a live locally-created interaction) may be
        // resurfaced into the tray at all. Reused by hydrateInitialVoiceConversations()
        // and by the equivalent injection point in console/index.blade.php's
        // refreshConversationList() so both paths share one definition.
        //
        // - Currently ringing/connecting/active/held → hydrate (live call or a
        //   legitimate reoffer), unless it was JUST locally discarded (stale snapshot).
        // - Otherwise → hydrate only when the backend says Wrap-Up is pending
        //   (answered + terminal). A never-answered terminal call is never hydrated.
        shouldHydrateVoiceConversation(conv) {
            const activeStates = ['ringing', 'connecting', 'active', 'held'];
            const state = String(conv?.voice_call_state || '').toLowerCase();
            if (activeStates.includes(state)) {
                return !this.wasRecentlyDiscarded(conv?.id);
            }
            if ((conv?.voice_direction || conv?.direction) === 'outbound'
                && this.isTerminalVisualStatus(state)) {
                return true;
            }
            return Boolean(conv?.is_voice_wrap_up);
        }

        // Defense in depth: a tray card that slipped through as a recovered/hydrated
        // entry but is actually a never-answered-terminal ghost (no live session, no
        // Wrap-Up pending) must never open as an actionable interaction. Discard it
        // and fall back to the normal empty panel instead of leaving a dead card.
        isStaleUnansweredRecoveredInteraction(interaction) {
            if (!interaction?._recovered) return false;
            if (interaction.direction !== 'inbound') return false;
            const hasLiveSession = Boolean(this.manager?.callManager?.currentSession)
                && this.currentInteractionId === interaction.id;
            if (hasLiveSession) return false;
            const status = this.effectiveInteractionStatus(interaction);
            if (!this.isTerminalVisualStatus(status)) return false;
            return !(interaction.wrapUpPending || interaction.needsDisposition);
        }

        // ── Phase 1E-B3/timer-fix: effective-status header overlay ─────────────
        // Ready/Paused/Offline (the REQUESTED status) are owned by the blade
        // inline script (currentStatus/statusSince/startTimer()). This overlay
        // temporarily takes over the SAME #statusDot/#statusLabel/#statusTimer
        // elements with Ringing/In Call/Wrap-Up whenever genuine Voice work is
        // happening, then hands the header back via
        // window.repaintRequestedAgentStatus() — never touches AgentSession or
        // currentStatus itself.
        //
        // SINGLE-OWNER RULE: neither this code nor blade's startTimer() is
        // allowed to run its own setInterval against #statusTimer anymore. Both
        // go exclusively through window.HeaderStatusTimer.set()/.stop() — the one
        // shared writer, with its own generation counter that makes a stale
        // callback from a superseded state permanently inert. This fixes a real
        // defect where blade's requested-status timer kept ticking independently
        // after an effective transition, alternating the displayed value with
        // the new overlay's timer (see docs/voice/VOICE_STATUS.md).

        recomputeEffectiveVoiceStatusOverlay() {
            let inCall = null;
            let ringing = null;
            let wrapUp = null;
            let outbound = null;

            for (const interaction of this.voiceInteractions.values()) {
                const status = this.effectiveInteractionStatus(interaction);
                if (interaction.direction === 'outbound'
                    && !this.isTerminalVisualStatus(status)
                    && !interaction.wrapUpPending) {
                    if (!outbound) outbound = interaction;
                    continue;
                }
                if (interaction.direction === 'inbound' && (status === 'In Call' || status === 'On Hold')) {
                    if (!inCall || (interaction.connectedAt && interaction.connectedAt < inCall.connectedAt)) {
                        inCall = interaction;
                    }
                } else if (interaction.direction === 'inbound' && (status === 'Ringing' || status === 'Connecting')) {
                    if (!ringing) ringing = interaction;
                } else if (interaction.wrapUpPending && this.interactionWasAnswered(interaction)) {
                    if (!wrapUp) wrapUp = interaction;
                }
            }

            if (outbound) {
                this.applyEffectiveVoiceStatusOverlay('in_call', outbound.connectedAt || outbound.ringingAt || outbound.createdAt || new Date(), {
                    label: 'Outbound Call',
                });
            } else if (inCall) {
                this.applyEffectiveVoiceStatusOverlay('in_call', inCall.connectedAt || new Date());
            } else if (ringing) {
                this.applyEffectiveVoiceStatusOverlay('ringing', ringing.ringingAt || ringing.createdAt || new Date());
            } else if (wrapUp) {
                this.applyEffectiveVoiceStatusOverlay('wrap_up', wrapUp.endedAt || new Date());
            } else {
                this.clearEffectiveVoiceStatusOverlay();
            }
        }

        applyEffectiveVoiceStatusOverlay(status, since, options = {}) {
            const presentation = {
                ringing: { color: '#3b82f6', label: 'Ringing' },
                in_call: { color: '#16a34a', label: 'In Call' },
                wrap_up: { color: '#f59e0b', label: 'Wrap-Up' },
            }[status];
            if (!presentation) return;

            const label = options.label || presentation.label;
            if (this._effectiveVoiceStatus === status && this._effectiveVoiceStatusLabel === label) {
                return;
            }

            this._effectiveVoiceStatus = status;
            this._effectiveVoiceStatusLabel = label;
            // Global Status Selector Visual Lock: the same signal that owns the
            // header overlay also locks the selector — reusing this one detection
            // point (not a second copy) so Ringing/In Call/Wrap-Up, inbound or
            // outbound, all lock identically. See setAgentStatusSelectorEnabled()
            // in console/index.blade.php for the actual aria-disabled/menu-close.
            this.setStatusSelectorEnabled(false);

            if (typeof window.HeaderStatusTimer?.set === 'function') {
                window.HeaderStatusTimer.set(status, since, {
                    label,
                    dotColor: presentation.color,
                });
            }
        }

        clearEffectiveVoiceStatusOverlay() {
            if (!this._effectiveVoiceStatus) return;

            this._effectiveVoiceStatus = null;
            this._effectiveVoiceStatusLabel = null;
            this.setStatusSelectorEnabled(true);

            if (typeof window.repaintRequestedAgentStatus === 'function') {
                window.repaintRequestedAgentStatus();
            }
        }

        // Used by blade's startTimer() to decide whether the requested-status
        // timer is allowed to write to the header right now (single-owner rule).
        // Also the single source of truth for the Global Status Selector Lock.
        hasActiveEffectiveVoiceStatusOverlay() {
            return Boolean(this._effectiveVoiceStatus);
        }

        // Used by the selector's locked-click toast to show the right message
        // (Wrap-Up gets the After Disposition Status hint; Ringing/In Call get
        // the generic "unavailable" message).
        effectiveVoiceStatusInfo() {
            return this._effectiveVoiceStatus
                ? { status: this._effectiveVoiceStatus, label: this._effectiveVoiceStatusLabel }
                : null;
        }

        selectInteraction(id, options = {}) {
            const interaction = this.voiceInteractions.get(id);
            if (!interaction) return;

            // Empty-panel defect guard: a recovered tray card that is actually a
            // never-answered-terminal ghost (no live session, no Wrap-Up pending)
            // must never be opened as an actionable interaction. Discard it safely
            // and fall back to the normal empty state instead of leaving the agent
            // looking at a dead panel with no disposition path.
            if (this.isStaleUnansweredRecoveredInteraction(interaction)) {
                this.discardUnansweredOffer(interaction);
                return;
            }

            if (!options.shellReady) {
                if (this.activeVoiceInteractionId === id
                    && document.getElementById('voiceCallPanel')) {
                    this.renderInteraction(interaction);
                    this.renderLeadForInteraction(interaction);
                    return;
                }
                if (typeof window.openConversation === 'function') {
                    window.openConversation(id);
                    return;
                }
            }
            this.activeVoiceInteractionId = id;
            window.activeConversationId = null;
            document.querySelectorAll('.conv-item, .voice-local-card')
                .forEach(item => item.classList.remove('selected'));
            document.querySelector(
                `.voice-local-card[data-voice-id="${id}"]`
            )?.classList.add('selected');

            // Restore per-conversation lead panel state.
            // KEY RULE: always use 'voice:{id}' (the local voice-local-uuid) as the
            // canonical key for Voice within a session.  _leadPanelCurrentKey() in the
            // blade uses activeVoiceInteractionId (= interaction.id) for the SAVE path,
            // so both paths must agree on the same key.
            //
            // Using conversationId here would diverge: save='voice:voice-local-uuid'
            // vs restore='voice:123' → no stored state → wrong default.
            const stateKey = `voice:${id}`;
            if (typeof window.restoreLeadPanelFor === 'function') {
                window.restoreLeadPanelFor(stateKey);
            }

            this.renderInteraction(interaction);

            // Always start lead lookup in background on selection.
            this.ensureLeadLoadedForInteraction(interaction);

            // If panel is open (restored or defaulted), render current lead state.
            if (window.isLeadPanelOpen?.()) {
                this.renderLeadForInteraction(interaction);
            }
        }

        deactivateInteraction() {
            this.activeVoiceInteractionId = null;
            document.querySelectorAll('.voice-local-card')
                .forEach(card => card.classList.remove('selected'));
        }

        findInteractionByConversationId(conversationId) {
            const id = Number(conversationId);
            if (!Number.isFinite(id)) return null;
            return Array.from(this.voiceInteractions?.values() || [])
                .find(interaction => Number(interaction.conversationId) === id) || null;
        }

        linkedidForInteraction(interaction) {
            return interaction?.asteriskLinkedid
                || interaction?.acdMetadata?.asterisk_linkedid
                || null;
        }

        findCanonicalStateInteraction(interaction) {
            if (!interaction) return null;
            if (interaction.persistedCallUuid) return interaction;

            const linkedid = this.linkedidForInteraction(interaction);
            if (linkedid) {
                const byLinkedid = Array.from(this.voiceInteractions?.values() || [])
                    .find(candidate => candidate !== interaction
                        && candidate.persistedCallUuid
                        && this.linkedidForInteraction(candidate) === linkedid);
                if (byLinkedid) return byLinkedid;
            }

            if (interaction.conversationId) {
                const byConversation = Array.from(this.voiceInteractions?.values() || [])
                    .find(candidate => candidate !== interaction
                        && candidate.persistedCallUuid
                        && Number(candidate.conversationId) === Number(interaction.conversationId));
                if (byConversation) return byConversation;
            }

            return interaction;
        }

        statePatchCallUuidForInteraction(interaction) {
            const callUuid = interaction?.persistedCallUuid || null;
            return typeof callUuid === 'string' && callUuid.trim() ? callUuid.trim() : null;
        }

        logSkippedStatePatch(interaction, attemptedUuid, state, reason) {
            this.debug('[InboundAcdIdentity] stale state update skipped', {
                linkedid: this.linkedidForInteraction(interaction),
                conversation_id: interaction?.conversationId || null,
                persisted_call_uuid: interaction?.persistedCallUuid || null,
                attempted_uuid: attemptedUuid || null,
                event_type: state || null,
                reason,
            });
        }

        _isPreviewAutoRecoveryCandidate(interaction) {
            if (!interaction?._recovered || !interaction?.conversationId || !interaction.callUuid) {
                return false;
            }
            if (this.isTerminalVisualStatus(this.effectiveInteractionStatus(interaction))) {
                return false;
            }
            if (!['ringing', 'connecting'].includes(String(interaction.backendCallState || '').toLowerCase())) {
                return false;
            }
            if (interaction.backendAnsweredAt || interaction.backendEndedAt) {
                return false;
            }
            if (this.manager?.callManager?.currentSession) {
                return false;
            }
            return true;
        }

        schedulePreviewAutoRecovery(interaction) {
            if (!this._isPreviewAutoRecoveryCandidate(interaction)) return;

            const callUuid = String(interaction.callUuid || '');
            if (!callUuid
                || this._previewAutoRecoveryScheduled.has(callUuid)
                || this._previewAutoRecoveryInFlight.has(callUuid)
                || this._previewAutoRecoveryAttempts.has(callUuid)) {
                return;
            }

            this._previewAutoRecoveryScheduled.add(callUuid);
            interaction.previewRecoveryStatus = interaction.previewRecoveryStatus || 'recovering';

            window.setTimeout(() => {
                this._runPreviewAutoRecovery(interaction, callUuid);
            }, 0);
        }

        _runPreviewAutoRecovery(interaction, callUuid) {
            if (!this._isPreviewAutoRecoveryCandidate(interaction)) {
                this.debug('Preview auto recovery skipped', {
                    reason: 'candidate_no_longer_valid',
                    conversation_id: interaction?.conversationId || null,
                    call_uuid: callUuid,
                });
                return;
            }

            if (this._previewAutoRecoveryInFlight.has(callUuid)
                || this._previewAutoRecoveryAttempts.has(callUuid)) {
                return;
            }

            this._previewAutoRecoveryInFlight.add(callUuid);

            Promise.resolve(
                window.PreviewDialerAgent?.ensureCurrentOfferForRecovery?.(
                    interaction.conversationId,
                    interaction.callUuid
                )
            )
                .then(offer => {
                    if (!offer) {
                        interaction.previewRecoveryStatus = 'failed';
                        this.debug('Preview auto recovery skipped', {
                            reason: 'accepted_offer_not_found',
                            conversation_id: interaction.conversationId,
                            call_uuid: interaction.callUuid,
                        });
                        return null;
                    }

                    if (this._previewAutoRecoveryAttempts.has(callUuid)) {
                        return null;
                    }
                    this._previewAutoRecoveryAttempts.add(callUuid);
                    interaction.previewRecoveryStatus = 'recovering';

                    this.debug('Preview auto recovery posting recover-stale-call', {
                        conversation_id: interaction.conversationId,
                        call_uuid: interaction.callUuid,
                        offer_status: offer.status,
                        offer_active_slot: offer.active_slot,
                    });

                    return window.PreviewDialerAgent.recoverStaleCallAfterRefresh(offer, interaction.conversationId);
                })
                .then(result => {
                    if (!result) return;
                    if (result?.ok && result?.voice_call?.is_terminal && result?.offer && !['pending', 'accepted'].includes(result.offer.status)) {
                        this._applyPreviewAutoRecoveryResult(interaction, result);
                        window.PreviewDialerAgent?.setVoiceWrapUpPending?.(true);
                    } else {
                        interaction.previewRecoveryStatus = 'failed';
                    }
                })
                .catch(err => {
                    interaction.previewRecoveryStatus = 'failed';
                    this.debug('Preview auto recovery failed', {
                        interaction_id: interaction.id,
                        conversation_id: interaction.conversationId,
                        call_uuid: interaction.callUuid,
                        error: namespace.safeError(err),
                    });
                })
                .finally(() => {
                    this._previewAutoRecoveryInFlight.delete(callUuid);
                    if (this.activeVoiceInteractionId === interaction.id) {
                        this.renderInteraction(interaction);
                    }
                    this.renderTrayInteractions();
                });
        }

        _applyPreviewAutoRecoveryResult(interaction, result) {
            const voiceCall = result.voice_call;
            const endedAt = voiceCall.ended_at ? new Date(voiceCall.ended_at) : new Date();

            interaction.status = this.visualCallStatus(voiceCall.call_state || 'cancelled');
            interaction.backendCallState = voiceCall.call_state || 'cancelled';
            interaction.backendAnsweredAt = voiceCall.answered_at || null;
            interaction.backendEndedAt = voiceCall.ended_at || endedAt.toISOString();
            interaction.endedAt = endedAt;
            interaction.wrapUpPending = result.is_voice_wrap_up !== undefined
                ? Boolean(result.is_voice_wrap_up)
                : Boolean(voiceCall.answered_at);
            interaction.needsDisposition = interaction.wrapUpPending
                || (interaction.direction === 'outbound' && !voiceCall.answered_at);
            interaction.previewRecoveryStatus = 'recovered';
            interaction.hasLocalSession = false;
            interaction.isRecovered = true;

            interaction.events = this._buildTimelineFromBackend(voiceCall);
            const terminalEvent = interaction.events?.find(event => {
                const eventAt = event.at instanceof Date ? event.at.toISOString() : '';
                return eventAt === endedAt.toISOString()
                    || ['Ended', 'Cancelled', 'No Answer', 'Failed'].includes(event.status);
            });
            if (terminalEvent) {
                terminalEvent.status = 'Call recovered and closed automatically';
                terminalEvent.label = 'Call recovered and closed automatically';
            } else {
                interaction.events = interaction.events || [];
                interaction.events.push({
                    status: 'Call recovered and closed automatically',
                    label: 'Call recovered and closed automatically',
                    at: endedAt,
                });
            }

            this._prewarmDispositionsIfTerminal(interaction);
        }

        _isRecoveredStateDowngrade(interaction, voiceCall) {
            if (!interaction || !voiceCall) return false;
            if (interaction.previewRecoveryStatus !== 'recovered') return false;
            if (String(interaction.callUuid || '') !== String(voiceCall.call_uuid || '')) return false;
            if (!this.isTerminalVisualStatus(this.effectiveInteractionStatus(interaction))) return false;
            return !voiceCall.is_terminal;
        }

        renderInteraction(interaction) {
            const panel = document.getElementById('messagePanel');
            if (!panel) return;

            // When we have cached dispositions for this interaction, push them into the
            // global slot so the Disposition modal always shows the correct options —
            // even when no renderVoiceConversationFromBackend() ran for this session.
            if (interaction.dispositionsLoaded
                && Array.isArray(interaction.dispositions)
                && typeof window.setCurrentDispositions === 'function') {
                window.setCurrentDispositions(interaction.dispositions);
            }
            const effectiveStatus = this.effectiveInteractionStatus(interaction);
            const live = this.currentInteractionId === interaction.id
                && Boolean(this.manager?.callManager.currentSession)
                && !this.isTerminalVisualStatus(effectiveStatus);
            const inbound = interaction.direction === 'inbound';
            const incomingPending = inbound
                && effectiveStatus === 'Ringing'
                && live;
            const icon = inbound
                ? 'bi-telephone-inbound-fill'
                : 'bi-telephone-outbound-fill';
            const direction = inbound ? 'INBOUND' : 'OUTBOUND';
            const displayStatus = this.visualCallStatus(effectiveStatus);
            const established = ['In Call', 'On Hold'].includes(displayStatus);
            const terminal = this.isTerminalVisualStatus(displayStatus);
            // Phase 1E-B2: a terminal INBOUND interaction only forces the Disposition/
            // Transfer action set when it was actually answered. An unanswered offer
            // (Reject/Missed/Cancelled) is discarded from the tray before this can
            // render at all (see discardUnansweredOffer()) — this condition is defense
            // in depth for the brief frame before that removal completes. Outbound is
            // intentionally left as `terminal` alone, unchanged from prior behavior.
            const terminalNeedsWrapUp = terminal && this.interactionWasAnswered(interaction);
            const terminalNeedsDisposition = terminal && Boolean(interaction.conversationId);
            const wrapUpActionReady = Boolean(interaction.conversationId
                && (terminalNeedsWrapUp || interaction.needsDisposition || interaction.previewRecoveryStatus === 'recovered'));
            const recoveredWithoutRtc = Boolean(
                interaction._recovered
                && !terminal
                && !live
            );
            const showRecoveryNotice = recoveredWithoutRtc
                || ['recovering', 'recovered', 'failed'].includes(interaction.previewRecoveryStatus);
            const suppressRecoveredCallControls = recoveredWithoutRtc;
            const primaryActions = suppressRecoveredCallControls
                ? ''
                : this._buildPrimaryActions(
                    interaction, live, incomingPending, established, terminal
                );
            const headerPhone = this.voiceDisplayPhone(interaction) || this.interactionDisplayName(interaction);
            const headerMeta = [
                this.voiceDirectionLabel(interaction),
                this.voiceQueueDisplayName(interaction),
                this.voiceCampaignName(interaction),
                displayStatus,
            ].filter(part => part && part !== '—');
            const timeline = (interaction.events || []).map(event => `
                <div class="voice-timeline-event">
                    <span class="voice-timeline-marker"></span>
                    <div>
                        <div class="voice-timeline-status">${this.escape(event.label || event.status)}</div>
                        <div class="voice-timeline-time">${this.escape(this.eventTime(event.at))}</div>
                    </div>
                </div>
            `).join('');

            // Determine what to show in the timeline area:
            //  - events exist: show them
            //  - fetch pending + no events: show skeleton rows (not "no events yet")
            //  - no fetch pending + no events: show empty message
            const timelineContent = timeline || (interaction.fetchPending
                ? `<div style="display:flex;flex-direction:column;gap:8px;padding:8px 0;">
                       <div class="sk" style="height:44px;border-radius:var(--radius-sm);"></div>
                       <div class="sk" style="height:44px;width:85%;border-radius:var(--radius-sm);"></div>
                       <div class="sk" style="height:44px;width:92%;border-radius:var(--radius-sm);"></div>
                   </div>`
                : '<div style="padding:16px;color:var(--text-muted);font-size:13px;text-align:center;">No call events recorded.</div>');
            const activeTab = document.getElementById('voiceCallPanel')
                && document.getElementById('tabScript')
                    ?.classList.contains('active')
                ? 'script'
                : 'conversation';
            if (typeof window.renderConversationTabs !== 'function') {
                // Panel helpers aren't registered yet (Blade main script still loading).
                // Store this interaction as the pending render; a single { once } listener
                // will flush it as soon as 'agent-console-panel-ready' fires.
                // Multiple clicks before ready: only the last selected interaction renders
                // (matches normal behaviour where the last click wins).
                this._pendingRenderInteraction = interaction;
                if (!this._panelReadyListenerAdded) {
                    this._panelReadyListenerAdded = true;
                    window.addEventListener('agent-console-panel-ready', () => {
                        this._panelReadyListenerAdded = false;
                        const pending = this._pendingRenderInteraction;
                        this._pendingRenderInteraction = null;
                        if (pending) this.renderInteraction(pending);
                    }, { once: true });
                }
                return;
            }
            // Clear any stale pending now that helpers are available.
            this._pendingRenderInteraction = null;
            const tabs = window.renderConversationTabs();
            // Use real script from backend if available; fall back to placeholder
            const scriptContent = window._renderScriptContent(
                interaction.scriptData || null,
                interaction.scriptSource || null,
                'No script configured for this voice interaction'
            );
            panel.style.cssText = 'display:flex;flex-direction:column;background:var(--bg-page);overflow:hidden;position:relative;min-height:0;flex:1;min-width:0;';
            const voicePanelHtml = `
                <div id="voiceCallPanel" style="display:flex;flex-direction:column;height:100%;">
                    <div class="voice-conversation-header">
                        <div class="voice-header-identity">
                            <span class="voice-channel-icon"><i class="bi ${icon}"></i></span>
                            <div class="voice-header-copy">
                                <div class="voice-header-title">${this.escape(headerPhone || '—')}</div>
                                <div class="voice-header-meta">${headerMeta.map(part => `<span>${this.escape(part)}</span>`).join('')}<span id="voiceQaCallStatus" style="display:none;">${this.escape(displayStatus)}</span></div>
                            </div>
                        </div>
                        <div class="voice-header-actions">
                            ${established ? `<span id="voiceQaCallDuration" class="voice-call-duration">${this.durationText(interaction)}</span>` : ''}
                            ${this._leadBtn()}
                            ${terminalNeedsDisposition ? this._iconBtn('voiceQaDisposition', 'bi-tag-fill', 'Set Disposition', '', false) : ''}
                            ${terminalNeedsDisposition ? this._transferConversationBtn(interaction.conversationId) : ''}
                            ${primaryActions}
                        </div>
                    </div>
                    ${tabs}
                    <div id="convContentArea" class="voice-conversation-content" style="display:flex;flex-direction:column;">
                        ${this._renderVoiceSummaryCard(interaction, displayStatus)}
                        ${showRecoveryNotice ? `
                        <div class="voice-recovered-call-notice" style="margin:10px 16px 0;padding:10px 12px;border:1px solid #fde68a;background:#fffbeb;color:#92400e;border-radius:var(--radius-sm);font-size:12px;line-height:1.45;">
                            ${interaction.previewRecoveryStatus === 'recovering'
                                ? 'Recovering call state...'
                                : interaction.previewRecoveryStatus === 'failed'
                                    ? 'This call was recovered after a browser refresh. Automatic closure failed; watchdog recovery will retry shortly.'
                                    : interaction.previewRecoveryStatus === 'recovered'
                                        ? 'This call was recovered after a browser refresh. The call was closed automatically. Select a disposition to continue.'
                                        : 'This call was recovered after a browser refresh. Local call controls are unavailable while recovery runs.'}
                        </div>` : ''}
                        <div class="voice-conversation-grid">
                            ${this._renderVoiceCallInformation(interaction)}
                            ${this._renderVoiceTimelinePanel(timelineContent)}
                        </div>
                        ${terminal && !interaction.conversationId ? `
                        <div style="padding:12px 16px;background:var(--bg-th);border-top:1px solid var(--border);font-size:12px;color:var(--text-muted);text-align:center;">
                            Saving call record… Disposition will be available shortly.
                        </div>` : ''}
                        ${this._renderVoiceTechnicalDetails(interaction)}
                    </div>
                    ${terminalNeedsDisposition && !established ? `
                    <div id="voiceTerminalDispositionNotice" style="padding:12px 16px;background:var(--bg-th);border-top:1px solid var(--border);font-size:13px;color:var(--text-muted);text-align:center;">
                        ${terminalNeedsWrapUp
                            ? 'Call ended &mdash; select a disposition to complete this interaction.'
                            : 'Call not connected &mdash; select an outcome.'}
                    </div>` : ''}
                    <div id="scriptContentArea" style="flex:1;display:none;flex-direction:column;min-height:0;overflow:hidden;background:var(--bg-page);">
                        ${scriptContent}
                    </div>
                </div>`;
            panel.innerHTML = voicePanelHtml;
            window.switchConvTab(activeTab);
            // btnToggleLead uses onclick="toggleLeadPanel()" (attribute in HTML, same as
            // Email/Facebook). toggleLeadPanel() is the single handler for all channels.
            // No addEventListener needed here — it would accumulate on every re-render.
            document.getElementById('voiceQaDisposition')?.addEventListener(
                'click',
                async (e) => {
                    if (!interaction.conversationId) return;
                    const btn = e.currentTarget;
                    if (btn.disabled || btn.dataset.loading) return;

                    // If dispositions are already loaded, open modal instantly
                    if (interaction.dispositionsLoaded && Array.isArray(interaction.dispositions)) {
                        if (typeof window.setCurrentDispositions === 'function') {
                            window.setCurrentDispositions(interaction.dispositions);
                        }
                        if (typeof window.setDisposition === 'function') {
                            window.setDisposition(interaction.conversationId, 'voice');
                        }
                        return;
                    }

                    // Dispositions not loaded yet — fetch now, prevent double-click
                    const origTitle = btn.title;
                    btn.dataset.loading = '1';
                    btn.style.opacity = '.55';
                    btn.title = 'Loading dispositions…';

                    try {
                        await this.ensureVoiceDispositionsLoaded(interaction);
                        // Guard: don't open modal if user navigated away
                        if (this.activeVoiceInteractionId !== interaction.id) return;
                        if (typeof window.setDisposition === 'function') {
                            window.setDisposition(interaction.conversationId, 'voice');
                        }
                    } catch (err) {
                        this.notify('Could not load dispositions. Please try again.', 'error');
                    } finally {
                        delete btn.dataset.loading;
                        btn.style.opacity = '';
                        btn.title = origTitle;
                    }
                }
            );
            document.getElementById('voiceQaCallAgain')?.addEventListener(
                'click',
                () => this.prepareCallAgain(interaction)
            );
            document.getElementById('voiceQaAnswer')?.addEventListener(
                'click',
                () => this.answerIncomingCall()
            );
            document.getElementById('voiceQaReject')?.addEventListener(
                'click',
                () => this.runCallAction(() => this.rejectIncomingCall())
            );
            document.getElementById('voiceQaMute')?.addEventListener(
                'click',
                () => this.runCallAction(() =>
                    this.manager.callManager.toggleMute()
                )
            );
            document.getElementById('voiceQaHold')?.addEventListener(
                'click',
                () => this.runCallAction(() =>
                    this.manager.callManager.toggleHold()
                )
            );
            document.getElementById('voiceQaHangup')?.addEventListener(
                'click',
                () => this.runCallAction(() =>
                    this.manager.callManager.hangUp()
                )
            );
            this.syncPanelControls();

            // Re-apply lead button active state after innerHTML replacement.
            // The button was recreated from static markup (var(--bg-th)), so we need
            // to sync it with the current leadPanelOpen value via the same mechanism
            // that openLeadPanel()/closeLeadPanel() use.
            const leadBtn = document.getElementById('btnToggleLead');
            if (leadBtn) {
                leadBtn.style.background = window.isLeadPanelOpen?.()
                    ? 'var(--primary-light)'
                    : 'var(--bg-th)';
            }
        }

        interactionWasAnswered(interaction) {
            return Boolean(interaction?.connectedAt || interaction?.backendAnsweredAt);
        }

        prepareCallAgain(interaction) {
            this.openDialer();
            const phone = document.getElementById('voiceQaPhone');
            if (phone) phone.value = interaction.normalizedPhone;
        }

        eventTime(value) {
            const date = value instanceof Date ? value : new Date(value);
            return Number.isNaN(date.getTime())
                ? ''
                : date.toLocaleTimeString([], {
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit',
                });
        }

        voiceChannelBadge() {
            // Same markup pattern as Email/Facebook/WhatsApp badges in conv-item:
            //   <span class="badge" style="font-size:10px;background:X;color:Y;
            //       display:inline-flex;align-items:center;gap:3px;">
            //     <i class="bi Z" style="font-size:9px;"></i> LABEL
            //   </span>
            return '<span class="badge voice-channel-badge" '
                + 'style="font-size:10px;background:#EAF3DE;color:#3B6D11;'
                + 'display:inline-flex;align-items:center;gap:3px;">'
                + '<i class="bi bi-telephone-fill" aria-hidden="true" style="font-size:9px;"></i>'
                + 'VOICE</span>';
        }

        normalizeRemoteNumber(value) {
            const raw = String(value || '').trim();
            const digits = raw.replace(/\D/g, '');
            if (!digits) return '';
            return raw.startsWith('+') ? `+${digits}` : digits;
        }

        normalizeNanpPhone(value) {
            const digits = String(value || '').replace(/\D/g, '');
            if (!digits) return '';
            if (digits.length === 11 && digits.startsWith('1')) {
                return digits.slice(1);
            }
            return digits;
        }

        formatPhoneDisplay(value) {
            const normalized = this.normalizeNanpPhone(value);
            if (!normalized) return '';
            if (/^\d{10}$/.test(normalized)) {
                return `(${normalized.slice(0, 3)}) ${normalized.slice(3, 6)}-${normalized.slice(6)}`;
            }
            return normalized;
        }

        phoneNumbersMatch(left, right) {
            const a = this.normalizeRemoteNumber(left).replace(/\D/g, '');
            const b = this.normalizeRemoteNumber(right).replace(/\D/g, '');
            if (!a || !b) return false;
            if (a === b) return true;
            return a.length >= 10 && b.length >= 10
                && a.slice(-10) === b.slice(-10);
        }

        lockPreviewDynamicRow(interaction, conversationId, dynamicRow) {
            const convId = Number(conversationId || interaction?.conversationId || 0);
            const rowId = dynamicRow?.id || interaction?.dynamicLeadRow?.id || null;
            if (!convId || !rowId) return;

            this.previewDynamicRowLocks.set(convId, rowId);
            if (interaction) {
                interaction.isPreviewDialer = true;
                interaction.previewDynamicRowLocked = true;
                interaction.backendLeadSnapshotLoaded = true;
                interaction.backendLeadSnapshotConversationId = convId;
                interaction.leadLookupStatus = 'dynamic_row';
            }
            console.warn('[LEAD-PANEL-SNAPSHOT] preview dynamic row locked', {
                conversationId: convId,
                dynamicRowId: rowId,
            });
        }

        previewDynamicRowLockId(interaction) {
            const convId = Number(interaction?.conversationId || 0);
            if (convId && this.previewDynamicRowLocks?.has(convId)) {
                return this.previewDynamicRowLocks.get(convId);
            }
            if (interaction?.previewDynamicRowLocked && interaction.dynamicLeadRow) {
                return interaction.dynamicLeadRow?.id || true;
            }
            if (interaction?.dynamicLeadRow && interaction.leadLookupStatus === 'dynamic_row') {
                return interaction.dynamicLeadRow?.id || true;
            }
            if ((interaction?.leadListRowId || interaction?.lead_list_row_id)
                && !interaction?.leadId
                && interaction?.backendLeadSnapshotLoaded
                && interaction?.dynamicLeadRow) {
                return interaction.dynamicLeadRow?.id || true;
            }
            return null;
        }

        isPreviewDynamicRowLocked(interaction) {
            return Boolean(this.previewDynamicRowLockId(interaction));
        }

        isPreviewDynamicContextPending(interaction) {
            return Boolean(interaction?.conversationId
                && !interaction.lead
                && !interaction.leadId
                && !interaction.dynamicLeadRow
                && !interaction.backendLeadSnapshotLoaded
                && (interaction.leadListRowId || interaction.lead_list_row_id));
        }

        crmSearchCampaignIdForInteraction(interaction) {
            return interaction?.conversationCampaignId
                || interaction?.crmCampaign?.id
                || interaction?.campaignId
                || interaction?.dialerCampaign?.campaign_id
                || null;
        }

        normalizedCampaignId(value) {
            const id = Number(value || 0);
            return Number.isFinite(id) && id > 0 ? id : null;
        }

        isLeadAllowedForInteraction(interaction, lead) {
            if (!lead) return false;
            const campaignId = this.normalizedCampaignId(this.crmSearchCampaignIdForInteraction(interaction));
            if (!campaignId) return true;
            return this.normalizedCampaignId(lead.campaign_id) === campaignId;
        }

        leadLookupTokenForInteraction(interaction) {
            return [
                interaction?.id || '',
                interaction?.conversationId || '',
                this.linkedidForInteraction(interaction) || '',
                this.crmSearchCampaignIdForInteraction(interaction) || '',
            ].join('|');
        }

        resolveLeadForInteraction(interaction, force = false) {
            if (!interaction) return Promise.resolve(null);
            if (this.isPreviewDynamicRowLocked(interaction)) {
                console.warn('[LEAD-PANEL-SNAPSHOT] blocked CRM search because Preview dynamic row locked', {
                    conversationId: interaction.conversationId,
                    dynamicRowId: this.previewDynamicRowLockId(interaction) || interaction.dynamicLeadRow?.id || null,
                    phone: interaction.normalizedPhone || interaction.phone || null,
                });
                interaction.leadLookupStatus = 'dynamic_row';
                return Promise.resolve(null);
            }
            if (this.isPreviewDynamicContextPending(interaction)) {
                console.warn('[LEAD-PANEL-SNAPSHOT] blocked CRM search while Preview dynamic snapshot is pending', {
                    conversationId: interaction.conversationId,
                    leadListRowId: interaction.leadListRowId || interaction.lead_list_row_id || null,
                    phone: interaction.normalizedPhone || interaction.phone || null,
                });
                interaction.leadLookupStatus = 'loading';
                return this.fetchPersistedConversationDetail(interaction);
            }
            if (interaction.lead) {
                if (!this.isLeadAllowedForInteraction(interaction, interaction.lead)) {
                    console.warn('[LEAD-PANEL-SNAPSHOT] cleared cross-campaign in-memory lead', {
                        conversationId: interaction.conversationId || null,
                        leadId: interaction.lead.id || null,
                        leadCampaignId: interaction.lead.campaign_id || null,
                        expectedCampaignId: this.crmSearchCampaignIdForInteraction(interaction),
                    });
                    interaction.lead = null;
                    interaction.leadId = null;
                    interaction.leadLookupStatus = 'not_found';
                    return Promise.resolve(null);
                }
                interaction.leadLookupStatus = 'found';
                interaction.displayName = [interaction.lead.first_name, interaction.lead.last_name]
                    .filter(Boolean).join(' ') || interaction.lead.phone || interaction.displayName || interaction.phone;
                if (window.isLeadPanelOpen?.() && this.activeVoiceInteractionId === interaction.id) {
                    this.renderLeadForInteraction(interaction);
                }
                return Promise.resolve(interaction.lead);
            }
            if (interaction.leadId && !interaction.lead) {
                interaction.leadLookupStatus = 'lead_pending';
                if (window.isLeadPanelOpen?.() && this.activeVoiceInteractionId === interaction.id) {
                    this.renderLeadForInteraction(interaction);
                }
                return Promise.resolve(null);
            }
            if (interaction.dynamicLeadRow) {
                interaction.leadLookupStatus = 'dynamic_row';
                if (window.isLeadPanelOpen?.() && this.activeVoiceInteractionId === interaction.id) {
                    this.renderLeadForInteraction(interaction);
                }
                return Promise.resolve(null);
            }
            if (!force && interaction.leadLookupStatus === 'loading') {
                return interaction.leadLookupPromise;
            }
            // If status is already settled and panel is open, render immediately.
            // If panel is closed, just return without rendering.
            if (!force && ['found', 'not_found', 'failed', 'dynamic_row'].includes(
                interaction.leadLookupStatus
            )) {
                if (window.isLeadPanelOpen?.() && this.activeVoiceInteractionId === interaction.id) {
                    this.renderLeadForInteraction(interaction);
                }
                return Promise.resolve(interaction.lead);
            }

            const digits = interaction.normalizedPhone.replace(/\D/g, '');
            if (!digits) {
                interaction.leadLookupStatus = interaction.dynamicLeadRow ? 'dynamic_row' : 'not_found';
                if (window.isLeadPanelOpen?.() && this.activeVoiceInteractionId === interaction.id) {
                    this.renderLeadForInteraction(interaction);
                }
                return Promise.resolve(null);
            }

            interaction.leadLookupStatus = 'loading';
            const query = digits.slice(-4);
            const interactionId = interaction.id;
            const campaignId = this.crmSearchCampaignIdForInteraction(interaction);
            const lookupToken = this.leadLookupTokenForInteraction(interaction);
            interaction._leadLookupToken = lookupToken;
            const searchParams = new URLSearchParams({ q: query });
            if (campaignId) {
                searchParams.set('campaign_id', String(campaignId));
            }
            console.warn('[LEAD-PANEL-SNAPSHOT] CRM search requested', {
                conversationId: interaction.conversationId || null,
                interactionId,
                phone: interaction.normalizedPhone || interaction.phone || null,
                reason: force ? 'force' : 'voice_lead_lookup',
                campaignId,
                isPreviewDialer: Boolean(interaction.isPreviewDialer),
                previewDynamicRowLocked: Boolean(interaction.previewDynamicRowLocked),
                hasDynamicRow: Boolean(interaction.dynamicLeadRow),
                lockMapHasConversation: this.previewDynamicRowLocks?.has?.(Number(interaction.conversationId || 0)) || false,
            });
            interaction.leadLookupPromise = window.fetch(
                `/console/leads/search?${searchParams.toString()}`,
                { headers: { Accept: 'application/json' } }
            ).then(response => {
                if (!response.ok) throw new Error('Lead lookup failed.');
                return response.json();
            }).then(data => {
                if (interaction._leadLookupToken !== lookupToken) {
                    return null;
                }
                if (this.isPreviewDynamicRowLocked(interaction)) {
                    console.warn('[LEAD-PANEL-SNAPSHOT] blocked CRM lead fetch because Preview dynamic row locked', {
                        conversationId: interaction.conversationId,
                        leadId: null,
                        dynamicRowId: this.previewDynamicRowLockId(interaction) || interaction.dynamicLeadRow?.id || null,
                    });
                    return null;
                }
                const expectedCampaignId = this.normalizedCampaignId(campaignId);
                const matches = (data.leads || []).filter(candidate => {
                    if (!this.phoneNumbersMatch(candidate.phone, interaction.normalizedPhone)) {
                        return false;
                    }
                    if (!expectedCampaignId) return true;
                    return this.normalizedCampaignId(candidate.campaign_id) === expectedCampaignId;
                });
                if (matches.length !== 1) return null;
                if (this.isPreviewDynamicRowLocked(interaction)) {
                    console.warn('[LEAD-PANEL-SNAPSHOT] blocked CRM lead fetch because Preview dynamic row locked', {
                        conversationId: interaction.conversationId,
                        leadId: matches[0].id || null,
                        dynamicRowId: this.previewDynamicRowLockId(interaction) || interaction.dynamicLeadRow?.id || null,
                    });
                    return null;
                }
                console.warn('[LEAD-PANEL-SNAPSHOT] CRM lead fetch requested', {
                    conversationId: interaction.conversationId || null,
                    leadId: matches[0].id,
                    reason: 'voice_lead_lookup_match',
                    isPreviewDialer: Boolean(interaction.isPreviewDialer),
                    previewDynamicRowLocked: Boolean(interaction.previewDynamicRowLocked),
                    hasDynamicRow: Boolean(interaction.dynamicLeadRow),
                    lockMapHasConversation: this.previewDynamicRowLocks?.has?.(Number(interaction.conversationId || 0)) || false,
                });
                const detailParams = new URLSearchParams();
                if (campaignId) {
                    detailParams.set('campaign_id', String(campaignId));
                }
                const detailUrl = `/console/lead/${matches[0].id}${detailParams.toString() ? `?${detailParams.toString()}` : ''}`;
                return window.fetch(detailUrl, {
                    headers: { Accept: 'application/json' },
                }).then(response => {
                    if (!response.ok) {
                        throw new Error('Lead detail lookup failed.');
                    }
                    return response.json();
                });
            }).then(lead => {
                if (interaction._leadLookupToken !== lookupToken) {
                    return null;
                }
                console.warn('[LEAD-PANEL-SNAPSHOT] async CRM lookup result', {
                    conversationId: interaction.conversationId || null,
                    leadId: lead?.id || null,
                    leadCampaignId: lead?.campaign_id || null,
                });
                if (this.isPreviewDynamicRowLocked(interaction)) {
                    console.warn('[LEAD-PANEL-SNAPSHOT] ignored CRM lead response because Preview dynamic row locked', {
                        conversationId: interaction.conversationId,
                        attemptedLeadId: lead?.id || null,
                        attemptedLeadCampaignId: lead?.campaign_id || null,
                        dynamicRowId: this.previewDynamicRowLockId(interaction) || interaction.dynamicLeadRow?.id || null,
                    });
                    return null;
                }
                if (lead && !this.isLeadAllowedForInteraction(interaction, lead)) {
                    console.warn('[LEAD-PANEL-SNAPSHOT] ignored cross-campaign CRM lead response', {
                        conversationId: interaction.conversationId || null,
                        attemptedLeadId: lead.id || null,
                        attemptedLeadCampaignId: lead.campaign_id || null,
                        expectedCampaignId: this.crmSearchCampaignIdForInteraction(interaction),
                    });
                    return null;
                }
                if (!lead && (interaction.lead || interaction.leadId || interaction.dynamicLeadRow)) {
                    return interaction.lead || null;
                }
                if (lead && interaction.lead && Number(interaction.lead.id) !== Number(lead.id)) {
                    return interaction.lead;
                }
                interaction.lead = lead;
                interaction.leadId = lead?.id || null;
                interaction.leadLookupStatus = lead
                    ? 'found'
                    : (interaction.dynamicLeadRow ? 'dynamic_row' : 'not_found');
                if (lead) {
                    // Update display name and remove NO LEAD on tray card
                    interaction.displayName = [lead.first_name, lead.last_name]
                        .filter(Boolean).join(' ') || interaction.phone;
                }
                return lead;
            }).catch(error => {
                interaction.leadLookupStatus = interaction.dynamicLeadRow ? 'dynamic_row' : 'failed';
                this.debug('Voice lead lookup failed', {
                    interaction_id: interactionId,
                    message: namespace.safeError(error),
                });
                return null;
            }).finally(() => {
                // Stale-response guard: either the token was invalidated (discard,
                // or a newer lookup superseded this one) or the interaction itself
                // is no longer tracked at all (removed by discardUnansweredOffer()).
                if (interaction._leadLookupToken !== lookupToken
                    || this.voiceInteractions.get(interactionId) !== interaction) {
                    return;
                }
                interaction.leadLookupPromise = null;
                // Re-render tray card so Lead name / NO LEAD badge updates.
                // Never touch the central panel or LeadPanel from here —
                // that is triggered only by the panel being open.
                this.renderTrayInteractions();
                // If lead panel is open and this is still the active interaction,
                // update the panel with the lookup result (rule: panel open → render).
                if (this.activeVoiceInteractionId === interactionId) {
                    this.renderInteraction(interaction);
                    this.renderLeadForInteraction(interaction);
                }
            });

            return interaction.leadLookupPromise;
        }

        retryVoiceLeadLookup(interactionId) {
            const interaction = this.voiceInteractions.get(interactionId);
            return this.resolveLeadForInteraction(interaction, true);
        }

        fetchPersistedConversationDetail(interaction, options = {}) {
            if (!interaction?.conversationId) {
                console.warn('[LIVE-LEAD-SYNC] skip conversation detail fetch: missing conversationId', {
                    interactionId: interaction?.id,
                    callUuid: interaction?.callUuid,
                    leadId: interaction?.leadId,
                    leadLookupStatus: interaction?.leadLookupStatus,
                });
                return Promise.resolve(null);
            }

            const conversationId = Number(interaction.conversationId);
            if (!conversationId) {
                console.warn('[LIVE-LEAD-SYNC] skip conversation detail fetch: invalid conversationId', {
                    rawConversationId: interaction.conversationId,
                    interactionId: interaction.id,
                    callUuid: interaction.callUuid,
                });
                return Promise.resolve(null);
            }

            const force = Boolean(options.force);

            if (this._conversationDetailFetches.has(conversationId)) {
                console.warn('[LIVE-LEAD-SYNC] join existing conversation detail fetch', {
                    conversationId,
                    interactionId: interaction.id,
                    callUuid: interaction.callUuid,
                    force,
                });
                if (force) {
                    return this._conversationDetailFetches.get(conversationId)
                        .finally(() => this.fetchPersistedConversationDetail(interaction));
                }
                // The same conversation_id can be legitimately reused by a reoffer, so
                // the in-flight fetch may belong to a DIFFERENT (possibly already
                // discarded) interaction object than this caller. Apply the shared
                // result to THIS interaction too, guarded by it still being tracked —
                // never assume the joined promise's own closures will update us.
                return this._conversationDetailFetches.get(conversationId).then(data => {
                    if (this.voiceInteractions.get(interaction.id) !== interaction) {
                        return data;
                    }
                    if (data) {
                        this.applyConversationDetailToInteraction(interaction, data);
                    }
                    this.renderTrayInteractions();
                    if (this.activeVoiceInteractionId === interaction.id) {
                        this.renderInteraction(interaction);
                        this.renderLeadForInteraction(interaction);
                    }
                    return data;
                });
            }

            console.warn('[LIVE-LEAD-SYNC] conversation detail fetch START', {
                conversationId,
                url: `/console/conversation/${conversationId}`,
                interactionId: interaction.id,
                callUuid: interaction.callUuid,
                activeVoiceInteractionId: this.activeVoiceInteractionId,
                leadId: interaction.leadId,
                hasLead: Boolean(interaction.lead),
                hasDynamicLeadRow: Boolean(interaction.dynamicLeadRow),
                leadLookupStatus: interaction.leadLookupStatus,
            });
            interaction.previewLeadDetailLoading = true;

            if (!interaction.lead && !interaction.dynamicLeadRow) {
                interaction.leadLookupStatus = 'loading';
                console.warn('[LIVE-LEAD-SYNC] lead panel loading while conversation detail fetch is pending', {
                    conversationId,
                    interactionId: interaction.id,
                    isActive: this.activeVoiceInteractionId === interaction.id,
                });
                if (this.activeVoiceInteractionId === interaction.id) {
                    this.renderLeadForInteraction(interaction);
                }
            }

            const promise = window.fetch(`/console/conversation/${conversationId}`, {
                headers: { Accept: 'application/json' },
            })
                .then(response => {
                    console.warn('[LIVE-LEAD-SYNC] conversation detail fetch RESPONSE', {
                        conversationId,
                        status: response.status,
                        ok: response.ok,
                    });
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    return response.json();
                })
                .then(data => {
                    console.warn('[LIVE-LEAD-SYNC] conversation detail fetch JSON', {
                        conversationId,
                        lead: data?.lead ? {
                            id: data.lead.id,
                            first_name: data.lead.first_name,
                            last_name: data.lead.last_name,
                            phone: data.lead.phone,
                            email: data.lead.email,
                        } : null,
                        metaLeadId: data?.meta?.lead_id,
                        conversationLeadId: data?.conversation?.lead_id,
                        hasDynamicLeadRow: Boolean(data?.dynamic_lead_row),
                        suggestedLeadCount: Array.isArray(data?.suggested_leads) ? data.suggested_leads.length : null,
                    });
                    this.applyConversationDetailToInteraction(interaction, data);
                    return data;
                })
                .catch(error => {
                    if (!interaction.lead && !interaction.dynamicLeadRow) {
                        interaction.leadLookupStatus = 'failed';
                    }
                    console.warn('[LIVE-LEAD-SYNC] conversation detail fetch FAILED', {
                        conversationId,
                        interactionId: interaction.id,
                        callUuid: interaction.callUuid,
                        error: namespace.safeError(error),
                    });
                    this.debug('Voice conversation detail fetch failed', {
                        conversation_id: conversationId,
                        error: namespace.safeError(error),
                    });
                    return null;
                })
                .finally(() => {
                    this._conversationDetailFetches.delete(conversationId);
                    interaction.previewLeadDetailLoading = false;
                    console.warn('[LIVE-LEAD-SYNC] conversation detail fetch FINALLY render surfaces', {
                        conversationId,
                        interactionId: interaction.id,
                        isActive: this.activeVoiceInteractionId === interaction.id,
                        leadId: interaction.leadId,
                        hasLead: Boolean(interaction.lead),
                        hasDynamicLeadRow: Boolean(interaction.dynamicLeadRow),
                        leadLookupStatus: interaction.leadLookupStatus,
                        displayName: interaction.displayName,
                    });
                    this.renderTrayInteractions();
                    // Stale-response guard: the interaction may have been discarded
                    // while this request was in flight — voiceInteractions membership
                    // is the authoritative "still exists" check (see discardUnansweredOffer()).
                    if (this.activeVoiceInteractionId === interaction.id
                        && this.voiceInteractions.get(interaction.id) === interaction) {
                        this.renderInteraction(interaction);
                        this.renderLeadForInteraction(interaction);
                    }
                });

            this._conversationDetailFetches.set(conversationId, promise);
            return promise;
        }

        applyConversationDetailToInteraction(interaction, data) {
            if (!interaction || !data) {
                console.warn('[LIVE-LEAD-SYNC] apply skipped: missing interaction or data', {
                    hasInteraction: Boolean(interaction),
                    hasData: Boolean(data),
                });
                return;
            }

            const conv = data.conversation || {};
            const snapshotConversationId = data.meta?.conversation_id
                || conv.id
                || interaction.conversationId
                || null;
            interaction.conversationCampaignId = conv.campaign_id
                || data.meta?.campaign_id
                || interaction.conversationCampaignId
                || null;

            console.warn('[LIVE-LEAD-SYNC] apply conversation detail START', {
                interactionId: interaction.id,
                conversationId: interaction.conversationId,
                callUuid: interaction.callUuid,
                incomingLeadId: data.lead?.id || null,
                incomingConversationLeadId: conv.lead_id || null,
                incomingMetaLeadId: data.meta?.lead_id || null,
                hasDynamicLeadRow: Boolean(data.dynamic_lead_row),
                previousLeadId: interaction.leadId,
                previousLookupStatus: interaction.leadLookupStatus,
            });
            console.warn('[LEAD-PANEL-SNAPSHOT] apply backend snapshot', {
                conversationId: snapshotConversationId,
                hasLead: Boolean(data.lead),
                leadId: data.lead?.id || data.meta?.lead_id || conv.lead_id || null,
                hasDynamicLeadRow: Boolean(data.dynamic_lead_row),
                dynamicRowId: data.dynamic_lead_row?.id || null,
                previousLeadId: interaction.leadId || interaction.lead?.id || null,
                previousLeadName: interaction.lead
                    ? [interaction.lead.first_name, interaction.lead.last_name].filter(Boolean).join(' ')
                    : null,
            });

            if (data.lead && !this.isLeadAllowedForInteraction(interaction, data.lead)) {
                console.warn('[LIVE-LEAD-SYNC] ignored cross-campaign backend lead snapshot', {
                    interactionId: interaction.id,
                    conversationId: interaction.conversationId,
                    leadId: data.lead.id || null,
                    leadCampaignId: data.lead.campaign_id || null,
                    expectedCampaignId: this.crmSearchCampaignIdForInteraction(interaction),
                });
                data = { ...data, lead: null };
                conv.lead_id = null;
            }

            if (data.lead) {
                interaction.previewLeadResolutionDeferred = false;
                interaction.previewDynamicRowLocked = false;
                interaction.backendLeadSnapshotLoaded = true;
                interaction.backendLeadSnapshotConversationId = snapshotConversationId;
                if (snapshotConversationId) {
                    this.previewDynamicRowLocks.delete(Number(snapshotConversationId));
                }
                interaction.lead = data.lead;
                interaction.leadId = data.lead.id;
                interaction.displayName = [data.lead.first_name, data.lead.last_name]
                    .filter(Boolean).join(' ') || data.lead.phone || interaction.displayName || interaction.phone;
                interaction.dynamicLeadRow = null;
                interaction.leadList = null;
                interaction.dialerCampaign = data.dialer_campaign || interaction.dialerCampaign || null;
                interaction.crmCampaign = data.campaign || interaction.crmCampaign || null;
                interaction.leadLookupStatus = 'found';
                console.warn('[LIVE-LEAD-SYNC] apply resolved CRM lead', {
                    interactionId: interaction.id,
                    conversationId: interaction.conversationId,
                    leadId: interaction.leadId,
                    displayName: interaction.displayName,
                });
            } else if (data.dynamic_lead_row) {
                interaction.previewLeadResolutionDeferred = false;
                interaction.lead = null;
                interaction.leadId = null;
                interaction.contact = null;
                interaction.resolvedLead = null;
                interaction.crmLead = null;
                interaction.leadLookupResult = null;
                interaction.dynamicLeadRow = data.dynamic_lead_row;
                interaction.leadList = data.lead_list || null;
                interaction.dialerCampaign = data.dialer_campaign || null;
                interaction.crmCampaign = data.campaign || null;
                interaction.suggestedLeads = Array.isArray(data.suggested_leads) ? data.suggested_leads : [];
                interaction.leadLookupStatus = 'dynamic_row';
                interaction.backendLeadSnapshotLoaded = true;
                interaction.backendLeadSnapshotConversationId = snapshotConversationId;
                this.lockPreviewDynamicRow(interaction, snapshotConversationId, data.dynamic_lead_row);
                console.warn('[LIVE-LEAD-SYNC] apply dynamic lead row fallback', {
                    interactionId: interaction.id,
                    conversationId: interaction.conversationId,
                    rowId: data.dynamic_lead_row?.id,
                    phone: data.dynamic_lead_row?.phone,
                });
            } else if (conv.lead_id && !interaction.lead) {
                interaction.previewLeadResolutionDeferred = false;
                interaction.leadId = conv.lead_id;
                interaction.leadLookupStatus = 'lead_pending';
                console.warn('[LIVE-LEAD-SYNC] apply lead pending without lead payload', {
                    interactionId: interaction.id,
                    conversationId: interaction.conversationId,
                    leadId: interaction.leadId,
                });
            } else if (interaction.isPreviewDialer && !interaction.previewConversationLinked && !interaction.lead && !interaction.dynamicLeadRow) {
                interaction.previewLeadResolutionDeferred = true;
                interaction.leadLookupStatus = 'loading';
                console.warn('[LIVE-LEAD-SYNC] apply deferred no-lead snapshot before Preview offer link', {
                    interactionId: interaction.id,
                    conversationId: interaction.conversationId,
                    callUuid: interaction.callUuid,
                });
            } else if (!interaction.lead && !interaction.dynamicLeadRow) {
                interaction.previewLeadResolutionDeferred = false;
                interaction.leadLookupStatus = 'not_found';
                console.warn('[LIVE-LEAD-SYNC] apply no lead found', {
                    interactionId: interaction.id,
                    conversationId: interaction.conversationId,
                    suggestedLeadCount: Array.isArray(data.suggested_leads) ? data.suggested_leads.length : null,
                });
            }

            if (Array.isArray(data.dispositions)) {
                interaction.dispositions = data.dispositions;
                interaction.dispositionsLoaded = true;
                interaction.dispositionsLoading = false;
            }

            if (data.script && !interaction.scriptData) {
                interaction.scriptData = data.script;
                interaction.scriptSource = data.script_source;
            }

            if (data.voice_call && (!interaction.events || interaction.events.length === 0)) {
                interaction.events = this._buildTimelineFromBackend(data.voice_call);
            }
            if (data.voice_call) {
                interaction.ringingAt = data.voice_call.ringing_at ? new Date(data.voice_call.ringing_at) : interaction.ringingAt;
                interaction.connectedAt = data.voice_call.answered_at ? new Date(data.voice_call.answered_at) : interaction.connectedAt;
                interaction.endedAt = data.voice_call.ended_at ? new Date(data.voice_call.ended_at) : interaction.endedAt;
                interaction.durationSeconds = data.voice_call.duration_seconds ?? interaction.durationSeconds;
                interaction.talkSeconds = data.voice_call.talk_seconds ?? interaction.talkSeconds;
                interaction.backendAnsweredAt = data.voice_call.answered_at || interaction.backendAnsweredAt || null;
                interaction.backendEndedAt = data.voice_call.ended_at || interaction.backendEndedAt || null;
                interaction.queueId = data.meta?.queue_id || interaction.queueId || null;
                interaction.crmCampaign = data.campaign || interaction.crmCampaign || null;
            }
            if (data.voice_call?.ani_normalized) {
                interaction.aniNormalized = data.voice_call.ani_normalized;
            }
            if (data.voice_call?.dnis_normalized) {
                interaction.dnisNormalized = data.voice_call.dnis_normalized;
            }
            const detailPrimaryPhone = interaction.direction === 'outbound'
                ? (data.voice_call?.dnis_normalized || data.voice_call?.remote_number)
                : (data.voice_call?.ani_normalized || data.voice_call?.remote_number);
            if (detailPrimaryPhone) {
                interaction.normalizedPhone = detailPrimaryPhone;
                interaction.displayPhone = this.normalizeNanpPhone(interaction.normalizedPhone)
                    || interaction.displayPhone
                    || interaction.normalizedPhone;
                if (!interaction.lead) {
                    interaction.displayName = interaction.displayPhone;
                }
            }
        }

        /**
         * Start or join the lead lookup for an interaction (background, one entry point).
         *
         * Called once from selectInteraction() when a conversation is selected.
         * The button click only controls visibility — it never starts a fresh lookup.
         *
         * - found / not_found / failed: already settled, no-op
         * - loading: joins the in-flight promise
         * - idle: starts a new lookup via resolveLeadForInteraction()
         *
         * Never calls renderInteraction(). If the panel is open at completion,
         * resolveLeadForInteraction().finally handles the panel update.
         */
        ensureLeadLoadedForInteraction(interaction) {
            if (!interaction) return Promise.resolve(null);

            if (this.isPreviewDynamicRowLocked(interaction)) {
                return Promise.resolve(null);
            }
            if (this.isPreviewDynamicContextPending(interaction)) {
                interaction.leadLookupStatus = 'loading';
                return this.fetchPersistedConversationDetail(interaction);
            }
            if (interaction.lead) {
                interaction.leadLookupStatus = 'found';
                return Promise.resolve(interaction.lead);
            }
            if (interaction.leadId && !interaction.lead) {
                interaction.leadLookupStatus = 'lead_pending';
                return Promise.resolve(null);
            }
            if (interaction.dynamicLeadRow) {
                interaction.leadLookupStatus = 'dynamic_row';
                return Promise.resolve(null);
            }
            if (['found', 'not_found', 'failed', 'dynamic_row'].includes(interaction.leadLookupStatus)) {
                return Promise.resolve(interaction.lead);
            }
            if (interaction.leadLookupStatus === 'loading' && interaction.leadLookupPromise) {
                return interaction.leadLookupPromise;
            }
            // idle → start lookup
            return this.resolveLeadForInteraction(interaction);
        }

        /**
         * Public entry point called by toggleLeadPanel() when opening for Voice.
         * Resolves the currently active interaction dynamically — no stale closures.
         */
        renderLeadForActiveInteraction() {
            const id = this.activeVoiceInteractionId;
            if (!id) return;
            const interaction = this.voiceInteractions.get(id);
            if (interaction) this.renderLeadForInteraction(interaction);
        }

        /**
         * Render the LeadPanel for a specific Voice interaction.
         *
         * Guards:
         *   – panel must be open (leadPanelOpen)
         *   – interaction must be the currently active one
         *
         * States (rule 4 from spec):
         *   found     → render lead immediately
         *   not_found → render empty form immediately
         *   failed    → render recoverable error
         *   loading   → show skeleton, lookup already in flight
         *   idle      → show skeleton, start lookup now
         *
         * Rule 5: if data arrives while panel is closed, only update memory.
         * The next open will show the latest state.
         */
        renderLeadForInteraction(interaction) {
            if (!interaction
                || this.activeVoiceInteractionId !== interaction.id
                || !window.LeadPanel
                || !window.isLeadPanelOpen?.()) {
                // Panel closed or not active — update memory only, no DOM changes.
                return;
            }

            const panel = document.getElementById('leadPanel');
            if (!panel) return;

            // conversationId is the numeric DB id for all server calls.
            // interaction.id ('voice-local-*') is never sent to the server.
            const contextId  = interaction.conversationId || interaction.id;
            const canPersist = Boolean(interaction.conversationId);
            const context    = {
                id:            contextId,
                channel:       'voice',
                contact_phone: this.normalizeNanpPhone(interaction.normalizedPhone || interaction.phone),
                contact_email: null,
                campaign_id:   this.crmSearchCampaignIdForInteraction(interaction),
            };

            if (this.isPreviewDynamicRowLocked(interaction)
                && interaction.dynamicLeadRow
                && window.LeadPanel.renderDynamicLeadRow) {
                console.warn('[LEAD-PANEL-SNAPSHOT] render choice', {
                    conversationId: interaction.conversationId || null,
                    choice: 'dynamic_row',
                    leadId: interaction.leadId || interaction.lead?.id || null,
                    dynamicRowId: interaction.dynamicLeadRow?.id || null,
                    previewDynamicRowLocked: true,
                });
                interaction.lead = null;
                interaction.leadId = null;
                interaction.leadLookupStatus = 'dynamic_row';
                window.LeadPanel.renderDynamicLeadRow(context, {
                    dynamic_lead_row: interaction.dynamicLeadRow,
                    lead_list: interaction.leadList || null,
                    dialer_campaign: interaction.dialerCampaign || null,
                    campaign: interaction.crmCampaign || null,
                });
                return;
            }

            if (interaction.lead) {
                if (!this.isLeadAllowedForInteraction(interaction, interaction.lead)) {
                    console.warn('[LEAD-PANEL-SNAPSHOT] render blocked cross-campaign CRM lead', {
                        conversationId: interaction.conversationId || null,
                        leadId: interaction.lead?.id || interaction.leadId || null,
                        leadCampaignId: interaction.lead?.campaign_id || null,
                        expectedCampaignId: this.crmSearchCampaignIdForInteraction(interaction),
                    });
                    interaction.lead = null;
                    interaction.leadId = null;
                    interaction.leadLookupStatus = 'not_found';
                    window.LeadPanel.renderEmpty(context, { canPersist });
                    return;
                }
                console.warn('[LEAD-PANEL-SNAPSHOT] render choice', {
                    conversationId: interaction.conversationId || null,
                    choice: 'crm_lead',
                    leadId: interaction.lead?.id || interaction.leadId || null,
                    dynamicRowId: interaction.dynamicLeadRow?.id || null,
                });
                interaction.leadLookupStatus = 'found';
                window.LeadPanel.render(context, interaction.lead, { showAssociate: canPersist });
                return;
            }

            if (interaction.leadId && !interaction.lead) {
                console.warn('[LEAD-PANEL-SNAPSHOT] render choice', {
                    conversationId: interaction.conversationId || null,
                    choice: 'skeleton',
                    leadId: interaction.leadId || null,
                    dynamicRowId: interaction.dynamicLeadRow?.id || null,
                });
                interaction.leadLookupStatus = 'lead_pending';
                this._showLeadPanelSkeleton();
                return;
            }

            if (this.isPreviewLeadResolutionPending(interaction)) {
                console.warn('[LEAD-PANEL-SNAPSHOT] render choice', {
                    conversationId: interaction.conversationId || null,
                    choice: 'skeleton',
                    leadId: interaction.leadId || interaction.lead?.id || null,
                    dynamicRowId: interaction.dynamicLeadRow?.id || null,
                });
                interaction.leadLookupStatus = 'loading';
                this._showLeadPanelSkeleton();
                return;
            }

            if (!interaction.lead && interaction.dynamicLeadRow && window.LeadPanel.renderDynamicLeadRow) {
                console.warn('[LEAD-PANEL-SNAPSHOT] render choice', {
                    conversationId: interaction.conversationId || null,
                    choice: 'dynamic_row',
                    leadId: null,
                    dynamicRowId: interaction.dynamicLeadRow?.id || null,
                });
                interaction.leadLookupStatus = 'dynamic_row';
                window.LeadPanel.renderDynamicLeadRow(context, {
                    dynamic_lead_row: interaction.dynamicLeadRow,
                    lead_list: interaction.leadList || null,
                    dialer_campaign: interaction.dialerCampaign || null,
                    campaign: interaction.crmCampaign || null,
                });
                return;
            }

            switch (interaction.leadLookupStatus) {
                case 'found':
                    if (interaction.lead) {
                        window.LeadPanel.render(context, interaction.lead, { showAssociate: canPersist });
                    } else if (interaction.leadId) {
                        this._showLeadPanelSkeleton();
                    } else {
                        this._showLeadPanelSkeleton();
                        this.resolveLeadForInteraction(interaction, true);
                    }
                    break;

                case 'lead_pending':
                    console.warn('[LEAD-PANEL-SNAPSHOT] render choice', {
                        conversationId: interaction.conversationId || null,
                        choice: 'skeleton',
                        leadId: interaction.leadId || null,
                        dynamicRowId: interaction.dynamicLeadRow?.id || null,
                    });
                    this._showLeadPanelSkeleton();
                    break;

                case 'dynamic_row':
                    if (interaction.dynamicLeadRow && window.LeadPanel.renderDynamicLeadRow) {
                        console.warn('[LEAD-PANEL-SNAPSHOT] render choice', {
                            conversationId: interaction.conversationId || null,
                            choice: 'dynamic_row',
                            leadId: interaction.leadId || interaction.lead?.id || null,
                            dynamicRowId: interaction.dynamicLeadRow?.id || null,
                        });
                        window.LeadPanel.renderDynamicLeadRow(context, {
                            dynamic_lead_row: interaction.dynamicLeadRow,
                            lead_list: interaction.leadList || null,
                            dialer_campaign: interaction.dialerCampaign || null,
                            campaign: interaction.crmCampaign || null,
                        });
                    } else {
                        console.warn('[LEAD-PANEL-SNAPSHOT] render choice', {
                            conversationId: interaction.conversationId || null,
                            choice: 'cold',
                            leadId: null,
                            dynamicRowId: null,
                        });
                        window.LeadPanel.renderEmpty(context, { canPersist });
                    }
                    break;

                case 'not_found':
                    console.warn('[LEAD-PANEL-SNAPSHOT] render choice', {
                        conversationId: interaction.conversationId || null,
                        choice: 'cold',
                        leadId: null,
                        dynamicRowId: null,
                    });
                    window.LeadPanel.renderEmpty(context, { canPersist });
                    break;

                case 'failed':
                    console.warn('[LEAD-PANEL-SNAPSHOT] render choice', {
                        conversationId: interaction.conversationId || null,
                        choice: 'cold',
                        leadId: null,
                        dynamicRowId: interaction.dynamicLeadRow?.id || null,
                    });
                    window.LeadPanel.renderEmpty(context, {
                        canPersist,
                        lookupFailed: true,
                        retryInteractionId: interaction.id,
                    });
                    break;

                case 'loading':
                    console.warn('[LEAD-PANEL-SNAPSHOT] render choice', {
                        conversationId: interaction.conversationId || null,
                        choice: 'skeleton',
                        leadId: interaction.leadId || interaction.lead?.id || null,
                        dynamicRowId: interaction.dynamicLeadRow?.id || null,
                    });
                    // Lookup in progress — show skeleton, do not start another lookup
                    this._showLeadPanelSkeleton();
                    break;

                case 'idle':
                default:
                    console.warn('[LEAD-PANEL-SNAPSHOT] render choice', {
                        conversationId: interaction.conversationId || null,
                        choice: 'skeleton',
                        leadId: interaction.leadId || interaction.lead?.id || null,
                        dynamicRowId: interaction.dynamicLeadRow?.id || null,
                    });
                    // Panel just opened before any lookup — show skeleton and start lookup
                    this._showLeadPanelSkeleton();
                    this.resolveLeadForInteraction(interaction);
                    break;
            }
        }

        isPreviewLeadResolutionPending(interaction) {
            if (!interaction?.isPreviewDialer || !interaction.conversationId) {
                return false;
            }

            const conversationId = Number(interaction.conversationId);

            return !interaction.lead
                && !interaction.dynamicLeadRow
                && (
                    interaction.previewConversationLinked === false
                    || interaction.previewLeadDetailLoading === true
                    || interaction.previewLeadResolutionDeferred === true
                    || this._conversationDetailFetches.has(conversationId)
                );
        }

        _showLeadPanelSkeleton() {
            const panel = document.getElementById('leadPanel');
            if (!panel) return;
            // Reuse the same skeleton structure as openConversation() for consistency.
            panel.innerHTML = `
            <div style="padding:14px;display:flex;flex-direction:column;gap:0;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
                    <div class="sk" style="width:42px;height:42px;border-radius:50%;flex-shrink:0;"></div>
                    <div style="flex:1;display:flex;flex-direction:column;gap:7px;">
                        <div class="sk" style="height:13px;width:58%;"></div>
                        <div class="sk" style="height:10px;width:36%;"></div>
                    </div>
                </div>
                ${['42%','65%','78%','52%','70%','38%'].map(w => `
                <div style="display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--border-light);">
                    <div class="sk" style="width:68px;height:9px;flex-shrink:0;"></div>
                    <div class="sk" style="height:9px;width:${w};"></div>
                </div>`).join('')}
            </div>`;
        }

        interactionDisplayName(interaction) {
            const lead = interaction.lead;
            const name = lead
                ? [lead.first_name, lead.last_name].filter(Boolean).join(' ')
                : '';
            return name
                || this.voiceDisplayPhone(interaction)
                || interaction.displayName
                || interaction.phone;
        }

        voiceDisplayPhone(interaction) {
            return this.normalizeNanpPhone(
                this.voicePrimaryNumber(interaction)
                    || interaction?.normalizedPhone
                    || interaction?.phone
                    || interaction?.displayPhone
                    || ''
            );
        }

        voicePrimaryNumber(interaction) {
            if (interaction?.direction === 'outbound') {
                return interaction?.dnisNormalized
                    || interaction?.remoteNumber
                    || interaction?.normalizedPhone
                    || interaction?.phone
                    || '';
            }

            return interaction?.normalizedPhone
                || interaction?.aniNormalized
                || interaction?.phone
                || interaction?.displayPhone
                || '';
        }

        voiceAniDisplay(interaction) {
            return this.normalizeNanpPhone(
                interaction?.aniNormalized
                    || interaction?.acdMetadata?.ani
                    || interaction?.ani
                    || (interaction?.direction === 'outbound' ? '' : interaction?.normalizedPhone)
                    || ''
            );
        }

        voiceDnisDisplay(interaction) {
            return this.normalizeNanpPhone(
                interaction?.dnisNormalized
                    || interaction?.acdMetadata?.dnis
                    || interaction?.dnis
                    || (interaction?.direction === 'outbound' ? interaction?.normalizedPhone : '')
                    || ''
            );
        }

        voiceDirectionLabel(interaction) {
            return interaction?.direction === 'inbound' ? 'Inbound' : 'Outbound';
        }

        voiceQueueDisplayName(interaction) {
            const queueId = interaction?.queueId || interaction?.queue_id;
            const queueMap = this.config?.queueDisplayNames || {};
            return interaction?.queueDisplayName
                || (queueId ? queueMap[String(queueId)] || queueMap[queueId] : null)
                || interaction?.queueName
                || interaction?.omniQueueName
                || '—';
        }

        voiceInternalQueueName(interaction) {
            return interaction?.internalQueueName
                || interaction?.asteriskQueueName
                || interaction?.acdMetadata?.queue_name
                || '—';
        }

        voiceCampaignName(interaction) {
            const campaignId = interaction?.conversationCampaignId || interaction?.campaignId || interaction?.campaign_id;
            const campaignMap = this.config?.campaignDisplayNames || {};
            const campaignName = interaction?.crmCampaign?.name
                || interaction?.campaignName
                || interaction?.campaignDisplayName
                || (campaignId ? campaignMap[String(campaignId)] || campaignMap[campaignId] : null)
                || null;
            return campaignName && String(campaignName).toLowerCase() !== 'voice'
                ? campaignName
                : '—';
        }

        secondsToClock(seconds) {
            const total = Math.max(0, Number(seconds || 0));
            const minutes = Math.floor(total / 60);
            const secs = total % 60;
            return `${String(minutes).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
        }

        voiceDate(value) {
            if (!value) return null;
            if (value instanceof Date) return Number.isNaN(value.getTime()) ? null : value;
            const parsed = new Date(value);
            return Number.isNaN(parsed.getTime()) ? null : parsed;
        }

        secondsBetween(start, end) {
            const from = this.voiceDate(start);
            const to = this.voiceDate(end);
            if (!from || !to) return null;
            return Math.max(0, Math.floor((to - from) / 1000));
        }

        voiceRingTimeText(interaction) {
            const seconds = this.secondsBetween(
                interaction?.ringingAt || interaction?.createdAt,
                interaction?.connectedAt || interaction?.backendAnsweredAt
            );
            return seconds === null ? '00:00' : this.secondsToClock(seconds);
        }

        voiceDurationText(interaction) {
            if (interaction?.durationSeconds !== undefined && interaction.durationSeconds !== null) {
                return this.secondsToClock(interaction.durationSeconds);
            }
            const seconds = this.secondsBetween(
                interaction?.ringingAt || interaction?.createdAt,
                interaction?.endedAt || interaction?.backendEndedAt
            );
            if (seconds !== null) {
                return this.secondsToClock(seconds);
            }
            return '00:00';
        }

        voiceTalkTimeText(interaction) {
            if (interaction?.talkSeconds !== undefined && interaction.talkSeconds !== null) {
                return this.secondsToClock(interaction.talkSeconds);
            }
            const seconds = this.secondsBetween(
                interaction?.connectedAt || interaction?.backendAnsweredAt,
                interaction?.endedAt || interaction?.backendEndedAt || (interaction?.connectedAt ? new Date() : null)
            );
            if (seconds !== null) {
                return this.secondsToClock(seconds);
            }
            return '00:00';
        }

        voiceStatusClass(status) {
            const normalized = String(status || '').toLowerCase();
            if (['ringing', 'connecting'].includes(normalized)) return 'is-blue';
            if (['in call', 'connected', 'active'].includes(normalized)) return 'is-green';
            if (['on hold', 'holding', 'held'].includes(normalized)) return 'is-orange';
            if (['failed', 'rejected', 'missed', 'busy', 'no answer', 'congestion', 'unavailable', 'cancelled'].includes(normalized)) return 'is-red';
            if (['ended', 'completed'].includes(normalized)) return 'is-gray';
            return 'is-gray';
        }

        _voiceInfoItem(label, value, valueClass = '') {
            return `
                <div class="voice-info-item">
                    <div class="voice-info-label">${this.escape(label)}</div>
                    <div class="voice-info-value ${this.escape(valueClass)}">${this.escape(value || '—')}</div>
                </div>`;
        }

        _renderVoiceSummaryCard(interaction, displayStatus) {
            const direction = this.voiceDirectionLabel(interaction);
            return `
                <section class="voice-summary-card">
                    <div class="voice-summary-main">
                        <div class="voice-summary-icon"><i class="bi bi-telephone-inbound-fill"></i></div>
                        <div class="voice-summary-copy">
                            <div class="voice-summary-number-row">
                                <div class="voice-summary-number">${this.escape(this.voiceDisplayPhone(interaction) || '—')}</div>
                                <span class="voice-direction-badge">${this.escape(direction)}</span>
                            </div>
                            <div class="voice-summary-subtitle">${this.escape(direction)} · ${this.escape(this.voiceQueueDisplayName(interaction))} · ${this.escape(this.voiceCampaignName(interaction))}</div>
                        </div>
                    </div>
                    <div class="voice-summary-metrics">
                        ${this._voiceInfoItem('STATUS', displayStatus, `voice-status-badge ${this.voiceStatusClass(displayStatus)}`)}
                        ${this._voiceInfoItem('RING TIME', this.voiceRingTimeText(interaction))}
                        ${this._voiceInfoItem('TALK TIME', this.voiceTalkTimeText(interaction))}
                        ${this._voiceInfoItem('CALL DURATION', this.voiceDurationText(interaction))}
                    </div>
                </section>`;
        }

        _renderVoiceCallInformation(interaction) {
            return `
                <section class="voice-business-card">
                    <h3>CALL INFORMATION</h3>
                    <div class="voice-info-grid">
                        ${this._voiceInfoItem('ANI', this.voiceAniDisplay(interaction))}
                        ${this._voiceInfoItem('DNIS', this.voiceDnisDisplay(interaction))}
                        ${this._voiceInfoItem('Queue', this.voiceQueueDisplayName(interaction))}
                        ${this._voiceInfoItem('Campaign', this.voiceCampaignName(interaction))}
                        ${this._voiceInfoItem('Direction', this.voiceDirectionLabel(interaction))}
                    </div>
                </section>`;
        }

        _renderVoiceTimelinePanel(timelineContent) {
            return `
                <section class="voice-business-card">
                    <h3>CALL TIMELINE</h3>
                    <div class="voice-timeline">
                        ${timelineContent}
                    </div>
                </section>`;
        }

        _renderVoiceTechnicalDetails(interaction) {
            const voiceSessionId = interaction?.voiceSessionId || interaction?.voice_session_id || null;
            return `
                <details class="voice-technical-details">
                    <summary>Technical Details</summary>
                    <div class="voice-info-grid voice-technical-grid">
                        ${this._voiceInfoItem('LinkedID', this.linkedidForInteraction(interaction) || '—')}
                        ${this._voiceInfoItem('SIP Call-ID', interaction?.sipCallId || interaction?.acdMetadata?.sip_call_id || '—')}
                        ${this._voiceInfoItem('Internal Queue', this.voiceInternalQueueName(interaction))}
                        ${this._voiceInfoItem('Conversation ID', interaction?.conversationId || '—')}
                        ${this._voiceInfoItem('Voice Call ID', interaction?.voiceCallId || '—')}
                        ${voiceSessionId ? this._voiceInfoItem('Voice Session ID', voiceSessionId) : ''}
                    </div>
                </details>`;
        }

        syncPanelControls() {
            if (!this.manager) return;
            const call = this.manager.callManager.snapshot();
            const established = call.confirmed && Boolean(call.session);
            const mute   = document.getElementById('voiceQaMute');
            const hold   = document.getElementById('voiceQaHold');
            const hangup = document.getElementById('voiceQaHangup');
            const answer = document.getElementById('voiceQaAnswer');
            const reject = document.getElementById('voiceQaReject');
            const interaction = this.voiceInteractions.get(
                this.currentInteractionId
            );
            const incomingPending = call.inboundPending
                && interaction?.direction === 'inbound'
                && interaction?.status === 'Ringing';

            // answer / reject — optional (only present during Ringing)
            if (answer) {
                answer.disabled = !incomingPending
                    || Boolean(interaction?.answerPending)
                    || Boolean(interaction?.rejectPending);
            }
            if (reject) {
                reject.disabled = !incomingPending
                    || Boolean(interaction?.answerPending)
                    || Boolean(interaction?.rejectPending);
            }

            // mute / hold / hangup — optional (only present when In Call / On Hold)
            // Icon elements always exist; <span> elements do NOT exist in icon-only layout.
            // Classify: <i> = obligatory within the button; <span> = legacy/optional.
            if (mute) {
                mute.disabled = !established || Boolean(call.mutePending);
                mute.classList.toggle('is-active', Boolean(call.muted));
                const muteIcon = mute.querySelector('i');
                if (muteIcon) {
                    muteIcon.className = call.muted ? 'bi bi-mic-fill' : 'bi bi-mic-mute-fill';
                }
                // <span> is absent in icon-only layout — safe no-op
                const muteLabel = mute.querySelector('span');
                if (muteLabel) muteLabel.textContent = call.muted ? 'Unmute' : 'Mute';
                // Update tooltip for screen readers / hover
                mute.title = call.muted ? 'Unmute' : 'Mute';
            }
            if (hold) {
                hold.disabled = !established || Boolean(call.holdPending);
                hold.classList.toggle('is-active', Boolean(call.onHold));
                const holdIcon = hold.querySelector('i');
                if (holdIcon) {
                    holdIcon.className = call.onHold ? 'bi bi-play-circle-fill' : 'bi bi-pause-circle-fill';
                }
                // <span> is absent in icon-only layout — safe no-op
                const holdLabel = hold.querySelector('span');
                if (holdLabel) holdLabel.textContent = call.onHold ? 'Resume' : 'Hold';
                hold.title = call.onHold ? 'Resume' : 'Hold';
            }
            if (hangup) {
                hangup.disabled = !call.session;
            }
        }

        runCallAction(action) {
            try {
                action();
            } catch (error) {
                this.notify(namespace.safeError(error), 'error');
            }
        }

        renderTrayInteractions() {
            const list = this.ensureConversationList();
            if (!list) return;
            list.querySelectorAll('.voice-local-card').forEach(card => {
                const id = card.dataset.voiceId;
                if (!this.voiceInteractions.has(id)) card.remove();
            });
            Array.from(this.voiceInteractions.values()).reverse()
                .forEach(interaction => {
                    let card = list.querySelector(
                        `.voice-local-card[data-voice-id="${interaction.id}"]`
                    );
                    if (!card) {
                        card = document.createElement('div');
                        card.className = 'conv-item voice voice-local-card';
                        card.dataset.voiceId = interaction.id;
                        card.style.cssText = 'padding:12px 14px;border-bottom:1px solid var(--bg-stripe);cursor:pointer;display:flex;gap:10px;align-items:flex-start;';
                        card.addEventListener('click', () =>
                            this.selectInteraction(interaction.id)
                        );
                        list.prepend(card);
                    }
                    card.classList.toggle(
                        'selected',
                        interaction.id === this.activeVoiceInteractionId
                    );
                    // Render using the same layout structure as the generic conv-item
                    // (Email/Facebook/WhatsApp) so Voice looks identical to other channels.
                    const displayName  = this.interactionDisplayName(interaction)
                        || interaction.displayName
                        || interaction.phone;
                    const hasLead     = Boolean(interaction.lead || interaction.leadId);
                    const callStatus  = this.effectiveInteractionStatus(interaction);
                    // Always compute relative time from the real Date stored on the
                    // interaction — never use the static 'now' string.
                    const waitSince   = this._relativeTime(
                        interaction._waitSinceAt || interaction.createdAt
                    );
                    const isTerminal  = this.isTerminalVisualStatus(callStatus);
                    const terminalNeedsWrapUpBadge = isTerminal
                        && this.interactionWasAnswered(interaction);
                    const isWrapUp    = Boolean(interaction.conversationId)
                        && (terminalNeedsWrapUpBadge || (interaction.wrapUpPending === true && this.interactionWasAnswered(interaction))
                            || (interaction.previewRecoveryStatus === 'recovered' && this.interactionWasAnswered(interaction)));
                    const noLeadBadge = !hasLead
                        ? '<span class="badge badge-warning no-lead-badge" style="font-size:10px;">NO LEAD</span>'
                        : '';
                    const wrapUpBadge = isWrapUp
                        ? '<span class="badge" style="font-size:10px;background:#fef3c7;color:#92400e;border:1px solid #fde68a;">WRAP-UP</span>'
                        : '';
                    const isRinging   = callStatus === 'Ringing';
                    card.innerHTML = `
                        <div style="width:36px;height:36px;border-radius:10px;background:#eaf3de;color:#3b6d11;font-size:16px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="bi ${interaction.direction === 'inbound' ? 'bi-telephone-inbound-fill' : 'bi-telephone-outbound-fill'}"></i>
                        </div>
                        <div style="flex:1;min-width:0;">
                            <div style="display:flex;justify-content:space-between;align-items:center;">
                                <span style="font-size:13px;font-weight:600;color:var(--text-strong);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:140px;">${this.escape(displayName)}</span>
                                <span class="conv-time" style="font-size:11px;color:var(--text-muted);flex-shrink:0;">${this.escape(waitSince)}</span>
                            </div>
                            <div class="conv-preview" style="font-size:11px;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px;">
                                Voice &middot; ${this.escape(callStatus)}
                            </div>
                            <div style="display:flex;gap:4px;margin-top:4px;flex-wrap:wrap;">
                                ${this.voiceChannelBadge()}
                                ${noLeadBadge}
                                ${wrapUpBadge}
                            </div>
                        </div>
                        ${isRinging ? '<span class="unread-dot" aria-label="New incoming voice interaction" style="width:8px;height:8px;border-radius:50%;background:var(--danger);flex-shrink:0;margin-top:4px;"></span>' : ''}`;
                });
        }

        ensureConversationList() {
            const list = document.getElementById('conversationList');
            const grid = document.getElementById('consoleGrid');
            if (!list || !grid) return null;
            if (list.parentElement === grid) {
                list.style.cssText = 'display:block;width:280px;flex-shrink:0;overflow-y:auto;border-right:1px solid var(--border);background:var(--bg-card);';
                grid.insertBefore(list, document.getElementById('messagePanel'));
            }
            return list;
        }

        observeTray() {
            const list = document.getElementById('conversationList');
            if (!list || typeof window.MutationObserver === 'undefined') return;
            let scheduled = false;
            this.trayObserver = new window.MutationObserver(() => {
                if (scheduled) return;
                scheduled = true;
                window.queueMicrotask(() => {
                    scheduled = false;
                    this.renderTrayInteractions();
                });
            });
            this.trayObserver.observe(list, { childList: true });
        }

        startDurationTimer() {
            this.stopDurationTimer();
            this.durationTimer = window.setInterval(() => {
                const interaction = this.voiceInteractions.get(
                    this.activeVoiceInteractionId
                );
                const element = document.getElementById(
                    'voiceQaCallDuration'
                );
                if (interaction && element) {
                    element.textContent = this.durationText(interaction);
                }
            }, 1000);
        }

        stopDurationTimer() {
            if (this.durationTimer !== null) {
                window.clearInterval(this.durationTimer);
                this.durationTimer = null;
            }
        }

        durationText(interaction) {
            if (!interaction.connectedAt) return '00:00';
            const end = interaction.endedAt || new Date();
            const seconds = Math.max(0, Math.floor(
                (end - interaction.connectedAt) / 1000
            ));
            return `${String(Math.floor(seconds / 60)).padStart(2, '0')}:${String(seconds % 60).padStart(2, '0')}`;
        }

        setMakeCallEnabled(enabled) {
            const action = document.getElementById('voiceMakeCallAction');
            if (!action) return;
            const usable = enabled
                && this.manager?.isReady()
                && !this.manager.callManager.currentSession;
            action.setAttribute('aria-disabled', String(!usable));
            action.style.opacity = usable ? '1' : '.45';
            action.style.cursor = usable ? 'pointer' : 'not-allowed';
        }

        handleAgentStatusChanged(status) {
            this.localStatusOverride = null;
            this.setMakeCallEnabled(this.manager?.isReady() || false);
            this.syncInboundPolicy(`agent-status:${status || this.agentStatus()}`);
            // Phase 1E-B3: a requested-status change (e.g. selecting Paused mid-call)
            // must not override an in-progress Ringing/In Call/Wrap-Up. Reasserts the
            // overlay if Voice work is still active; otherwise this is a no-op and the
            // header keeps whatever blade just painted for the new requested status.
            this.recomputeEffectiveVoiceStatusOverlay();
        }

        handleAgentStatusRequested(status) {
            if (!['offline', 'paused'].includes(status)) return;
            this.manager?.callManager?.setInboundAllowed(false);
            this.debug('Inbound policy updated', {
                ...this.inboundDebugContext(`agent-status-request:${status}`),
                allowed: false,
            });
        }

        syncInboundPolicy(source) {
            const callManager = this.manager?.callManager;
            if (!callManager?.setInboundAllowed) return false;

            const allowed = Boolean(
                this.manager.isReady()
                && this.agentStatus() === 'ready'
                && this.manager.ownershipState === 'same_tab'
                && this.manager.backendRegistered
                && this.manager.phase === 'voice-ready'
                && !this.voiceUnavailable
                && !callManager.currentSession
            );
            const changed = callManager.allowInbound !== allowed;
            callManager.setInboundAllowed(allowed);

            if (changed) {
                this.debug('Inbound policy updated', {
                    ...this.inboundDebugContext(source),
                    allowed,
                });
            }
            return allowed;
        }

        inboundDebugContext(source) {
            const callManager = this.manager?.callManager;
            return {
                agent_status: this.agentStatus(),
                voice_ready: this.manager?.isReady() || false,
                ownership: this.manager?.ownershipState || null,
                aggregate_call_state:
                    callManager?.aggregateCallState?.() || 'no_call',
                active_sessions: callManager?.sessionCallStates?.size || 0,
                source,
            };
        }

        agentStatus() {
            if (this.localStatusOverride) {
                return this.localStatusOverride;
            }

            return typeof window.getAgentConsoleStatus === 'function'
                ? window.getAgentConsoleStatus()
                : 'offline';
        }

        captureStatusVisual() {
            if (typeof window.captureAgentStatusVisualState === 'function') {
                return window.captureAgentStatusVisualState();
            }

            return {
                label: document.getElementById('statusLabel')?.textContent,
                dot: document.getElementById('statusDot')?.style.background,
            };
        }

        restoreStatusVisual(previous) {
            if (typeof window.rollbackAgentStatusVisual === 'function') {
                window.rollbackAgentStatusVisual(previous);
                return;
            }

            const label = document.getElementById('statusLabel');
            const dot = document.getElementById('statusDot');
            if (label && previous.label) label.textContent = previous.label;
            if (dot && previous.dot) dot.style.background = previous.dot;
        }

        applyOptimisticReadyVisual() {
            if (typeof window.applyOptimisticAgentReadyVisual === 'function') {
                window.applyOptimisticAgentReadyVisual();
                return;
            }

            const label = document.getElementById('statusLabel');
            const dot = document.getElementById('statusDot');
            if (label) label.textContent = 'Ready';
            if (dot) dot.style.background = '#22c55e';
        }

        performanceNow() {
            return window.performance?.now
                ? window.performance.now()
                : Date.now();
        }

        debugReadyPerformance(detail) {
            const round = value => value === null || value === undefined
                ? null
                : Math.round(value * 100) / 100;
            this.debug('Agent Ready performance', {
                ready_click_to_mic_ms: detail.microphoneCompletedAt === null
                    ? null
                    : round(detail.microphoneCompletedAt - detail.operationStartedAt),
                ready_mic_to_visual_ms: detail.visualAppliedAt === null
                    || detail.microphoneCompletedAt === null
                    ? null
                    : round(detail.visualAppliedAt - detail.microphoneCompletedAt),
                ready_backend_request_ms: detail.backendStartedAt === null
                    ? null
                    : round(detail.completedAt - detail.backendStartedAt),
                ready_click_to_visual_ms: detail.visualAppliedAt === null
                    ? null
                    : round(detail.visualAppliedAt - detail.operationStartedAt),
                ready_click_to_confirmed_ms: round(
                    detail.completedAt - detail.operationStartedAt
                ),
                microphone_permission_state:
                    detail.microphoneResult.permissionState,
                microphone_preflight_cached:
                    Boolean(detail.microphoneResult.cached),
                microphone_preflight_trigger:
                    detail.microphoneResult.trigger || 'ready_click',
                microphone_preflight_total_ms: round(
                    detail.microphoneResult.totalMs
                ),
                microphone_preflight_remaining_on_ready_ms: round(
                    detail.preflightRemainingOnReadyMs
                ),
                microphone_preflight_reused: Boolean(
                    detail.preflightReused
                ),
                outcome: detail.outcome,
            });
        }

        markVoiceUnavailable(error) {
            this.voiceUnavailable = true;
            this.syncInboundPolicy('voice-unavailable');
            this.setMakeCallEnabled(false);
            this.syncReadyControl(false, true);
            this.setStatusSelectorEnabled(false);
            this.debug('Voice unavailable', {
                message: namespace.safeError(error),
            });
            // Signal Preview that boot ended in a non-operable state.
            this._signalPreviewBoot(false, this.ownershipResolved);
        }

        _signalPreviewBoot(voiceReady, voiceOwned) {
            if (this._previewBootSignaled) return;
            this._previewBootSignaled = true;
            window.PreviewDialerAgent?.onConsoleReadinessChanged?.({
                agentStatus: window.getAgentConsoleStatus?.() ?? 'offline',
                voiceRegistered: Boolean(voiceReady),
                voiceSessionOwned: Boolean(voiceOwned),
                bootComplete: true,
            });
        }

        handleUnexpectedVoiceLoss(message) {
            if (this.shuttingDown) return;

            this.markVoiceUnavailable(new Error(message));
            this.finishCurrentInteraction('Failed');
            this.notify(
                'Voice could not connect. Please reload or contact your supervisor.',
                'error'
            );

            if (this.agentStatus() === 'ready') {
                this.forceAgentOffline();
            }
        }

        handleReplacedVoiceSession(message) {
            if (this.shuttingDown) return;

            this.applyLocalOfflineVisual();
            this.markVoiceUnavailable(new Error(message));
            this.finishCurrentInteraction('Failed');
            this.notify(
                'Voice session active elsewhere.',
                'error'
            );
            this.debug('Voice session replaced locally; global status unchanged', {
                message: namespace.safeError(message),
            });
        }

        applyLocalOfflineVisual() {
            this.localStatusOverride = 'offline';
            if (typeof window.applyLocalAgentOfflineVisual === 'function') {
                window.applyLocalAgentOfflineVisual();
                this.setStatusSelectorEnabled(false);
                return;
            }

            const label = document.getElementById('statusLabel');
            const dot = document.getElementById('statusDot');
            const timer = document.getElementById('statusTimer');
            if (label) label.textContent = 'Offline';
            if (dot) dot.style.background = '#94a3b8';
            if (timer) {
                timer.textContent = '00:00:00';
                timer.style.color = 'var(--text-strong)';
            }
            this.setStatusSelectorEnabled(false);
        }

        forceAgentOffline() {
            if (this.offlineTransitionPromise) {
                return this.offlineTransitionPromise;
            }

            this.offlineTransitionPromise = window.setStatus('offline')
                .catch(error => {
                    this.debug('Unable to move agent Offline', {
                        message: namespace.safeError(error),
                    });
                })
                .finally(() => {
                    this.offlineTransitionPromise = null;
                });

            return this.offlineTransitionPromise;
        }

        syncReadyControl(busy, unavailable) {
            const action = document.getElementById('agentReadyAction');
            if (!action) return;
            action.setAttribute('aria-busy', String(Boolean(busy)));
            action.setAttribute(
                'aria-disabled',
                String(Boolean(busy || unavailable))
            );
            action.style.opacity = busy || unavailable ? '.55' : '1';
        }

        setStatusSelectorEnabled(enabled) {
            if (typeof window.setAgentStatusSelectorEnabled === 'function') {
                window.setAgentStatusSelectorEnabled(enabled);
            }
        }

        async enableStatusSelectorWhenOperational() {
            if (!this.initialStatusLifecycleReady) return;

            if (this.config.initialState?.force_offline_on_init
                && !this.initialOfflineApplied) {
                return;
            }

            const pendingOffline = this.initialOfflinePromise;
            if (pendingOffline) {
                await pendingOffline;
            }

            // Defense in depth: never let the bootstrap/reconnect enable-path
            // race an active effective Voice state back open. The lock's own
            // apply/clear pair is the single source of truth; this just refuses
            // to override it if it's currently active.
            if (this.hasActiveEffectiveVoiceStatusOverlay()) return;

            if (this.manager?.isReady() && !this.voiceUnavailable) {
                this.setStatusSelectorEnabled(true);
                if (!this.startupPerformanceLogged) {
                    this.startupPerformanceLogged = true;
                    this.startupPerformance.navigation_to_dropdown_enabled_ms =
                        this.navigationElapsed();
                    window.setTimeout(() => {
                        this.debug(
                            'Agent Console Voice startup performance',
                            Object.fromEntries(Object.entries(
                                this.startupPerformance
                            ).map(([key, value]) => [
                                key,
                                Number.isFinite(value)
                                    ? Math.round(value * 100) / 100
                                    : null,
                            ]))
                        );
                    }, 0);
                }
                // Boot is complete: status selector enabled = initial offline applied (or not
                // needed) + JsSIP registered + ownership confirmed.
                this._signalPreviewBoot(true, this.ownershipResolved);
            }
        }

        resetInitialReadyStatus() {
            return this.persistInitialOfflineIfAllowed(
                'initial-status-reset'
            );
        }

        canPersistInitialOffline() {
            return Boolean(
                this.config.initialState?.force_offline_on_init
                && this.statusApiReady
                && this.ownershipResolved
                && this.manager?.ownershipState === 'same_tab'
                && !this.initialOfflineApplied
                && !this.initialOfflinePromise
                && !this.manager?.callManager?.currentSession
                && !['replaced', 'revoked', 'unavailable', 'stopped']
                    .includes(this.manager?.phase)
            );
        }

        persistInitialOfflineIfAllowed(source) {
            if (this.initialOfflinePromise) {
                return this.initialOfflinePromise;
            }

            if (!this.canPersistInitialOffline()) {
                return Promise.resolve(null);
            }

            this.initialOfflinePromise = Promise.resolve(
                window.setStatus('offline')
            ).then(result => {
                if (result?.ok === false) return result;
                this.initialOfflineApplied = true;
                this.debug('Initial Offline persisted', { source });
                return result;
            }).finally(() => {
                this.initialOfflinePromise = null;
            });

            return this.initialOfflinePromise;
        }

        cleanupLocal() {
            this.shuttingDown = true;
            this.manager?.callManager?.setInboundAllowed(false);
            this.stopDurationTimer();
            if (this.inboundTerminationTimer !== null) {
                window.clearTimeout(this.inboundTerminationTimer);
                this.inboundTerminationTimer = null;
            }
            // Stop the 60-second tray time-relative refresh interval
            if (this._timeRelativeInterval !== null) {
                window.clearInterval(this._timeRelativeInterval);
                this._timeRelativeInterval = null;
            }
            // Disconnect MutationObserver watching the conversation list
            if (this.trayObserver) {
                this.trayObserver.disconnect();
                this.trayObserver = null;
            }
            if (this.deviceChangeHandler
                && window.navigator?.mediaDevices?.removeEventListener) {
                window.navigator.mediaDevices.removeEventListener(
                    'devicechange',
                    this.deviceChangeHandler
                );
                this.deviceChangeHandler = null;
            }
            this.microphonePreflightPassed = false;
            this.microphonePreflightPromise = null;
            this.microphonePreflightError = null;
            this.lastMicrophonePreflight = null;
            this.manager?.destroy();
        }

        notify(message, type) {
            if (typeof window.showToast === 'function') {
                window.showToast(message, type || 'success');
            }
        }

        debug(message, data) {
            if (!this.config.capability?.qa_enabled) return;
            if (data === undefined || data === null) {
                window.console.debug(`[voice] ${message}`);
                return;
            }
            window.console.debug(`[voice] ${message}`, data);
        }

        escape(value) {
            const div = document.createElement('div');
            div.textContent = String(value ?? '');
            return div.innerHTML;
        }

        // ── Disposition hydration ─────────────────────────────────────────────
        // Ensures interaction.dispositions is populated before the modal opens.
        // Returns a Promise that resolves to the dispositions array.
        // Idempotent: if already loaded, resolves instantly.
        // Race-safe: if a load is already in flight, awaits the same promise.
        // If the backend call fails, rejects so the caller can show a recoverable error.

        ensureVoiceDispositionsLoaded(interaction) {
            // Already cached on the interaction
            if (interaction.dispositionsLoaded && Array.isArray(interaction.dispositions)) {
                if (typeof window.setCurrentDispositions === 'function') {
                    window.setCurrentDispositions(interaction.dispositions);
                }
                return Promise.resolve(interaction.dispositions);
            }

            if (!interaction.conversationId) {
                return Promise.reject(new Error(
                    'Voice interaction is not persisted yet. Disposition unavailable.'
                ));
            }

            // Coalesce concurrent callers — only one fetch in flight at a time
            if (interaction.dispositionsLoading && interaction._dispositionPromise) {
                return interaction._dispositionPromise;
            }

            interaction.dispositionsLoading = true;
            interaction._dispositionPromise = window.fetch(
                `/console/conversation/${interaction.conversationId}`,
                { headers: { Accept: 'application/json' } }
            )
            .then(r => {
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                return r.json();
            })
            .then(data => {
                const dispositions = Array.isArray(data.dispositions) ? data.dispositions : [];
                interaction.dispositions        = dispositions;
                interaction.dispositionsLoaded  = true;
                interaction.dispositionsLoading = false;

                // Also hydrate other fields from this response to avoid duplicate fetches
                if (data.lead) {
                    interaction.lead = data.lead;
                    interaction.leadId = data.lead.id;
                    interaction.leadLookupStatus = 'found';
                } else if (data.dynamic_lead_row) {
                    interaction.dynamicLeadRow = data.dynamic_lead_row;
                    interaction.leadList = data.lead_list || null;
                    interaction.dialerCampaign = data.dialer_campaign || null;
                    interaction.crmCampaign = data.campaign || null;
                    interaction.leadLookupStatus = 'dynamic_row';
                }
                if (Array.isArray(data.dispositions) && data.dispositions.length
                    && !interaction.events?.length && data.voice_call) {
                    interaction.events = this._buildTimelineFromBackend(data.voice_call);
                }

                if (typeof window.setCurrentDispositions === 'function') {
                    window.setCurrentDispositions(dispositions);
                }
                return dispositions;
            })
            .catch(err => {
                interaction.dispositionsLoading = false;
                interaction._dispositionPromise = null;
                throw err;
            });

            return interaction._dispositionPromise;
        }

        isTerminalStatus(status) {
            return ['Ended', 'Rejected', 'Failed', 'Missed', 'Busy', 'No Answer', 'Congestion', 'Unavailable', 'Cancelled']
                .includes(status);
        }

        hasPendingVoiceWrapUp() {
            return Array.from(this.voiceInteractions?.values() || [])
                .some(interaction => Boolean(
                    interaction?.conversationId
                    && interaction.wrapUpPending === true
                    && this.interactionWasAnswered(interaction)
                    && this.isTerminalVisualStatus(this.effectiveInteractionStatus(interaction))
                ));
        }

        markConversationResolved(conversationId) {
            const id = Number(conversationId);
            let changed = false;
            Array.from(this.voiceInteractions?.values() || []).forEach(interaction => {
                if (Number(interaction.conversationId) === id) {
                    interaction.wrapUpPending = false;
                    changed = true;
                }
            });
            if (changed) {
                window.PreviewDialerAgent?.setVoiceWrapUpPending?.(this.hasPendingVoiceWrapUp());
            }
            // Phase 1E-B3: only clears the header's Wrap-Up overlay if NO other
            // answered Voice Conversation is still pending disposition — multiple
            // Wrap-Up safety mirrors the backend's AgentStatusService::
            // exitVoiceWrapUpAfterDisposition() (hasOtherPendingVoiceWrapUp()).
            this.recomputeEffectiveVoiceStatusOverlay();
        }

        // Trigger background disposition pre-load when a call becomes terminal and
        // the conversation is already persisted. This runs non-blocking so that by
        // the time the agent clicks Disposition, the data is already cached.
        _prewarmDispositionsIfTerminal(interaction) {
            const terminal = this.isTerminalVisualStatus(this.effectiveInteractionStatus(interaction));
            if (!terminal || !interaction.conversationId || interaction.dispositionsLoaded) {
                return;
            }
            // Fire-and-forget background load; click handler retries on failure.
            this.ensureVoiceDispositionsLoaded(interaction).catch(err => {
                this.debug('Background disposition pre-warm failed', {
                    interaction_id: interaction.id,
                    conversation_id: interaction.conversationId,
                    error: namespace.safeError(err),
                });
            });
        }

        // ── Initial hydration from server payload ─────────────────────────────
        // Called synchronously in prepareVoice() before any fetch().
        // Reads config.initialVoiceConversations (JSON embedded in blade by PHP)
        // and creates recovery interactions, then calls renderTrayInteractions().
        // This makes Voice appear at page-load time alongside Email/WhatsApp/Facebook.
        // No audio, no network request, no duplicate risk.

        hydrateInitialVoiceConversations() {
            const convs = this.config.initialVoiceConversations || [];
            if (!convs.length) return;

            let added = 0;
            convs.forEach(conv => {
                const callUuid = conv.external_id || null;
                const localId  = callUuid
                    ? `voice-local-${callUuid}`
                    : `voice-local-db-${conv.id}`;

                // Idempotent: skip if already in map (e.g. from a live RTCSession)
                if (this.voiceInteractions.has(localId)) return;

                // Never hydrate a never-answered-terminal Conversation into the tray —
                // it must stay invisible until a real reoffer rings again or a future
                // AMI/Queue-outcome service resolves it. See shouldHydrateVoiceConversation().
                if (!this.shouldHydrateVoiceConversation(conv)) return;

                const direction = conv.voice_direction || conv.direction || 'inbound';
                const recPhone = conv.remote_phone || conv.from_email || '';
                const primaryPhone = direction === 'outbound'
                    ? (conv.dnis_normalized || recPhone)
                    : (conv.ani_normalized || recPhone);
                const recDisplayPhone = primaryPhone
                    || this.normalizeNanpPhone(recPhone)
                    || recPhone;
                const recLead = conv.lead || null;
                const recLeadName = recLead
                    ? [recLead.first_name, recLead.last_name].filter(Boolean).join(' ')
                    : '';
                const recDisplayName = recLeadName || conv.lead_name || conv.from_name || recDisplayPhone;
                const recStatus = conv.voice_call_state
                    ? this.visualCallStatus(conv.voice_call_state)
                    : 'Ended';
                const recAnsweredAt = conv.voice_call_answered_at || null;
                const recTerminal = this.isTerminalVisualStatus(recStatus);
                this.voiceInteractions.set(localId, {
                    id:              localId,
                    conversationId:  conv.id,
                    voiceCallId:     null,
                    callUuid:        callUuid,
                    persistedCallUuid: callUuid,
                    conversationCampaignId: conv.campaign_id || null,
                    asteriskLinkedid: conv.asterisk_linkedid || null,
                    phone:           recPhone,
                    normalizedPhone: this.normalizeNanpPhone(primaryPhone) || primaryPhone,
                    displayPhone:    recDisplayPhone,
                    aniNormalized:   conv.ani_normalized || null,
                    dnisNormalized:  conv.dnis_normalized || null,
                    direction,
                    status:          recStatus,
                    backendCallState: conv.voice_call_state || null,
                    backendAnsweredAt: recAnsweredAt,
                    backendEndedAt:    conv.voice_call_ended_at || null,
                    createdAt:       new Date(),
                    // Preserved across refresh (recomputeEffectiveVoiceStatusOverlay()
                    // needs the REAL historical timestamp — not "now" — so the header
                    // timer resumes from when the call was actually answered/ended
                    // instead of resetting to zero on page load).
                    connectedAt:     recAnsweredAt ? new Date(recAnsweredAt) : null,
                    endedAt:         conv.voice_call_ended_at ? new Date(conv.voice_call_ended_at) : null,
                    events:          [],
                    lead:            recLead,
                    leadId:          recLead?.id || conv.lead_id || null,
                    campaignId:      conv.campaign_id || null,
                    dialerCampaignId: conv.dialer_campaign_id || null,
                    leadListId:      conv.lead_list_id || null,
                    leadListRowId:   conv.lead_list_row_id || null,
                    isPreviewDialer: Boolean(conv.lead_list_id || conv.lead_list_row_id),
                    backendLeadSnapshotLoaded: false,
                    previewDynamicRowLocked: false,
                    // On cold browser start the sidebar list does not include the full
                    // lead or dynamic-row payload. A lead_id without lead data means a
                    // CRM lead exists, but the renderable Lead object is still loading.
                    leadLookupStatus: recLead ? 'found' : (conv.lead_id ? 'lead_pending' : 'idle'),
                    leadLookupPromise: null,
                    displayName:         recDisplayName,
                    _waitSinceAt:        this._parseWaitSinceToDate(conv.wait_since),
                    dispositions:        null,
                    dispositionsLoaded:  false,
                    dispositionsLoading: false,
                    wrapUpPending:       Boolean(conv.is_voice_wrap_up),
                    needsDisposition:    Boolean(conv.is_voice_wrap_up)
                        || (direction === 'outbound' && recTerminal && !recAnsweredAt),
                    fetchPending:        false,
                    _recovered:          true,
                    _fromInit:           true,
                });
                added++;
            });

            if (added > 0) {
                this.renderTrayInteractions();
                // A page load (including the reload after a browser refresh) must
                // show In Call/Wrap-Up on the header immediately if a hydrated
                // interaction is still authoritative — otherwise the header would
                // display whatever the server-rendered requested-status showed
                // (Offline) until some later live event happened to recompute it.
                this.recomputeEffectiveVoiceStatusOverlay();
            }
        }

        // ── Persistence: create Conversation + VoiceCall in backend ──────────
        // Fire-and-forget after creating the local interaction. Non-blocking.
        // Stores conversationId, voiceCallId on the interaction for deduplication.

        persistInteraction(interaction, sessionUuid, originConversationId) {
            const callUuid = interaction.id.replace(/^voice-local-/, '');
            if (interaction._persistPromise) return interaction._persistPromise;
            interaction.temporaryCallUuid = interaction.temporaryCallUuid || callUuid;

            interaction._persistPromise = window.fetch('/console/voice/conversations', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-CSRF-TOKEN': this.config.csrfToken,
                },
                body: JSON.stringify({
                    call_uuid:               callUuid,
                    direction:               interaction.direction,
                    phone:                   interaction.phone,
                    ani:                     interaction.acdMetadata?.ani || null,
                    dnis:                    interaction.acdMetadata?.dnis || null,
                    queue_name:              interaction.acdMetadata?.queue_name || null,
                    asterisk_linkedid:       interaction.acdMetadata?.asterisk_linkedid || null,
                    sip_call_id:             interaction.acdMetadata?.sip_call_id || null,
                    browser_voice_session_uuid: sessionUuid || null,
                    session_uuid:            sessionUuid || null,
                    origin_conversation_id:  originConversationId || null,
                    campaign_id:             interaction.campaignId || null,
                    script_id:               interaction.scriptId   || null,
                }),
            })
            .then(r => {
                if (!r.ok) {
                    // HTTP error — telephony continues; log once; no 500 bubbles to RTCSession
                    return r.json().catch(() => ({})).then(body => {
                        this.debug('Voice persist HTTP error', {
                            status: r.status,
                            error: body?.error || 'unknown',
                        });
                        return null;
                    });
                }
                return r.json();
            })
            .then(data => {
                if (!data || !data.ok) return; // persist failed — telephony unaffected

                if (data.reused && data.conversation_id) {
                    const existingInteraction = Array.from(this.voiceInteractions.values())
                        .find(candidate => candidate !== interaction
                            && Number(candidate.conversationId) === Number(data.conversation_id));

                    if (existingInteraction) {
                        interaction.conversationId = data.conversation_id;
                        interaction.voiceCallId = data.voice_call_id;
                        interaction.callUuid = data.call_uuid;
                        interaction.persistedCallUuid = data.call_uuid || null;
                        interaction.asteriskLinkedid = data.asterisk_linkedid
                            || interaction.acdMetadata?.asterisk_linkedid
                            || interaction.asteriskLinkedid
                            || null;
                        interaction.conversationCampaignId = data.campaign_id || null;
                        existingInteraction.events = existingInteraction.events || [];
                        for (const event of interaction.events || []) {
                            existingInteraction.events.push(event);
                        }
                        existingInteraction.status = 'Ringing';
                        existingInteraction.endedAt = null;
                        existingInteraction.wrapUpPending = false;
                        existingInteraction.needsDisposition = false;
                        existingInteraction.acdMetadata = interaction.acdMetadata || existingInteraction.acdMetadata || {};
                        existingInteraction.asteriskLinkedid = data.asterisk_linkedid
                            || interaction.acdMetadata?.asterisk_linkedid
                            || existingInteraction.asteriskLinkedid
                            || null;
                        existingInteraction.persistedCallUuid = data.call_uuid || existingInteraction.persistedCallUuid || null;
                        existingInteraction.callUuid = data.call_uuid || existingInteraction.callUuid || null;
                        existingInteraction.voiceCallId = data.voice_call_id || existingInteraction.voiceCallId || null;
                        existingInteraction.conversationId = data.conversation_id || existingInteraction.conversationId || null;
                        existingInteraction.conversationCampaignId = data.campaign_id || existingInteraction.conversationCampaignId || null;
                        if (data.ani_normalized) {
                            existingInteraction.aniNormalized = data.ani_normalized;
                        }
                        if (data.dnis_normalized) {
                            existingInteraction.dnisNormalized = data.dnis_normalized;
                        }
                        const existingPrimary = existingInteraction.direction === 'outbound'
                            ? (data.dnis_normalized || existingInteraction.normalizedPhone)
                            : (data.ani_normalized || existingInteraction.normalizedPhone);
                        if (existingPrimary) {
                            existingInteraction.normalizedPhone = existingPrimary;
                            existingInteraction.displayPhone = existingPrimary;
                            if (!existingInteraction.lead) {
                                existingInteraction.displayName = existingPrimary;
                            }
                        }
                        if (interaction._pendingCallState) {
                            existingInteraction._pendingCallState = interaction._pendingCallState;
                        }
                        this.voiceInteractions.delete(interaction.id);
                        if (this.currentInteractionId === interaction.id) {
                            this.currentInteractionId = existingInteraction.id;
                        }
                        if (this.activeVoiceInteractionId === interaction.id) {
                            this.activeVoiceInteractionId = existingInteraction.id;
                        }
                        interaction = existingInteraction;
                    }
                }

                interaction.conversationId = data.conversation_id;
                interaction.voiceCallId    = data.voice_call_id;
                interaction.callUuid       = data.call_uuid;
                interaction.persistedCallUuid = data.call_uuid || interaction.persistedCallUuid || null;
                interaction.asteriskLinkedid = data.asterisk_linkedid
                    || interaction.acdMetadata?.asterisk_linkedid
                    || interaction.asteriskLinkedid
                    || null;
                interaction.persisted      = true;
                interaction.queueId        = data.queue_id;
                interaction.campaignId     = data.campaign_id;
                interaction.conversationCampaignId = data.campaign_id || interaction.conversationCampaignId || null;
                if (data.ani_normalized) {
                    interaction.aniNormalized = data.ani_normalized;
                }
                if (data.dnis_normalized) {
                    interaction.dnisNormalized = data.dnis_normalized;
                }
                const primaryPhone = interaction.direction === 'outbound'
                    ? (data.dnis_normalized || interaction.normalizedPhone)
                    : (data.ani_normalized || interaction.normalizedPhone);
                if (primaryPhone) {
                    interaction.normalizedPhone = primaryPhone;
                    interaction.displayPhone = primaryPhone;
                    if (!interaction.lead) {
                        interaction.displayName = primaryPhone;
                    }
                }

                // Migrate lead panel state from local key to persistent key.
                // The local key ('voice:{id}') was used during the pre-persist phase.
                // The persistent key ('conv:{conversationId}') is used for recovery.
                // This ensures the user's open/close choice is not lost at persistence.
                if (typeof window.migrateLeadPanelState === 'function') {
                    window.migrateLeadPanelState(
                        `voice:${interaction.id}`,
                        `conv:${data.conversation_id}`
                    );
                }

                // Remove any stale DB-backed conv-item that may exist from a refresh
                // before this call was persisted.  The voice-local-card is now canonical.
                const staleCard = document.querySelector(
                    `.conv-item[data-id="${data.conversation_id}"]`
                );
                if (staleCard) staleCard.remove();

                // Store lead hint in memory — never render from here.
                // Rule: LeadPanel is only rendered when the panel is open.
                // The next time the panel opens, it will use the latest memory state.
                if (data.lead_id && !interaction.lead) {
                    interaction.leadId = data.lead_id;
                    // Keep status as 'idle' so that when the panel opens it triggers
                    // a full lookup (we only have the id, not the lead object).
                }

                this.fetchPersistedConversationDetail(interaction);

                // Update script in memory and re-render immediately so the Script tab
                // shows without waiting for the next call:status event.
                if (data.script) {
                    const hadScript          = Boolean(interaction.scriptData);
                    interaction.script       = data.script.name;
                    interaction.scriptData   = data.script;
                    interaction.scriptSource = data.script_source;
                    if (!hadScript && this.activeVoiceInteractionId === interaction.id) {
                        this.renderInteraction(interaction);
                    }
                }

                this.debug('Voice conversation persisted', {
                    conversation_id: data.conversation_id,
                    voice_call_id:   data.voice_call_id,
                });

                // If the call was already in a terminal state when persist completed
                // (e.g. fast outbound Failed/Ended before the POST returned), the panel
                // is stuck showing "Saving call record…" because conversationId was null
                // during the last renderInteraction() call.  Now that we have a real ID,
                // re-render to show the Disposition button and start loading dispositions.
                const isNowTerminal = this.isTerminalVisualStatus(this.effectiveInteractionStatus(interaction));
                // Phase 1E-B2: same never-answered gate as finishCurrentInteraction() —
                // this branch only covers the race where persistence resolves after the
                // call already ended (e.g. a fast Reject/Cancel before the POST returned).
                const isUnansweredInboundOffer = isNowTerminal
                    && interaction.direction === 'inbound'
                    && !interaction.connectedAt;
                if (isUnansweredInboundOffer) {
                    this.discardUnansweredOffer(interaction);
                    return;
                }
                if (isNowTerminal && interaction.conversationId) {
                    const wasAnswered = this.interactionWasAnswered(interaction);
                    interaction.wrapUpPending = wasAnswered;
                    interaction.needsDisposition = !wasAnswered;
                    window.PreviewDialerAgent?.setVoiceWrapUpPending?.(this.hasPendingVoiceWrapUp());
                }
                if (isNowTerminal && this.activeVoiceInteractionId === interaction.id) {
                    this.renderInteraction(interaction);
                }
                // Always prewarm dispositions for terminal calls that just persisted.
                if (isNowTerminal) {
                    this._prewarmDispositionsIfTerminal(interaction);
                }
            })
            .catch(err => {
                // Network error — telephony continues; no 404 flood
                this.debug('Voice persist error', { error: namespace.safeError(err) });
            });

            return interaction._persistPromise;
        }

        // Update call state in the backend. If persistInteraction has not yet
        // completed, the new state is queued and flushed after the POST succeeds.
        // Only the LATEST pending state is sent (earlier intermediate states are
        // superseded); backend validates transitions so ordering is safe.
        // Never sends a PATCH when conversationId/voiceCallId are unknown (avoids 404 spam).
        updateCallStatePersisted(interaction, newState) {
            interaction = this.findCanonicalStateInteraction(interaction) || interaction;
            // Stash the latest desired state — supersedes any earlier pending state
            interaction._pendingCallState = newState;

            const doPatch = () => {
                const state = interaction._pendingCallState;
                if (!state) return;
                interaction._pendingCallState = null;
                const callUuid = interaction.persistedCallUuid || (interaction.persisted ? interaction.callUuid : null);
                if (!callUuid) {
                    this.logSkippedStatePatch(
                        interaction,
                        interaction.temporaryCallUuid || interaction.id?.replace(/^voice-local-/, ''),
                        state,
                        'missing_persisted_call_uuid'
                    );
                    return;
                }

                window.fetch(`/console/voice/calls/${encodeURIComponent(callUuid)}/state`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-CSRF-TOKEN': this.config.csrfToken,
                    },
                    body: JSON.stringify({ call_state: state }),
                }).then(response => {
                    if (response.status === 404) {
                        this.logSkippedStatePatch(
                            interaction,
                            callUuid,
                            state,
                            'backend_call_uuid_not_found'
                        );
                    }
                }).catch(() => {/* non-critical — call audio continues regardless */});
            };

            if (interaction._persistPromise) {
                // Persist in flight — flush after it settles (success or failure)
                interaction._persistPromise.then(doPatch, doPatch);
            } else if (interaction.conversationId) {
                // Already persisted — fire immediately
                doPatch();
            }
            // else: no persist started yet (e.g. persistInteraction not called) — drop silently
        }

        // ── Refresh recovery: render a voice conversation loaded from the backend ──
        // Called by renderConversation() when channel === 'voice'.
        // Creates/updates the local interaction entry and delegates to renderInteraction().

        renderVoiceConversationFromBackend(data) {
            const conv      = data.conversation;
            const voiceCall = data.voice_call;
            const localId   = conv.external_id
                ? `voice-local-${conv.external_id}`
                : `voice-local-db-${conv.id}`;

            // Merge into existing local interaction or create a recovery entry
            let interaction = Array.from(this.voiceInteractions.values())
                .find(i => i.conversationId === conv.id
                    || (conv.external_id && i.id === localId));

            if (!interaction) {
                const terminalState = voiceCall?.is_terminal
                    ? this.visualCallStatus(voiceCall.call_state)
                    : null;
                const recoveredDirection = conv.direction || voiceCall?.direction || 'inbound';
                const recoveredAnsweredAt = voiceCall?.answered_at || null;
                const recoveredPhone = recoveredDirection === 'outbound'
                    ? (voiceCall?.dnis_normalized || voiceCall?.remote_number || conv.from_email || '')
                    : (voiceCall?.ani_normalized || voiceCall?.remote_number || conv.from_email || '');
                const recoveredDisplayPhone = this.normalizeNanpPhone(recoveredPhone) || recoveredPhone;
                interaction = {
                    id:              localId,
                    campaign:        null,
                    script:          data.script?.name || null,
                    phone:           voiceCall?.remote_number || conv.from_email || '',
                    normalizedPhone: recoveredPhone,
                    displayPhone:    recoveredDisplayPhone,
                    displayName:     data.lead
                        ? ([data.lead.first_name, data.lead.last_name].filter(Boolean).join(' ') || data.lead.phone || recoveredDisplayPhone || '')
                        : (conv.from_name || recoveredDisplayPhone || ''),
                    direction:       recoveredDirection,
                    status:          terminalState || (voiceCall ? this.visualCallStatus(voiceCall.call_state) : 'Ended'),
                    backendCallState: voiceCall?.call_state || null,
                    backendAnsweredAt: recoveredAnsweredAt,
                    backendEndedAt:    voiceCall?.ended_at || null,
                    createdAt:       new Date(conv.created_at || Date.now()),
                    ringingAt:       voiceCall?.ringing_at ? new Date(voiceCall.ringing_at) : new Date(conv.created_at || Date.now()),
                    connectedAt:     recoveredAnsweredAt ? new Date(recoveredAnsweredAt) : null,
                    endedAt:         voiceCall?.ended_at ? new Date(voiceCall.ended_at) : null,
                    durationSeconds: voiceCall?.duration_seconds ?? null,
                    talkSeconds:     voiceCall?.talk_seconds ?? null,
                    events:          this._buildTimelineFromBackend(voiceCall),
                    lead:            data.lead || null,
                    leadId:          data.lead?.id || conv.lead_id || null,
                    dynamicLeadRow:  data.dynamic_lead_row || null,
                    leadList:        data.lead_list || null,
                    dialerCampaign:  data.dialer_campaign || null,
                    crmCampaign:     data.campaign || null,
                    leadLookupStatus: data.lead ? 'found' : (data.dynamic_lead_row ? 'dynamic_row' : 'not_found'),
                    backendLeadSnapshotLoaded: Boolean(data.lead || data.dynamic_lead_row),
                    backendLeadSnapshotConversationId: conv.id || null,
                    previewDynamicRowLocked: Boolean(data.dynamic_lead_row && !data.lead),
                    isPreviewDialer: Boolean(data.dynamic_lead_row || conv.lead_list_id || conv.lead_list_row_id),
                    leadListId:      conv.lead_list_id || data.lead_list?.id || null,
                    leadListRowId:   conv.lead_list_row_id || data.dynamic_lead_row?.id || null,
                    leadLookupPromise: null,
                    conversationId:  conv.id,
                    voiceCallId:     voiceCall?.id || null,
                    queueId:         data.meta?.queue_id || conv.queue_id || null,
                    callUuid:        voiceCall?.call_uuid || conv.external_id || null,
                    persistedCallUuid: voiceCall?.call_uuid || null,
                    asteriskLinkedid: voiceCall?.asterisk_linkedid || null,
                    conversationCampaignId: conv.campaign_id || data.meta?.campaign_id || null,
                    aniNormalized: voiceCall?.ani_normalized || null,
                    dnisNormalized: voiceCall?.dnis_normalized || null,
                    sipCallId: voiceCall?.sip_call_id || null,
                    internalQueueName: voiceCall?.asterisk_queue_name || null,
                    wrapUpPending:   Boolean(data.is_voice_wrap_up),
                    needsDisposition: Boolean(data.is_voice_wrap_up)
                        || (recoveredDirection === 'outbound' && Boolean(terminalState) && !recoveredAnsweredAt),
                    _recovered:      true,
                };
                this.voiceInteractions.set(localId, interaction);
                if (data.dynamic_lead_row && !data.lead) {
                    this.lockPreviewDynamicRow(interaction, conv.id, data.dynamic_lead_row);
                }
            } else {
                // Sync backend state into existing local interaction without
                // overwriting live RTCSession data (state, connectedAt, timer).
                const skipRecoveredDowngrade = this._isRecoveredStateDowngrade(interaction, voiceCall);

                if (!skipRecoveredDowngrade && voiceCall?.is_terminal && interaction.connectedAt === null && voiceCall.answered_at) {
                    interaction.connectedAt = new Date(voiceCall.answered_at);
                }
                if (voiceCall && !skipRecoveredDowngrade) {
                    interaction.backendCallState = voiceCall.call_state || null;
                    interaction.backendAnsweredAt = voiceCall.answered_at || null;
                    interaction.backendEndedAt = voiceCall.ended_at || null;
                    interaction.ringingAt = voiceCall.ringing_at ? new Date(voiceCall.ringing_at) : interaction.ringingAt;
                    interaction.durationSeconds = voiceCall.duration_seconds ?? interaction.durationSeconds;
                    interaction.talkSeconds = voiceCall.talk_seconds ?? interaction.talkSeconds;
                    interaction.status = this.visualCallStatus(voiceCall.call_state);
                }
                if (!skipRecoveredDowngrade && voiceCall?.ended_at && !interaction.endedAt) {
                    interaction.endedAt = new Date(voiceCall.ended_at);
                }
                if (!interaction.conversationId) interaction.conversationId = conv.id;
                if (!interaction.voiceCallId && voiceCall?.id) interaction.voiceCallId = voiceCall.id;
                interaction.queueId = data.meta?.queue_id || conv.queue_id || interaction.queueId || null;
                if (voiceCall?.call_uuid) {
                    interaction.callUuid = voiceCall.call_uuid;
                    interaction.persistedCallUuid = voiceCall.call_uuid;
                }
                if (voiceCall?.asterisk_linkedid) {
                    interaction.asteriskLinkedid = voiceCall.asterisk_linkedid;
                }
                if (voiceCall?.ani_normalized) {
                    interaction.aniNormalized = voiceCall.ani_normalized;
                }
                const refreshedPrimary = interaction.direction === 'outbound'
                    ? (voiceCall?.dnis_normalized || voiceCall?.remote_number)
                    : (voiceCall?.ani_normalized || voiceCall?.remote_number);
                if (refreshedPrimary) {
                    interaction.normalizedPhone = refreshedPrimary;
                    interaction.displayPhone = this.normalizeNanpPhone(interaction.normalizedPhone)
                        || interaction.displayPhone
                        || interaction.normalizedPhone;
                    if (!interaction.lead) {
                        interaction.displayName = interaction.displayName || interaction.displayPhone;
                    }
                }
                if (voiceCall?.dnis_normalized) {
                    interaction.dnisNormalized = voiceCall.dnis_normalized;
                }
                if (voiceCall?.sip_call_id) {
                    interaction.sipCallId = voiceCall.sip_call_id;
                }
                if (voiceCall?.asterisk_queue_name) {
                    interaction.internalQueueName = voiceCall.asterisk_queue_name;
                }
                interaction.conversationCampaignId = conv.campaign_id
                    || data.meta?.campaign_id
                    || interaction.conversationCampaignId
                    || null;
                if (data.is_voice_wrap_up !== undefined) {
                    interaction.wrapUpPending = Boolean(data.is_voice_wrap_up);
                    interaction.needsDisposition = Boolean(data.is_voice_wrap_up)
                        || (interaction.direction === 'outbound'
                            && this.isTerminalVisualStatus(this.effectiveInteractionStatus(interaction))
                            && !this.interactionWasAnswered(interaction));
                }

                // Update lead from full backend payload (recovery entries have partial lead data)
                    if (data.lead) {
                        interaction.lead = data.lead;
                        interaction.leadId = data.lead.id;
                        interaction.displayName = [data.lead.first_name, data.lead.last_name]
                            .filter(Boolean).join(' ') || data.lead.phone || interaction.phone;
                        interaction.dynamicLeadRow = null;
                    interaction.previewDynamicRowLocked = false;
                    interaction.backendLeadSnapshotLoaded = true;
                    interaction.backendLeadSnapshotConversationId = conv.id || interaction.conversationId || null;
                    this.previewDynamicRowLocks.delete(Number(conv.id || interaction.conversationId || 0));
                    interaction.leadList = null;
                    interaction.dialerCampaign = data.dialer_campaign || interaction.dialerCampaign || null;
                    interaction.crmCampaign = data.campaign || interaction.crmCampaign || null;
                    interaction.leadLookupStatus = 'found';
                } else if (data.dynamic_lead_row) {
                    interaction.lead = null;
                    interaction.leadId = null;
                    interaction.contact = null;
                    interaction.resolvedLead = null;
                    interaction.crmLead = null;
                    interaction.leadLookupResult = null;
                    interaction.dynamicLeadRow = data.dynamic_lead_row;
                    interaction.leadList = data.lead_list || null;
                    interaction.dialerCampaign = data.dialer_campaign || null;
                    interaction.crmCampaign = data.campaign || null;
                    interaction.suggestedLeads = Array.isArray(data.suggested_leads) ? data.suggested_leads : [];
                    interaction.leadLookupStatus = 'dynamic_row';
                    interaction.backendLeadSnapshotLoaded = true;
                    interaction.backendLeadSnapshotConversationId = conv.id || interaction.conversationId || null;
                    interaction.isPreviewDialer = true;
                    interaction.leadListId = conv.lead_list_id || data.lead_list?.id || interaction.leadListId || null;
                    interaction.leadListRowId = conv.lead_list_row_id || data.dynamic_lead_row?.id || interaction.leadListRowId || null;
                    this.lockPreviewDynamicRow(interaction, interaction.backendLeadSnapshotConversationId, data.dynamic_lead_row);
                } else if (data.lead === null && !interaction.conversationId) {
                    // Backend confirmed no lead
                    interaction.leadLookupStatus = 'not_found';
                }

                if (data.script && !interaction.scriptData) {
                    interaction.scriptData = data.script;
                    interaction.scriptSource = data.script_source;
                }
                // Rebuild timeline from backend for terminal snapshots or empty recovery entries.
                // Do not let an older non-terminal response downgrade a recovered terminal state.
                if (voiceCall && !skipRecoveredDowngrade && (voiceCall.is_terminal || !interaction.events || interaction.events.length === 0)) {
                    interaction.events = this._buildTimelineFromBackend(voiceCall);
                }
            }

            // Use interaction.id (the actual Map key) — NOT localId.
            // localId and interaction.id can diverge when a recovery entry was created with
            // `voice-local-db-{conv.id}` but conv.external_id later resolves to a different
            // UUID. renderLeadForInteraction() guards on activeVoiceInteractionId === interaction.id;
            // using localId here would cause that guard to fail → skeleton never clears.
            this.activeVoiceInteractionId = interaction.id;
            window.activeConversationId = null;

            // Cache dispositions on the interaction so they survive navigation
            // (email → voice → voice without re-fetch).
            if (Array.isArray(data.dispositions)) {
                interaction.dispositions       = data.dispositions;
                interaction.dispositionsLoaded = true;
                interaction.dispositionsLoading = false;
            }

            // Push into the global slot that setDisposition() reads.
            // setCurrentDispositions is a function exported by the blade so it can
            // update the `let currentDispositions` binding in the Script Scope.
            if (Array.isArray(interaction.dispositions)
                && typeof window.setCurrentDispositions === 'function') {
                window.setCurrentDispositions(interaction.dispositions);
            }

            this.schedulePreviewAutoRecovery(interaction);

            // Render the central Voice panel (timeline, controls, script tab) only if active.
            if (this.activeVoiceInteractionId === interaction.id) {
                this.renderInteraction(interaction);
                // LeadPanel: only update if already open — rule: panel closed → no render.
                if (window.isLeadPanelOpen?.()) {
                    this.renderLeadForInteraction(interaction);
                }
            }
            this.renderTrayInteractions();
        }

        /**
         * Compact summary row shown above the timeline in convContentArea.
         * Direction, remote number, call state, and duration.
         * Not duplicating header data unnecessarily — shows tech metadata.
         */
        _renderVoiceSummary(interaction) {
            const terminal = this.isTerminalVisualStatus(this.effectiveInteractionStatus(interaction));
            const parts = [];

            const direction = interaction.direction === 'inbound' ? 'Inbound' : 'Outbound';
            parts.push(direction);

            if (interaction.normalizedPhone || interaction.phone) {
                parts.push(this.escape(
                    this.normalizeNanpPhone(interaction.normalizedPhone || interaction.phone)
                        || interaction.normalizedPhone
                        || interaction.phone
                ));
            }

            if (terminal && interaction.connectedAt && interaction.endedAt) {
                const secs = Math.max(0, Math.floor(
                    (interaction.endedAt - interaction.connectedAt) / 1000
                ));
                const mm = String(Math.floor(secs / 60)).padStart(2, '0');
                const ss = String(secs % 60).padStart(2, '0');
                parts.push(`${mm}:${ss}`);
            }

            if (!parts.length) return '';
            return `<div style="padding:8px 16px 0;display:flex;gap:10px;align-items:center;font-size:12px;color:var(--text-muted);flex-shrink:0;">
                ${parts.map(p => `<span>${p}</span>`).join('<span style="opacity:.4">·</span>')}
            </div>`;
        }

        /**
         * Parse a server-formatted relative string like "18m", "3h", "2d" back into an
         * approximate Date.  Used to seed _waitSinceAt for recovery entries so the tray
         * time continues advancing without needing a server round-trip.
         */
        _parseWaitSinceToDate(str) {
            if (!str || str === 'now') return new Date();
            const m = String(str).match(/^(\d+)\s*([mhd])/i);
            if (!m) return new Date();
            const num = parseInt(m[1], 10);
            const mul = { m: 60, h: 3600, d: 86400 }[m[2].toLowerCase()] * 1000;
            return new Date(Date.now() - num * mul);
        }

        /**
         * Relative time string for the tray card corner (e.g. "5m", "3d").
         * Uses the same algorithm as Agent Console's existing conv-time elements.
         * Source of truth is _waitSinceAt stored on the interaction (a real Date).
         *
         * NOT the same as the call duration timer — that measures talk time.
         */
        _relativeTime(date) {
            if (!date) return '';
            const d = date instanceof Date ? date : new Date(date);
            const diffMs = Date.now() - d.getTime();
            if (Number.isNaN(diffMs) || diffMs < 0) return '';
            const secs  = Math.floor(diffMs / 1000);
            const mins  = Math.floor(secs  / 60);
            const hours = Math.floor(mins  / 60);
            const days  = Math.floor(hours / 24);
            if (days  >= 1) return `${days}d`;
            if (hours >= 1) return `${hours}h`;
            if (mins  >= 1) return `${mins}m`;
            return 'now';
        }

        _buildTimelineFromBackend(voiceCall) {
            if (!voiceCall) return [];

            const events = [];
            const seen = new Set(); // prevent duplicate labels
            const push = (label, at) => {
                if (!at || seen.has(label)) return;
                seen.add(label);
                events.push({ status: label, label, at: new Date(at) });
            };

            const inbound = voiceCall.direction === 'inbound';

            // Chronological heuristic: ringing/connecting → answered → terminal
            if (inbound) {
                push('Ringing', voiceCall.ringing_at);
            } else {
                // For outbound, ringing_at is when the call was initiated (connecting state)
                push('Connecting', voiceCall.ringing_at);
            }

            if (voiceCall.answered_at) {
                push(inbound ? 'Answered' : 'Connected', voiceCall.answered_at);
            }

            if (voiceCall.ended_at) {
                // Use the human-visible status matching the terminal call_state
                const terminalLabel = this.visualCallStatus(voiceCall.call_state) || 'Ended';
                push(terminalLabel, voiceCall.ended_at);
            }

            // Sort chronologically in case timestamps arrive out of order
            events.sort((a, b) => a.at - b.at);
            return events;
        }

        // ── Icon-only button builder (matches header btn style from Email/Facebook) ──
        // Produces: padding:4px 8px; border; radius; bg-th; text-muted; icon only; title tooltip.

        /**
         * Lead button that matches Email/Facebook's btnToggleLead exactly.
         * Uses the SAME id so openLeadPanel() / closeLeadPanel() update its
         * active background automatically — no parallel state needed.
         * Active style is applied at render time based on window.isLeadPanelOpen?.().
         */
        _leadBtn() {
            // Exactly the same static markup as Email/Facebook btnToggleLead.
            // Active state (primary-light background) is applied dynamically by
            // openLeadPanel()/closeLeadPanel() via getElementById — same mechanism.
            // No Voice-specific color or style.
            return `<button id="btnToggleLead" onclick="toggleLeadPanel()" type="button" title="Lead info"
                style="padding:4px 8px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--bg-th);color:var(--text-muted);cursor:pointer;font-size:12px;display:flex;align-items:center;gap:4px;line-height:1;">
                <i class="bi bi-person-lines-fill"></i>
            </button>`;
        }

        _transferConversationBtn(conversationId) {
            if (!conversationId) return '';
            return `<button onclick="openTransferModal(${Number(conversationId)})" title="Transfer conversation"
                style="padding:4px 8px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--bg-th);color:var(--text-muted);cursor:pointer;font-size:12px;display:flex;align-items:center;gap:4px;line-height:1;">
                <i class="bi bi-arrow-left-right"></i>
            </button>`;
        }

        _iconBtn(id, icon, title, extraClass, disabled) {
            const dis = disabled ? ' disabled' : '';
            const cls = extraClass ? ` ${extraClass}` : '';
            return `<button id="${id}" type="button" title="${this.escape(title)}"${dis}${cls}
                style="padding:4px 8px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--bg-th);color:var(--text-muted);cursor:${disabled ? 'not-allowed' : 'pointer'};font-size:12px;display:flex;align-items:center;line-height:1;opacity:${disabled ? '.42' : '1'}">
                <i class="bi ${icon}"></i>
            </button>`;
        }

        _iconBtnColor(id, icon, title, bg, color, border, disabled) {
            const dis = disabled ? ' disabled' : '';
            return `<button id="${id}" type="button" title="${this.escape(title)}"${dis}
                style="padding:4px 8px;border:1px solid ${border};border-radius:var(--radius-sm);background:${disabled ? 'var(--bg-th)' : bg};color:${disabled ? 'var(--text-muted)' : color};cursor:${disabled ? 'not-allowed' : 'pointer'};font-size:12px;display:flex;align-items:center;line-height:1;opacity:${disabled ? '.42' : '1'}">
                <i class="bi ${icon}"></i>
            </button>`;
        }

        _buildPrimaryActions(interaction, live, incomingPending, established, terminal) {
            const lead = this.voiceInteractions.get(this.currentInteractionId);
            if (incomingPending) {
                const pending = interaction.answerPending || interaction.rejectPending;
                return [
                    this._iconBtnColor('voiceQaAnswer', 'bi-telephone-fill', 'Answer', '#16a34a', '#fff', '#16a34a', pending),
                    this._iconBtnColor('voiceQaReject', 'bi-telephone-x-fill', 'Reject', '#dc2626', '#fff', '#dc2626', pending),
                ].join('');
            }
            if (terminal) {
                const canCallAgain = Boolean(interaction.normalizedPhone);
                return canCallAgain
                    ? this._iconBtn('voiceQaCallAgain', 'bi-telephone-plus-fill', 'Call Again', '', false)
                    : '';
            }
            // In call / on hold
            const muted  = this.manager?.callManager.snapshot().muted;
            const onHold = this.manager?.callManager.snapshot().onHold;
            return [
                this._iconBtn('voiceQaMute',   muted   ? 'bi-mic-fill'         : 'bi-mic-mute-fill',   muted   ? 'Unmute' : 'Mute',   '', !established || !live),
                this._iconBtn('voiceQaHold',   onHold  ? 'bi-play-circle-fill' : 'bi-pause-circle-fill', onHold ? 'Resume' : 'Hold',   '', !established || !live),
                this._iconBtn('voiceQaTransfer','bi-arrow-left-right', 'Transfer Call (not available in Phase 1)', '', true),
                this._iconBtnColor('voiceQaHangup','bi-telephone-x-fill','Hang Up','#dc2626','#fff','#dc2626', !live),
            ].join('');
        }
    }

    namespace.AgentConsoleVoiceAdapter = AgentConsoleVoiceAdapter;
})(window, document);

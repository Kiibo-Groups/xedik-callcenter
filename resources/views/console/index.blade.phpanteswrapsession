            ${badgeHtml}
        </div>`;

    if (script.type === 'url') {
        const url = _buildScriptUrl(script);
        if (script.url_target === 'panel') {
            return `
                <div style="flex:1;display:flex;flex-direction:column;min-height:0;overflow:hidden;">
                    <div style="flex:1;display:flex;flex-direction:column;min-height:0;overflow:hidden;">

function toggleMessage(msgId) {
    const body = document.getElementById(msgId);
    const icon = document.getElementById(`icon-${msgId}`);
    const isCollapsed = body.dataset.collapsed === 'true';
    if (isCollapsed) {
        body.style.height = '';

            method: 'POST',
            headers: {
                'Content-Type':  'application/json',
                'X-CSRF-TOKEN':  document.querySelector('meta[name="csrf-token"]').content,
            },
            body: JSON.stringify({
                account_id:    accountId,
                phone:         fullPhone,
                template_name: template,
                lead_id:       leadId || null,
            }),
        });
        const d = await _consoleReadJsonResponse(resp);
        if (d.ok) {

                            style="flex:1;width:100%;border:none;min-height:0;"
                            sandbox="allow-same-origin allow-scripts allow-forms allow-popups"
                            referrerpolicy="no-referrer"
                            title="Script: ${_escHtml(script.name)}"></iframe>

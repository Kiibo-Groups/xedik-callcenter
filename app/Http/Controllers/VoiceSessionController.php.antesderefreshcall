    public function __construct(
        private readonly VoiceSessionService $voiceSessions,
        private readonly AsteriskQueueMemberAvailabilityService $queueMemberAvailability,
        private readonly AgentStatusService $agentStatus,
    ) {}

    public function start(Request $request): JsonResponse
    {
        $requestBootstrapStartedAt = hrtime(true);
        $performance = VoicePerformanceMeasurement::create(
            'start',
            $request->header('X-Voice-Measurement-ID')
        );

        $validated = $request->validate([
            'browser_tab_id' => [
                'required',
                'string',
                'max:120',
            ],
        ]);

        $user = $performance->measure(
            'auth_context_lookup_ms',
            fn () => Auth::user()
        );
        $performance->recordSince(
            'request_bootstrap_ms',
            $requestBootstrapStartedAt
        );

        if (!$user) {
            $response = response()->json([
                'ok' => false,
                'state' => 'unauthenticated',
            ], 401);

            return $this->finalizePerformanceResponse(
                $response,
                $performance,
                null,
                null
            );
        }

        $result = $this->voiceSessions->create(
            $user,
            $validated['browser_tab_id'],
            $request->ip(),
            $request->userAgent(),
            $performance
        );

        $response = $performance->measure(
            'response_build_ms',
            fn (): JsonResponse => match ($result['state']) {
            'created' => response()->json([
                'ok' => true,
                'state' => 'created',
                'session' => [
                    'session_uuid' =>
                    $result['session']->session_uuid,
                    'status' =>
                    $result['session']->status,
                    'expires_at' =>
                    $result['session']->expires_at?->toISOString(),
                ],
                'extension' => [
                    'extension' =>
                    $result['extension']->extension,
                    'display_name' =>
                    $result['extension']->display_name,
                ],
                'sip' => $result['sip'],
            ], 201),

            'conflict' => response()->json([
                'ok' => false,
                'state' => 'conflict',
                'message' =>
                'An active voice session already exists.',
                'session' => [
                    'session_uuid' =>
                    $result['session']->session_uuid,
                    'status' =>
                    $result['session']->status,
                    'last_seen_at' =>
                    $result['session']->last_seen_at?->toISOString(),
                ],
            ], 409),

            'no_extension' => response()->json([
                'ok' => false,
                'state' => 'no_extension',
                'message' =>
                'No active voice extension is assigned to this user.',
            ], 422),

            'extension_not_provisioned' => response()->json([
                'ok' => false,
                'state' => 'extension_not_provisioned',
                'message' =>
                'The assigned voice extension is not provisioned.',
            ], 422),

            'tenant_disabled' => response()->json([
                'ok' => false,
                'state' => 'tenant_disabled',
                'message' =>
                'Voice is disabled for this tenant.',
            ], 403),

            'disabled' => response()->json([
                'ok' => false,
                'state' => 'disabled',
                'message' =>
                'Voice is disabled.',
            ], 403),

            default => response()->json([
                'ok' => false,
                'state' => $result['state'],
                'message' =>
                'Unable to create the voice session.',
            ], 500),
            }
        );

        return $this->finalizePerformanceResponse(
            $response,
            $performance,
            $user,
            $result['session'] ?? null
        );
    }
    public function ownership(Request $request): JsonResponse
    {
        $validated = $request->validate([
            'browser_tab_id' => ['required', 'string', 'max:120'],
        ]);

        $user = Auth::user();

        if (!$user) {
            return response()->json(['ok' => false, 'state' => 'unauthenticated'], 401);
        }

        $result = $this->voiceSessions->ownership($user, $validated['browser_tab_id']);

        // Active session visible to the requester (never exposes credentials)
        $activeSessionData = null;
        if ($result['session'] && $result['ownership'] === 'other_tab') {
            $s = $result['session'];
            $activeSessionData = [
                'session_uuid'           => $s->session_uuid,
                'status'                 => $s->status,
                'call_state'             => $s->effectiveCallState(),
                'call_state_updated_at'  => $s->call_state_updated_at?->toISOString(),
                'last_seen_at'           => $s->last_seen_at?->toISOString(),
            ];
        }

        return response()->json([
            // ── Backward-compatible fields ────────────────────────────────
            'ok'               => true,
            'state'            => $result['state'],
            'takeover_required'=> $result['takeover_required'],
            'session'          => $result['session']
                ? [
                    'session_uuid'         => $result['session']->session_uuid,
                    'status'               => $result['session']->status,
                    'last_seen_at'         => $result['session']->last_seen_at?->toISOString(),
                    'browser_tab_matches'  => $result['state'] === 'same_tab',
                ]
                : null,

            // ── New policy fields (additive) ──────────────────────────────
            'ownership'          => $result['ownership'],
            'policy'             => $result['policy'],
            'reason'             => $result['reason'],
            'agent_status'       => $result['agent_status'],
            'call_state_is_fresh'=> $result['call_state_is_fresh'],
            'active_session'     => $activeSessionData,
        ]);
    }

    public function reconnect(Request $request): JsonResponse
    {
        $requestBootstrapStartedAt = hrtime(true);
        $performance = VoicePerformanceMeasurement::create(
            'reconnect',
            $request->header('X-Voice-Measurement-ID')
        );

        $validated = $request->validate([
            'session_uuid' => [
                'required',
                'uuid',
            ],
            'browser_tab_id' => [
                'required',
                'string',
                'max:120',
            ],
        ]);

        /** @var User|null $user */
        $user = $performance->measure(
            'auth_context_lookup_ms',
            fn () => Auth::user()
        );
        $performance->recordSince(
            'request_bootstrap_ms',
            $requestBootstrapStartedAt
        );

        if (!$user) {
            $response = response()->json([
                'ok' => false,
                'state' => 'unauthenticated',
            ], 401);

            return $this->finalizePerformanceResponse(
                $response,
                $performance,
                null,
                null
            );
        }

        $result = $this->voiceSessions->reconnect(
            $user,
            $validated['session_uuid'],
            $validated['browser_tab_id'],
            $performance
        );

        $response = $performance->measure(
            'response_build_ms',
            fn (): JsonResponse => match ($result['state']) {
            'reconnecting' => response()->json([
                'ok' => true,
                'state' => 'reconnecting',
                'session' => [
                    'session_uuid' =>
                        $result['session']->session_uuid,
                    'status' => $result['session']->status,
                    'expires_at' =>
                        $result['session']->expires_at?->toISOString(),
                ],
                'extension' => [
                    'extension' =>
                        $result['extension']->extension,
                    'display_name' =>
                        $result['extension']->display_name,
                ],
                'sip' => $result['sip'],
            ]),

            'not_found' => response()->json([
                'ok' => false,
                'state' => 'not_found',
                'message' => 'The voice session was not found.',
            ], 404),

            'forbidden' => response()->json([
                'ok' => false,
                'state' => 'forbidden',
                'message' => $result['message'],
            ], 403),

            'disabled', 'tenant_disabled' => response()->json([
                'ok' => false,
                'state' => $result['state'],
                'message' => 'Voice is disabled.',
            ], 403),

            'invalid_state',
            'not_current',
            'race',
            'extension_not_provisioned' => response()->json([
                'ok' => false,
                'state' => $result['state'],
                'message' => $result['message'],
            ], 409),

            default => response()->json([
                'ok' => false,
                'state' => $result['state'],
                'message' => 'Unable to reconnect the voice session.',
            ], 500),
            }
        );

        return $this->finalizePerformanceResponse(
            $response,
            $performance,
            $user,
            $result['session'] ?? null
        );
    }

    public function takeOver(Request $request): JsonResponse
    {
        $validated = $request->validate([
            'browser_tab_id' => ['required', 'string', 'max:120'],
            // Optional: frontend sends confirmed=true after the user explicitly
            // approves the takeover modal (confirm policy).
            // Absent or false = backward-compatible mode (Codex will update frontend).
            'confirmed'      => ['nullable', 'boolean'],
        ]);

        /** @var User|null $user */
        $user = Auth::user();

        if (!$user) {
            return response()->json(['ok' => false, 'state' => 'unauthenticated'], 401);
        }

        $result = $this->voiceSessions->takeOver(
            $user,
            $validated['browser_tab_id'],
            $request->ip(),
            $request->userAgent(),
            (bool) ($validated['confirmed'] ?? false)
        );

        return match ($result['state']) {
            'created' => response()->json([
                'ok'    => true,
                'state' => 'created',
                'policy'=> $result['policy'] ?? 'silent',
                'session' => [
                    'session_uuid' => $result['session']->session_uuid,
                    'status'       => $result['session']->status,
                    'expires_at'   => $result['session']->expires_at?->toISOString(),
                ],
                'extension' => [
                    'extension'    => $result['extension']->extension,
                    'display_name' => $result['extension']->display_name,
                ],
                'sip' => $result['sip'],
            ], 201),

            // Call is active — do not allow takeover
            'blocked' => response()->json([
                'ok'      => false,
                'state'   => 'blocked',
                'policy'  => 'blocked',
                'reason'  => $result['reason'] ?? 'active_call',
                'message' => $result['message'] ?? 'The active voice session is currently handling a call.',
            ], 409),

            // policy=confirm and confirmed was absent/false (strict mode only)
            'confirmation_required' => response()->json([
                'ok'      => false,
                'state'   => 'confirmation_required',
                'policy'  => 'confirm',
                'reason'  => $result['reason'] ?? 'confirm',
                'message' => $result['message'] ?? 'Explicit confirmation is required to replace the active voice session.',
            ], 409),

            'disabled' => response()->json([
                'ok' => false, 'state' => 'disabled',
                'message' => 'Voice is disabled.',
            ], 403),

            'tenant_disabled' => response()->json([
                'ok' => false, 'state' => 'tenant_disabled',
                'message' => 'Voice is disabled for this tenant.',
            ], 403),

            'no_extension' => response()->json([
                'ok' => false, 'state' => 'no_extension',
                'message' => 'No active voice extension is assigned to this user.',
            ], 422),

            'extension_not_provisioned' => response()->json([
                'ok' => false, 'state' => 'extension_not_provisioned',
                'message' => 'The assigned voice extension is not provisioned.',
            ], 422),

            default => response()->json([
                'ok' => false, 'state' => $result['state'],
                'message' => 'Unable to take over the voice session.',
            ], 500),
        };
    }

    /**
     * Declarative call state update reported by the browser.
     * The browser must call this when JsSIP transitions between call states.
     */
    public function callState(Request $request): JsonResponse
    {
        $validated = $request->validate([
            'session_uuid'   => ['required', 'uuid'],
            'browser_tab_id' => ['required', 'string', 'max:120'],
            'call_state'     => ['required', 'string', 'in:' . implode(',', \App\Models\VoiceSession::ALLOWED_CALL_STATES)],
        ]);

        /** @var User|null $user */
        $user = Auth::user();

        if (!$user) {
            return response()->json(['ok' => false, 'state' => 'unauthenticated'], 401);
        }

        $session = \App\Models\VoiceSession::withoutGlobalScopes()
            ->where('session_uuid', $validated['session_uuid'])
            ->where('tenant_id', $user->tenant_id)
            ->where('user_id', $user->id)
            ->first();

        if (!$session) {
            return response()->json(['ok' => false, 'state' => 'not_found',
                'message' => 'Voice session not found.'], 404);
        }

        try {
            $updated = $this->voiceSessions->updateCallState(
                $session,
                $validated['browser_tab_id'],
                $validated['call_state']
            );
        } catch (\RuntimeException $e) {
            $wrongTab = !hash_equals(
                (string) $session->browser_tab_id,
                $validated['browser_tab_id']
            );
            return response()->json([
                'ok'      => false,
                'state'   => $wrongTab ? 'forbidden' : 'inactive_session',
                'message' => $e->getMessage(),
            ], $wrongTab ? 403 : 409);
        }

        return response()->json([
            'ok'                   => true,
            'call_state'           => $updated->call_state,
            'call_state_updated_at'=> $updated->call_state_updated_at?->toISOString(),
        ]);
    }
    public function registered(
        Request $request,
        string $sessionUuid
    ): JsonResponse {
        $performance = VoicePerformanceMeasurement::create(
            'registered',
            $request->header('X-Voice-Measurement-ID')
        );

        $validated = $request->validate([
            'browser_tab_id' => ['required', 'string', 'max:120'],
        ]);

        /** @var User|null $user */
        $user = Auth::user();

        if (!$user) {
            $response = response()->json([
                'ok' => false,
                'state' => 'unauthenticated',
            ], 401);

            return $this->finalizePerformanceResponse(
                $response,
                $performance,
                null,
                null
            );
        }

        $session = $performance->measure(
            'registered_session_lookup_ms',
            fn () => VoiceSession::withoutGlobalScopes()
                ->where('session_uuid', $sessionUuid)
                ->where('tenant_id', $user->tenant_id)
                ->where('user_id', $user->id)
                ->firstOrFail()
        );

        try {
            $registered = $this->voiceSessions->markRegistered(
                $session,
                $validated['browser_tab_id'],
                $performance
            );
        } catch (RuntimeException $exception) {
            $wrongTab = $performance->measure(
                'registered_validation_ms',
                fn (): bool => !hash_equals(
                    (string) $session->browser_tab_id,
                    $validated['browser_tab_id']
                )
            );

            $response = $performance->measure(
                'registered_response_build_ms',
                fn (): JsonResponse => response()->json([
                    'ok' => false,
                    'state' => $wrongTab
                        ? 'forbidden'
                        : 'invalid_session_state',
                    'message' => $exception->getMessage(),
                ], $wrongTab ? 403 : 409)
            );

            return $this->finalizePerformanceResponse(
                $response,
                $performance,
                $user,
                $session
            );
        }

        $response = $performance->measure(
            'registered_response_build_ms',
            fn (): JsonResponse => response()->json([
                'ok' => true,
                'state' => 'registered',
                'session' => [
                    'session_uuid' => $registered->session_uuid,
                    'status' => $registered->status,
                    'registered_at' =>
                        $registered->registered_at?->toISOString(),
                    'expires_at' =>
                        $registered->expires_at?->toISOString(),
                ],
            ])
        );

        return $this->finalizePerformanceResponse(
            $response,
            $performance,
            $user,
            $registered
        );
    }
    public function heartbeat(
        Request $request,
        string $sessionUuid
    ): JsonResponse {
        $validated = $request->validate([
            'browser_tab_id' => ['required', 'string', 'max:120'],
        ]);

        /** @var User|null $user */
        $user = Auth::user();

        if (!$user) {
            return response()->json([
                'ok' => false,
                'state' => 'unauthenticated',
            ], 401);
        }

        $session = VoiceSession::withoutGlobalScopes()
            ->where('session_uuid', $sessionUuid)
            ->where('tenant_id', $user->tenant_id)
            ->where('user_id', $user->id)
            ->firstOrFail();

        try {
            $heartbeat = $this->voiceSessions->heartbeat(
                $session,
                $validated['browser_tab_id']
            );
        } catch (RuntimeException $exception) {
            $wrongTab = !hash_equals(
                (string) $session->browser_tab_id,
                $validated['browser_tab_id']
            );

            return response()->json([
                'ok' => false,
                'state' => $wrongTab
                    ? 'forbidden'
                    : 'inactive_session',
                'message' => $exception->getMessage(),
            ], $wrongTab ? 403 : 409);
        }

        return response()->json([
            'ok' => true,
            'state' => 'active',
            'session' => [
                'session_uuid' => $heartbeat->session_uuid,
                'status' => $heartbeat->status,
                'last_seen_at' =>
                $heartbeat->last_seen_at?->toISOString(),
                'expires_at' =>
                $heartbeat->expires_at?->toISOString(),
            ],
        ]);
    }
    public function revoke(
        Request $request,
        string $sessionUuid
    ): JsonResponse {
        $validated = $request->validate([
            'browser_tab_id' => [
                'required',
                'string',
                'max:120',
            ],
            'reason' => [
                'nullable',
                'string',
                'max:255',
            ],
        ]);

        /** @var User|null $user */
        $user = Auth::user();

        if (!$user) {
            return response()->json([
                'ok' => false,
                'state' => 'unauthenticated',
            ], 401);
        }

        $session = VoiceSession::withoutGlobalScopes()
            ->where('session_uuid', $sessionUuid)
            ->where('tenant_id', $user->tenant_id)
            ->where('user_id', $user->id)
            ->firstOrFail();

        if (!hash_equals(
            (string) $session->browser_tab_id,
            $validated['browser_tab_id']
        )) {
            return response()->json([
                'ok' => false,
                'state' => 'forbidden',
                'message' =>
                'This browser tab does not own the voice session.',
            ], 403);
        }

        if ($session->status === 'revoked') {
            return response()->json([
                'ok' => true,
                'state' => 'revoked',
                'session' => [
                    'session_uuid' => $session->session_uuid,
                    'status' => $session->status,
                    'revoked_at' =>
                    $session->revoked_at?->toISOString(),
                    'reason' => $session->failure_reason,
                ],
            ]);
        }

        $revoked = $this->voiceSessions->revoke(
            $session,
            $validated['reason'] ?? 'client_disconnect'
        );

        return response()->json([
            'ok' => true,
            'state' => 'revoked',
            'session' => [
                'session_uuid' => $revoked->session_uuid,
                'status' => $revoked->status,
                'revoked_at' =>
                $revoked->revoked_at?->toISOString(),
                'reason' => $revoked->failure_reason,
            ],
        ]);
    }

    public function pagehide(Request $request, string $sessionUuid): JsonResponse
    {
        $validated = $request->validate([
            'browser_tab_id' => ['required', 'string', 'max:120'],
        ]);

        /** @var User|null $user */
        $user = Auth::user();

        if (!$user) {
            return response()->json([
                'ok' => false,
                'state' => 'unauthenticated',
            ], 401);
        }

        $result = $this->queueMemberAvailability->pauseForAuthoritativePagehide(
            $user,
            $sessionUuid,
            $validated['browser_tab_id']
        );

        if ((int) ($result['ignored'] ?? 0) === 0) {
            try {
                $this->agentStatus->changeStatus($user, 'offline');
            } catch (Throwable $e) {
                Log::warning('[QueueMemberAvailability] pagehide offline transition failed', [
                    'tenant_id' => $user->tenant_id,
                    'user_id' => $user->id,
                    'error_class' => $e::class,
                    'message' => Str::limit($e->getMessage(), 200, ''),
                ]);
            }
        }

        return response()->json([
            'ok' => true,
            'state' => (int) ($result['ignored'] ?? 0) === 1 ? 'ignored' : 'paused',
            'updated' => (int) ($result['updated'] ?? 0),
        ]);
    }

    private function finalizePerformanceResponse(
        JsonResponse $response,
        VoicePerformanceMeasurement $performance,
        ?User $user,
        ?VoiceSession $session
    ): JsonResponse {
        $controllerMetric = $performance->operation === 'registered'
            ? 'registered_controller_total_ms'
            : 'controller_total_ms';

        $performance->recordTotal($controllerMetric);
        $durations = $performance->durations();
        $controllerTotalMs = $durations[$controllerMetric] ?? null;

        if ($controllerTotalMs !== null) {
            $response->headers->set(
                'X-Voice-Controller-Duration-Ms',
                number_format($controllerTotalMs, 2, '.', '')
            );
        }

        $response->headers->set(
            'X-Voice-Measurement-ID',
            $performance->measurementId
        );

        $serverTiming = $performance->serverTiming();

        if ($serverTiming !== '') {
            $response->headers->set('Server-Timing', $serverTiming);
        }

        $performance->writeLog([
            'request_id' => request()->attributes->get(
                'voice_performance_request_id'
            ),
            'tenant_id' => $user?->tenant_id,
            'user_id' => $user?->id,
            'session_uuid' => $session?->session_uuid,
            'request_received_to_controller_ms' =>
                request()->attributes->get(
                    'voice_performance_controller_entry_ms'
                ),
        ]);

        return $response;
    }

